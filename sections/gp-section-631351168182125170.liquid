    if (!this.ready) { this.wantsUnmute = true; return; }
    this.audio = true;
    this.root.setAttribute('data-audio', '1');
    this.setState('unmuting');
    try { p.seekTo(0, true); p.unMute(); p.setVolume(100); p.playVideo(); killCaptions(p); } catch(e){}
