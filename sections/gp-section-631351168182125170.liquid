<style>
  .oo-vsl{
    --oo-gold:#D4AF37; --oo-gold-light:#F3E5AB; --oo-gold-dark:#997A15;
    --oo-border:#E4BB7A; --oo-glow:#BEA35F; --oo-radius:8px;
    position:relative; width:100%; max-width:100%; margin:0 auto;
    font-family:'Montserrat',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    -webkit-tap-highlight-color:transparent;
  }
  .oo-vsl *,.oo-vsl *::before,.oo-vsl *::after{box-sizing:border-box}
  .oo-vsl__frame{
    position:relative; width:100%; aspect-ratio:16/9; overflow:hidden; background:#000;
    border-radius:var(--oo-radius); border:1px solid var(--oo-border);
    box-shadow:0 0 20px 0 var(--oo-glow); isolation:isolate; transform:translateZ(0);
  }
  @supports not (aspect-ratio:16/9){ .oo-vsl__frame{height:0;padding-bottom:56.25%} }

  /* iframe ritagliato: il video (16:9) occupa esattamente il terzo centrale → area visibile = solo video */
  .oo-vsl__crop{position:absolute;left:0;width:100%;top:-100%;height:300%;pointer-events:none;z-index:1}
  .oo-vsl__crop iframe,.oo-vsl__crop .oo-vsl__yt{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;transition:filter .5s ease,transform .5s ease}
  /* teaser muto sfocato (come quiz-vsl) */
  .oo-vsl[data-muted-blur="1"][data-state="muted"] .oo-vsl__crop iframe{filter:blur(14px) brightness(.7);transform:scale(1.08)}
  /* fallback iframe diretto: YouTube gestisce i tap nativamente */
  .oo-vsl[data-state="fallback"] .oo-vsl__crop{pointer-events:auto}
  .oo-vsl[data-state="fallback"] .oo-vsl__shield{display:none}

  .oo-vsl__shield{position:absolute;inset:0;z-index:2;width:100%;height:100%;margin:0;padding:0;border:0;background:transparent;cursor:pointer;appearance:none;-webkit-appearance:none;outline:none}
  .oo-vsl__shield:focus-visible{box-shadow:inset 0 0 0 3px var(--oo-gold)}

  /* Copertina: visibile finché il video non è partito e negli stati pausa/fine/errore */
  .oo-vsl__poster{position:absolute;inset:0;z-index:3;background:#000 center/cover no-repeat;pointer-events:none;filter:brightness(.9);opacity:1}
  .oo-vsl[data-started="1"] .oo-vsl__poster,
  .oo-vsl[data-state="playing"] .oo-vsl__poster,
  .oo-vsl[data-state="fallback"] .oo-vsl__poster{opacity:0;transition:opacity .4s ease}
  .oo-vsl[data-state="paused"] .oo-vsl__poster,
  .oo-vsl[data-state="ended"] .oo-vsl__poster,
  .oo-vsl[data-state="error"] .oo-vsl__poster{opacity:1;transition:none;filter:blur(10px) brightness(.45);transform:scale(1.1)}

  /* Overlay */
  .oo-vsl__overlay{position:absolute;inset:0;z-index:4;display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:16px;cursor:pointer;opacity:1;transition:opacity .4s ease;outline:none}
  .oo-vsl__overlay:focus-visible{box-shadow:inset 0 0 0 3px var(--oo-gold)}
  .oo-vsl__overlay--muted{background:radial-gradient(circle,rgba(28,28,28,.15) 0%,rgba(28,28,28,.5) 100%)}
  .oo-vsl__overlay--paused{background:rgba(28,28,28,.75)}
  .oo-vsl__overlay--ended,.oo-vsl__overlay--error{background:rgba(28,28,28,.72);cursor:default}
  .oo-vsl .oo-vsl__overlay--error p{margin:0!important;color:#fff!important;-webkit-text-fill-color:#fff!important;font-size:15px!important;line-height:1.5!important}
  .oo-vsl__center{position:relative;display:flex;flex-direction:column;align-items:center;gap:16px;pointer-events:none}

  .oo-vsl[data-state="muted"] .oo-vsl__overlay--muted{display:flex}
  .oo-vsl[data-state="unmuting"] .oo-vsl__overlay--muted{display:flex;opacity:0;pointer-events:none}
  .oo-vsl[data-state="paused"] .oo-vsl__overlay--paused{display:flex}
  .oo-vsl[data-state="ended"] .oo-vsl__overlay--ended{display:flex}
  .oo-vsl[data-state="error"] .oo-vsl__overlay--error{display:flex}

  /* Bottone oro pulsante (identico a .unmute-btn della pagina quiz-vsl) */
  .oo-vsl__btn{
    width:88px;height:88px;border-radius:9999px;flex:none;
    background:linear-gradient(135deg,#f3e5ab 0%,#d4af37 50%,#997a15 100%);
    display:flex;align-items:center;justify-content:center;color:#1c1c1c;
    box-shadow:0 0 0 0 rgba(212,175,55,.6);animation:oo-pulse-gold 1.8s infinite;
  }
  .oo-vsl__btn svg{width:40px;height:40px;display:block}
  .oo-vsl__overlay--paused .oo-vsl__btn svg,.oo-vsl__ico-play{margin-left:4px}
  .oo-vsl__ico-play{display:none!important}
  .oo-vsl[data-blocked="1"] .oo-vsl__ico-play{display:block!important}
  .oo-vsl[data-blocked="1"] .oo-vsl__ico-sound{display:none!important}
  @keyframes oo-pulse-gold{0%{box-shadow:0 0 0 0 rgba(212,175,55,.6)}70%{box-shadow:0 0 0 26px rgba(212,175,55,0)}100%{box-shadow:0 0 0 0 rgba(212,175,55,0)}}
  /* !important: dentro le sezioni GemPages ci sono regole del tema su p/a/svg che altrimenti vincono (es. testo nero) */
  .oo-vsl .oo-vsl__hint{margin:0!important;padding:0 24px!important;color:#fff!important;-webkit-text-fill-color:#fff!important;background:none!important;
    font-family:'Montserrat',system-ui,-apple-system,Segoe UI,Roboto,sans-serif!important;font-weight:800!important;font-style:normal!important;
    text-transform:uppercase!important;letter-spacing:.15em!important;font-size:13px!important;line-height:1.4!important;text-align:center!important;opacity:1!important;
    text-shadow:0 0 2px rgba(0,0,0,.95),0 0 6px rgba(0,0,0,.9),0 0 14px rgba(0,0,0,.85),0 2px 4px rgba(0,0,0,.9),0 4px 18px rgba(0,0,0,.8)!important}
  .oo-vsl .oo-vsl__btn{color:#1c1c1c!important}
  .oo-vsl .oo-vsl__btn svg{fill:none!important;stroke:currentColor!important;color:#1c1c1c!important}
  /* zona centrale leggermente più scura dietro bottone e scritta (leggibilità sui frame chiari) */
  .oo-vsl__overlay--muted::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 46% 60% at 50% 50%,rgba(0,0,0,.45) 0%,rgba(0,0,0,0) 100%);pointer-events:none}
  @media (min-width:768px){
    .oo-vsl__btn{width:110px;height:110px}
    .oo-vsl__btn svg{width:56px;height:56px}
    .oo-vsl .oo-vsl__hint{font-size:15px!important}
  }

  /* Fine video */
  .oo-vsl .oo-vsl__replay{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:999px;border:1px solid rgba(243,229,171,.6);background:rgba(0,0,0,.35);color:var(--oo-gold-light)!important;-webkit-text-fill-color:var(--oo-gold-light)!important;font:600 12px/1 'Montserrat',sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:background .2s}
  .oo-vsl__replay:hover{background:rgba(212,175,55,.18)}
  .oo-vsl__replay svg{width:16px;height:16px;fill:currentColor}
  .oo-vsl__cta{display:inline-flex;align-items:center;justify-content:center;padding:14px 26px;border-radius:999px;text-decoration:none;
    background:linear-gradient(135deg,#f3e5ab 0%,#d4af37 50%,#997a15 100%);color:#1c1c1c!important;-webkit-text-fill-color:#1c1c1c!important;text-decoration:none!important;
    font:800 13px/1.2 'Montserrat',sans-serif;letter-spacing:.06em;text-transform:uppercase;box-shadow:0 4px 0 #7a6111,0 10px 20px rgba(212,175,55,.4);transition:transform .15s,box-shadow .15s;max-width:92%}
  .oo-vsl__cta:hover{transform:translateY(2px);box-shadow:0 2px 0 #7a6111,0 8px 15px rgba(212,175,55,.5)}
  .oo-vsl__cta:empty{display:none}

  /* Barra avanzamento */
  .oo-vsl__progress{position:absolute;left:0;right:0;bottom:0;height:3px;background:rgba(255,255,255,.15);z-index:5;display:none;pointer-events:none}
  .oo-vsl[data-progress="1"] .oo-vsl__progress{display:block}
  .oo-vsl__progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--oo-gold-dark),var(--oo-gold-light));transition:width .25s linear}

  @media (max-width:640px){
    .oo-vsl__cta{padding:12px 18px;font-size:11px}
    .oo-vsl__replay{padding:9px 14px;font-size:11px}
  }
  @media (prefers-reduced-motion:reduce){
    .oo-vsl *,.oo-vsl *::before{animation-duration:0s!important;transition-duration:0s!important}
  }
</style>

<script>
(function(){
  'use strict';
  if (window.__ooVslBooted) { window.__ooVslInitAll && window.__ooVslInitAll(); return; }
  window.__ooVslBooted = true;

  var CONFIG = {
    labels: {
      muted:   'Tocca per attivare l’audio',    // teaser muto in riproduzione
      blocked: 'Clicca per guardare il video'   // autoplay bloccato dal browser: video fermo sulla copertina
    },
    autoplayCheckMs: 2500,  // dopo il ready: se il teaser muto non è partito → testo "blocked"
    unmuteCheckMs: 900,     // dopo il tocco: verifica che l'audio sia davvero attivo (max 2 tentativi via API, poi fallback)
    host: 'https://www.youtube-nocookie.com',
    dataLayer: true
  };

  var instances = [];
  var apiPromise = null;

  function dl(obj){ if (!CONFIG.dataLayer) return; try { window.dataLayer = window.dataLayer || []; window.dataLayer.push(obj); } catch(e){} }

  function loadApi(){
    if (window.YT && window.YT.Player) return Promise.resolve();
    if (apiPromise) return apiPromise;
    apiPromise = new Promise(function(resolve){
      var prev = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = function(){
