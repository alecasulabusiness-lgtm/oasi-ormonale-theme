    WEBHOOK_URL: 'https://services.leadconnectorhq.com/hooks/fNHShT4mk8mc6arRPhOz/webhook-trigger/9a5b82ac-702f-48d9-a36f-e0864c502dfd',
    // Etichetta inviata nel payload (chiave "funnel") per distinguere i lead di questa pagina nel workflow.
