    this.progressTimer = null;
    this.milestones = {};

    var poster = root.querySelector('.oo-vsl__poster');
    resolvePoster(this.videoId, root.getAttribute('data-poster'), function(url){ poster.style.backgroundImage = 'url("' + url + '")'; });

    var cta = root.querySelector('[data-oo-end-cta]');
    var ctaText = root.getAttribute('data-end-cta') || '';
    cta.textContent = ctaText;
    cta.setAttribute('href', root.getAttribute('data-end-cta-href') || '#g_QFTyongb');
    if (!ctaText) cta.style.display = 'none';

    this.hint = root.querySelector('[data-oo-hint]');
    if (this.autoplay) this.setHint(CONFIG.labels.muted); else this.setBlocked();
    this.setState('muted');

    onActivate(root.querySelector('.oo-vsl__overlay--muted'), function(){ self.unmute(); });
    onActivate(root.querySelector('.oo-vsl__overlay--paused'), function(){ self.resume(); });
