    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>4-Phase Cycle - Glassmorphism</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;500&display=swap" rel="stylesheet"/>
</head>
<body>

<style>
:root{
  --orange:#ff5722;
  --txt:#eaeaea;
  --bg-glass:rgba(255,255,255,.1);
  --glass-border:rgba(255,255,255,.15);
  --shadow:0 6px 18px rgba(0,0,0,.35);
  --blur:14px;
  --size-desk:270px;      /* diametro desktop */
}

.cycle-wrapper{
  position:relative;
  width:600px;
  height:550px;
  margin:0 auto;
  font-family:'Montserrat',sans-serif;
  font-size: 22px; /* Fixed: was 25x */
  color:var(--txt);
}

/* -------- CARD BASE -------- */
.cycle-card{
  position:absolute;
  width:var(--size-desk);
  height:var(--size-desk);
  border-radius:50%;
  backdrop-filter:blur(var(--blur));
  background:var(--bg-glass);
  border:1px solid var(--glass-border);
  box-shadow:var(--shadow);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:33px 28px;
  box-sizing: border-box; /* Added to prevent overflow */
}

.cycle-card .icon{
  font-size:25px;
  margin-bottom:5px;
  margin-top:-30px;
}

.cycle-card h3{
  font-family:'Bebas Neue',sans-serif;
  font-size:30px;
  letter-spacing:1px;
  color:var(--orange);
  margin:0 0 12px;
  text-transform:uppercase;
}

.cycle-card p{
  font-size:15px;
  line-height:1.3;
  margin:0;
}

/* -------- POSIZIONI DESKTOP -------- */
.card-mestruale  {top:0;     left:50%; transform:translate(-50%,0);}
.card-follicolare{top:35%;   left:0;}
.card-ovulazione {top:35%;   right:0;}
.card-luteale    {top:95%;  left:50%; transform:translate(-50%,-50%);} /* Fixed: was 117% causing overflow */

/* -------- MOBILE – cerchi impilati ---------- */
@media(max-width:767px){
  .cycle-wrapper{
    width:100%;
    height:auto;
    padding:20px 0; /* Fixed: was 0px */
  }
  
  .cycle-card{
    position:static;
    width:72vw;           /* sempre cerchio: diametro = 72% viewport */
    max-width:320px;      /* non superare */
    height:72vw;
    max-height:320px;
    border-radius:50%;    /* cerchio! */
    margin:20px auto; /* Fixed: was -10px causing overlap */
    padding:28px 22px;
    transform:none!important;
  }
  
  /* tipografia leggermente ridotta */
  .cycle-card .icon{font-size:32px;}
  .cycle-card h3{font-size:26px;margin-bottom:8px;}
  .cycle-card p{font-size:15px;}
}
</style>

<div class="cycle-wrapper">
  <div class="cycle-card card-mestruale">
    <span class="icon">💆‍♀️</span>
    <h3>Fase mestruale</h3>
    <p>Riduci crampi, gonfiore<br>e stanchezza.</p>
  </div>
  <div class="cycle-card card-follicolare">
    <span class="icon">🌱</span>
    <h3>Fase follicolare</h3>
    <p>Sfrutta l'energia in salita per allenarti meglio e aumentare la produttività mentale.</p>
  </div>
  <div class="cycle-card card-ovulazione">
    <span class="icon">💃</span>
    <h3>Fase ovulatoria</h3>
    <p>Gestisci appetito, libido e<br>performance col boost<br>estrogenico.</p>
  </div>
  <div class="cycle-card card-luteale">
    <span class="icon">🍫</span>
    <h3>Fase luteale</h3>
    <p>Controlla gonfiore e fame<br>regolando zuccheri e serotonina.</p>
  </div>
</div>

</body>
