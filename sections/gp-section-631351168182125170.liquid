  }

  function resolvePoster(id, custom, cb){
    if (custom) return cb(custom);
    var max = 'https://i.ytimg.com/vi/' + id + '/maxresdefault.jpg';
    var hq  = 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg';
    var img = new Image();
    img.onload  = function(){ cb(img.naturalWidth > 200 ? max : hq); }; // YouTube risponde con un placeholder 120x90 se maxres non esiste
    img.onerror = function(){ cb(hq); };
