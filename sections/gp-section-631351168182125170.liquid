  Vsl.prototype.createPlayer = function(){
    var self = this, mount = this.root.querySelector('.oo-vsl__yt');
    var vars = {
      controls: 0, rel: 0, modestbranding: 1, playsinline: 1, iv_load_policy: 3,
      disablekb: 1, fs: 0, cc_load_policy: 3, enablejsapi: 1,
      origin: window.location.origin, widget_referrer: window.location.href,
