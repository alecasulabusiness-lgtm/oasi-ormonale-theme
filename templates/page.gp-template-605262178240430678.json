    "gp_section_606112201995977626": {
      "settings": {
        "checksum": "a9c05bc19bca03c6a41cda465e45abcfc118b03930a6ae322e468cea9b828d53_1_1_1_0__1",
        "gg7tj0vjMoS_label": "<p>accedi alla tua oasi ormonale</p>",
        "gg8j4BLb0QH_text": "<span style=\"background-color:#FCE19A;color:#000000;\">Infatti, se fosse vero</span> che <i>“per dimagrire basta solo mangiare meno e muoversi di più”</i> tutte noi vivremmo felici, con la pancia piatta...",
        "ggAS8vkmzGG_label": "<p>SCOPRI il protocollo</p>",
        "ggAeSJ_aknP_text": "<span style=\"color:#F9F9F9;\"><strong>Mangiare poco&nbsp;</strong></span><span style=\"background-color:#FCE19A;color:#F9F9F9;\"><strong> </strong></span><span style=\"background-color:#FCE19A;color:#000000;\"><strong>ti fa ingrassare!&nbsp;</strong></span>",
        "ggBkeE72Chb_text": "E sai qual è la cosa peggiore?",
        "ggKUFVIqmcp_childItem_0": "<p><span style=\"color:#FFFFFF;\">Si alza l’ormone dello <strong>stress </strong>e dell&#039;<strong>accumulo di grasso.</strong></span></p>",
        "ggKUkA3UFtK_text": "<strong>Quel numero sulla bilancia non scende mai…&nbsp;</strong><span style=\"background-color:#FCE19A;\"><strong> </strong></span><span style=\"background-color:#FCE19A;color:#1C1C1C;\"><i><strong>Perché?</strong></i><strong>&nbsp;</strong></span>",
        "ggQ6e2EcpH-_text": "Tutto quello che hai sempre fatto per rimetterti in forma, come <i>\"mangiare meno e muoverti di più”</i>, in realtà <strong>manda ancora più in tilt i tuoi ormoni</strong>.<br><br>E nel giro di pochi anni, rischia di farti stare ancora peggio.<br><br>Ma dai su!<br><br><u>Lo sai da te che un riso in bianco ha meno calorie di una carbonara</u>…",
        "ggSAYHgLmYl_text": "<span style=\"color:#E4BB7A;\"><strong>Il corpo di noi Donne è un sistema ormonale complesso e delicato</strong>.&nbsp;</span><br><br><u>Il cibo che mangi parla direttamente ai tuoi ormoni e loro rispondono con effetti che durano giorni o settimane</u>.<br><br>Per questo alcune Donne restano magre anche se mangiano tanto, mentre tu ti gonfi solo a guardare.<br><br>Immagina il tuo corpo come un orologio svizzero.<br><br>Ogni ingranaggio è importante per farlo funzionare.&nbsp;",
        "ggTb6vWYpur_childItem_0": "<p><span style=\"color:#FFFFFF;\">Ti gonfi, hai <strong>attacchi di fame</strong> e <strong>voglia di zuccheri</strong>, non ti senti <strong>mai sazia</strong> e sei sempre <strong>senza forse</strong>...</span></p>",
        "gg_JRQ7s2Cj_text": "Non è questione di forza di volontà.<br><span style=\"background-color:#FCE19A;color:#000000;\">Non è colpa tua!</span>",
        "ggdyX1hBJD3_text": "<i>100% soddisfatta o rimborsata</i>",
        "gggnJd5cGcL_text": "Perché quando non mangi<strong> ciò che serve ai tuoi ormoni:</strong>",
        "ggvlPjp9yIt_text": "Ascoltami...",
        "ggyBtbFvPo0_childItem_0": "<p><span style=\"color:#FFFFFF;\"><strong>Il metabolismo rallenta. Bruci meno calorie, sei sempre stanca e trattieni grasso</strong> su pancia, fianchi e gambe.</span></p>",
        "ggymXdcNSBi_text": "Invece..."
      },
      "type": "gp-section-606112201995977626"
    },
    "gp_section_606112721250812676": {
      "settings": {
        "checksum": "39799cb426a28897320602713e231ee7d497cebde051900bacda1c851958e1b8_1_1_1_0__1",
        "gg-KNmsZuQo_text": "L'ormone della crescita (HGH) si risveglia: <span style=\"color:#E4BB7A;\"><strong>pelle luminosa, rughe ridotte, aspetto visibilmente più giovane</strong></span>",
        "gg2PymrO3_y_text": "L'ossitocina (l'ormone dell'amore) si riattiva. <span style=\"color:#E4BB7A;\"><strong>Libido</strong></span><strong>, </strong><span style=\"color:#E4BB7A;\"><strong>attrazione </strong></span><strong>e </strong><span style=\"color:#E4BB7A;\"><strong>relazioni </strong></span><strong>migliorano naturalmente</strong>.",
        "gg4L05uQ1D3_text": "BRUCI GRASSO OSTINATO",
        "gg4M1Ue7ypY_text": "<i>100% soddisfatta o rimborsata</i>",
        "ggD9qGfNv2p_text": "PIÙ SENSUALE",
        "ggHdO7XwTqv_text": "Con l'equilibrio perfetto tra estrogeni e progesterone, ritrovi la sicurezza in te stessa. <strong>La tua </strong><span style=\"color:#E4BB7A;\"><strong>sensualità </strong></span><strong>e </strong><span style=\"color:#E4BB7A;\"><strong>magnetismo </strong></span><strong>tornano a brillare</strong>.",
        "ggOCjcYHFqF_text": "<strong>Torna a guardarti col sorriso e sentirti </strong><span style=\"color:#E4BB7A;\"><strong>desiderabile </strong></span><strong>e </strong><span style=\"color:#E4BB7A;\"><strong>sicura di te</strong></span>, in ogni momento. Basta con evitare lo specchio.",
        "gg_kZIplX5z_text": "PIÙ ATTRAENTE",
        "gga9yIpmvrG_text": "Non è un’altra dieta che funziona solo per 1 mese. Con Oasi Ormonale <strong>impari come </strong><span style=\"color:#E4BB7A;\"><strong>proteggere i risultati</strong></span><strong> per sempre</strong>.",
        "ggcydOArkk9_text": "TORNI A SPECCHIARTI",
        "ggeUhc9jDaY_text": "I&nbsp;<span style=\"background-color:#fce19a;\"> </span><span style=\"background-color:#fce19a;color:#1C1C1C;\">Risultati&nbsp;</span><span style=\"color:#1C1C1C;\"> </span>che avrai?",
        "ggg9_fmZGaJ_text": "PIÙ GIOVANE",
        "ggjusdAKS9F_label": "<p>clicca per iniziare il percorso</p>",
        "ggk4tpWCthf_text": "Grasso che non se ne va da pancia, fianchi e cosce? <span style=\"color:#E4BB7A;\"><strong>Lo elimini</strong></span><strong> anche da lì, una volta per tutte</strong> (preparati a indossare quel vestito).",
        "gglsusUnC2F_text": "RISULTATI CHE TI DURANO"
      },
      "type": "gp-section-606112721250812676"
    },
    "gp_section_606113119978127927": {
      "settings": {
        "checksum": "3c27221e4c32d3e2a647ce0169d19f6ab76ebf8fa583009cbf617fc849ee7f7c_1_1_1_0__1",
        "gg7KhomGIbo_childItem_0": "<p><span style=\"color:#FFFFFF;\">Ti hanno lasciata debole, senza energia e spenta</span></p>",
        "ggCuCPJJ8Md_text": "Dott.ssa michela delucca",
        "ggEcVatZDzK_text": "Per questo...",
        "ggEfW2QeaJO_text": "Perché non puoi permetterti, ancora, il \"proviamo come va\".<br><br>Perché a te serve una soluzione sicura e mirata che risolve il problema alla radice.",
        "ggNqgjKBzf9_text": "<span style=\"background-color:#FCE19A;\"><strong>perché dovrei &nbsp;fidarmi di voi?</strong></span>",
        "ggUJCz6bays_text": "<strong>Per ottenere gli stessi risultati che ottengono le Star Italiane, da oggi puoi affidarti al nostro team medico multidisciplinare.</strong>",
        "ggUv9-kCjNH_text": "Dott.ssa Alessia migliore",
        "ggWklJ7QW0I_text": "Ho già provato di tutto...",
        "ggYJ6Dcrz3B_text": "Biologa Nutrizionista, Specializzata in Benessere Ormonale Femminile",
        "ggYWqCtOTVA_text": "Programmi da casa “facili e veloci”, la “dieta copia-incolla”, metodi che promettevano pancia piatta in 21 giorni… forse hai pensato anche alla \"<i>punturina</i>\"<br><br>E perché hai mollato in lacrime?<br><br>Perché hai visto che NON era sostenibile e non funzionavano!<br>&nbsp;",
        "ggZ82JXD4jB_text": "<strong>Sei protetta dalla nostra </strong><span style=\"background-color:#FCE19A;color:#1C1C1C;\"><strong>garanzia “soddisfatta o rimborsata”</strong></span><strong>:&nbsp;</strong><br>se segui il Protocollo e non hai risultati,<br>ti rimborsiamo il 100%, senza domande.",
        "gg_wNwUjxDn_text": "<i>100% soddisfatta o rimborsata</i>",
        "ggdCquIPpZd_text": "Dott.ssa michela delucca",
        "ggdsH9nfOg8_text": "Ecco cosa cambia con Oasi Ormonale: <strong><u>non facciamo tentativi</u>.&nbsp;</strong><br><br>Sappiamo come risolvere i difficili problemi ormonali, causa principale del fallimento delle diete e dello sviluppo di patologie croniche.<br><br><strong>Non è la solita dieta</strong>, ma un percorso che nasce e si evolve sulle tue esigenze, con soluzioni specifiche e mirate, che danno risultati duraturi.<br><br><strong>Senza farmaci o strani metodini: </strong>è<strong> </strong>un impegno serio tra te e noi, non un “proviamo così”...<br><br><strong>Le Dottoresse di Oasi Ormonale sanno sulla loro pelle cosa significa investire soldi, tempo e speranze, e non risolvere il problema</strong>.&nbsp;",
        "ggfTwIwU1_B_text": "Vuoi <strong>perdere peso</strong>,&nbsp;<span style=\"background-color:#FCE19A;\"><strong> </strong></span><span style=\"background-color:#FCE19A;color:#1C1C1C;\"><strong>senza riprenderlo?</strong></span><span style=\"background-color:#FCE19A;\"><strong>&nbsp;</strong></span>",
        "ggjZJZSJQoS_text": "Biologa Nutrizionista, Specializzata in Benessere Ormonale Femminile",
        "ggllW3qCiNN_text": "Preparatrice Atletica, nutrizionista, esperta in Benessere Ormonale",
        "ggn--uO9CMA_text": "Quando inizi il Protocollo Oasi Ormonale,<strong> NON</strong> sei sola con un foglio bianco pieno di grammature.<br><br>Entri in un sistema dove <strong>specialiste vere, con anni di esperienza nel benessere ormonale femminile, lavorano insieme per te.</strong><br><br>Niente confusione, ritardi o professionisti che non si parlano.",
        "ggncYAXdLpz_text": "Dott.ssa&nbsp;<br>Sara Pierucci",
        "ggs1ZBu29Te_childItem_0": "<p><span style=\"color:#FFFFFF;\">Centinaia, se non migliaia di euro persi</span></p>",
        "ggs3ZgBFpgP_text": "Medico specializzato in chirurgia",
        "ggtKojJLjou_label": "<p>clicca e inizia il tuo percorso</p>",
        "ggtZy0VSEaU_childItem_0": "<p><span style=\"color:#FFFFFF;\">Sei di nuovo a capo, più gonfia e nervosa di prima</span></p>",
        "ggvOtLF3kZh_text": "Dott.ssa Rosa Irene",
        "ggvPHYwd8-O_text": "Preparatrice Atletica, nutrizionista, esperta in Benessere Ormonale",
        "ggyhA5oUqoN_text": "E lo possiamo fare perché il nostro Protocollo funziona davvero.<br><br>Accanto a te <strong>NON</strong> avrai un'app o una lista di ricette copia-incolla."
      },
