  };
  Vsl.prototype.pause = function(){
    if (this.state !== 'playing') return;
    try { this.player.pauseVideo(); } catch(e){}
    this.setState('paused');
  };
  Vsl.prototype.resume = function(){
    if (this.state !== 'paused') return;
    try { this.player.playVideo(); } catch(e){}
    this.setState('playing');
  };
  Vsl.prototype.replay = function(){
    try { this.player.seekTo(0, true); this.player.playVideo(); } catch(e){}
    this.milestones = {};
    this.setState('playing');
  };

  Vsl.prototype.startProgress = function(){
    var self = this, bar = this.root.querySelector('.oo-vsl__progress i');
    var showBar = this.root.getAttribute('data-progress') === '1' && bar;
    this.stopProgress();
    this.progressTimer = setInterval(function(){
      try {
        var d = self.player.getDuration(); if (!(d > 0)) return;
        var pct = Math.min(100, self.player.getCurrentTime() / d * 100);
        if (showBar) bar.style.width = pct + '%';
        [25, 50, 75].forEach(function(m){ if (pct >= m && !self.milestones[m]) { self.milestones[m] = true; dl({ event: 'oo_video_progress', oo_video_id: self.videoId, oo_video_percent: m }); } });
      } catch(e){}
    }, 500);
  };
  Vsl.prototype.stopProgress = function(){ if (this.progressTimer) { clearInterval(this.progressTimer); this.progressTimer = null; } };

  function initAll(){
    var nodes = document.querySelectorAll('[data-oo-vsl]:not([data-oo-init])');
    for (var i = 0; i < nodes.length; i++) {
      nodes[i].setAttribute('data-oo-init', '1');
      instances.push(new Vsl(nodes[i]));
    }
  }
  window.__ooVslInitAll = initAll;

  // API minima per altri script (es. il popup può mettere in pausa il video)
  window.OOVSL = {
    pauseAll: function(){ instances.forEach(function(v){ v.pause(); }); },
    instances: instances
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll); else initAll();
  setTimeout(initAll, 1500); // GemPages a volte inserisce le sezioni in lazy-load
})();
