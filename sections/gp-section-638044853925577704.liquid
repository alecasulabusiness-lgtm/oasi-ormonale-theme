    <!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Complimenti! — Oasi Ormonale</title>
<meta name="description" content="Richiesta ricevuta. A breve una Consulente del Benessere ti chiamerà per fissare il tuo appuntamento.">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#4B1C22">
<meta property="og:type" content="website">
<meta property="og:locale" content="it_IT">
<meta property="og:title" content="Complimenti! — Oasi Ormonale">
<meta property="og:description" content="Il primo passo è fatto.">
<!-- TODO og:image — serve un'immagine 1200x630 dal cliente -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geologica:slnt,wght@-12..0,100..900&family=Niramit:ital,wght@0,400;0,700;1,400;1,700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=accessibility,alarm,close,front_hand,keyboard_arrow_down,settings&display=swap" rel="stylesheet">
<style>
/* ============================================================================
   OASI ORMONALE — Thank-you page
   Ricostruita dal Figma 2JSQH5BH4QiEpHXRuKxhMk
   Vedi SPECIFICA.md e ../BRAND-IDENTITY.md
   ========================================================================= */

:root{
  /* palette — set delle landing, derive normalizzate (#4A1B21 -> #4B1C22) */
  --wine:#4B1C22;        /* bordeaux dominante, CTA primaria */
  --wine-deep:#31111D;   /* prugna: pillole FAQ */
  --rose:#EAC9D0;        /* rosa cipria: fondi sezione */
  --rose-cta:#DB9AA8;    /* rosa antico: accenti e CTA hero */
  --rose-hero:#FFBDCB;   /* usato una volta sola, nel sottotitolo hero */
  --rose-faq:#FFD8E4;    /* testo pillole FAQ */
  --cream:#F6EDE4;       /* crema: fondi sezione */
  --taupe:#6B594D;       /* velo bruno dei blocchi 02 e 06 */
  --white:#FFFFFF;

  --maxw:1250px;
  --gut:46px;            /* gutter mobile */
  --r-card:24px;         /* raggio card mobile */
  --r-pill:9999px;

  /* velo bruno dei blocchi 02 e 06: identico bit per bit, fattorizzato */
  --veil:linear-gradient(to right,var(--taupe) 22.96%,rgba(107,89,77,0) 57.84%);
}

*,*::before,*::after{box-sizing:border-box}
/* il fondo dell'elemento radice e' quello del footer: cosi' l'overscroll
   in fondo alla pagina non mostra una striscia crema */
html{-webkit-text-size-adjust:100%;background:var(--wine-deep)}
body{
  margin:0;background:var(--cream);color:var(--wine);
  font-family:'Niramit',system-ui,-apple-system,'Segoe UI',sans-serif;
  font-size:19.2px;line-height:25px;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  overflow-x:hidden;
}
img{max-width:100%;display:block}
figure{margin:0}
p{margin:0}
h1,h2,h3{margin:0;font-family:'Geologica',system-ui,sans-serif;font-weight:900;line-height:1}
a{color:inherit}

/* Geologica su Google Fonts ha l'asse slnt, non un taglio italic:
   `oblique 12deg` lo pilota; font-synthesis copre il fallback. */
.it{font-style:oblique 12deg;font-synthesis:style}

/* ---- impalcatura -------------------------------------------------------- */
.sec{position:relative;overflow:hidden}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 var(--gut)}
.only-d{display:none!important}
/* riga che nel Figma non va a capo: sborda a destra come li' (cfr. le pillole FAQ).
   Vale SOLO nella fascia mobile: sotto i 375 rientrerebbe fuori schermo, e da 900
   in su la colonna di .mod__txt scende a 382,5px e il titolo finirebbe sotto la foto. */
@media (min-width:375px) and (max-width:899px){.nw{white-space:nowrap}}
/* Le immagini della colonna desktop (.blk__side) non esistono sotto i 900px:
   li' vale .blk__img, l'inset arrotondata, per TUTTI i blocchi. (Fino al 15
   settembre c'era anche .blk__bleed, la banda a filo pagina in coda a due
   blocchi per landing: tolta, adesso lo schema e' uno solo.) */
.blk__side{display:none}

/* ---- eyebrow calligrafici ------------------------------------------------
   Brush Script MT non è licenziabile per il web: sono i tracciati veri
   esportati da Figma in SVG. Il colore arriva da `color` via currentColor. */
.eyebrow{display:block;color:var(--rose-cta)}
/* Il viewBox degli SVG e' quello dell'export DESKTOP: viewBox/2 coincide con
   la larghezza di render del nodo Figma desktop entro 0,5px su tutti i
   tracciati. A mobile il Figma disegna gli stessi testi a 38,4px contro i 48
   del desktop, cioe' 0,8 volte: il fattore e' 0,5 x 0,8 = 0,4, non 1/3,3333.
   Verificato sul rapporto fra le due misure di render del Figma: 0,800 esatto
   (0,79995..0,80014) su 13 tracciati su 15, e confermato dalle altezze. */
.eyebrow svg{width:calc(var(--vw, 117) * .4px);height:auto;display:block}
.eyebrow--light{color:var(--white)}
.eyebrow--center{margin-inline:auto}
.eyebrow--center svg{margin-inline:auto}
.num{display:block;color:var(--rose-cta)}
.num svg{width:calc(var(--vw, 117) * .4px);height:auto;display:block}
.num--light{color:var(--white)}
@media (max-width:899px){
  /* I due tracciati che a 0,4 escono dalla colonna sono gli unici due il cui
     CONTENUTO a mobile e' diverso da quello dell'export desktop:
     "Ho gia' provato di tutto..." (viewBox 804 -> 321,6) nel Figma mobile NON
     ha i tre puntini ed e' largo 290,6; "E sai qual e' la cosa peggiore?"
     (946 -> 378,4, oltre il viewport da 375) nel Figma mobile va a capo su DUE
     righe. Un tracciato a riga sola non li puo' rendere: finche' non arrivano
     gli export mobile si fermano alla colonna invece di farsi tagliare da
     .sec{overflow:hidden}. Non tocca desktop (p2 li ridefinisce sopra i 900). */
  .eyebrow svg,.num svg{max-width:100%}
}
/* ripiego se il tracciato SVG di un eyebrow non e' ancora stato esportato */
.eyebrow-fb{font-family:'Segoe Script','Brush Script MT',cursive;font-style:italic;
  font-size:35px;line-height:1.1;display:block}

/* ---- CTA ---------------------------------------------------------------- */
.cta{
  display:inline-flex;align-items:center;justify-content:center;text-align:center;
  min-height:49px;padding:14px 26px;border:0;border-radius:var(--r-pill);
  background:var(--wine);color:var(--white);
  /* 16 e non 17: con l'etichetta unica "Entra nel Percorso Oasi Ormonale"
     a 17px l'inchiostro chiede 285,67 px contro i 283 della colonna, e a
     375 - una delle due misure del Figma - andavano a capo 10 CTA su 14 su
     Celebrities e 4 su 10 su Sensuality. A 16px l'inchiostro scende a
     238,61 e la geometria resta IDENTICA a oggi: pillole 275 e 325, alte 49.
     ⚠ Vale solo sotto i 900: p2.html ridichiara font-size:16px li' sopra.
     ⚠ La stessa riga font-family/font-weight/font-size compare anche su
     .oo-form__submit (il bottone del popup) e NON va toccata: per questo la
     sostituzione comprende anche la riga del letter-spacing. */
  font-family:'Roboto',system-ui,sans-serif;font-weight:500;
  font-size:clamp(15px, calc((100vw - 112px) / 15), 18px);line-height:21.6px;
  letter-spacing:-.08px;text-decoration:none;cursor:pointer;
  transition:transform .18s ease,background-color .18s ease,box-shadow .18s ease;
}
.cta:hover{transform:translateY(-2px)}
/* feedback al click richiesto dalla designer (nota "3. Button Active") */
.cta.is-active,.cta:active{transform:translateY(0) scale(.97);background:#3C1319}
/* l'ombra: la transizione su box-shadow era gia' dichiarata in .cta e non
   animava niente. */
.cta{box-shadow:0 8px 20px rgba(49,17,29,.28)}
/* ETICHETTA BIANCA (Matteo, 18 settembre: «le cta con testo bianco non nero»).
   ⚠ E' un DIETROFRONT sul 15 settembre, e va scritto perche' non venga
   «corretto» di nuovo fra un mese. Il 15 l'etichetta era passata a bordeaux
   per una ragione misurata: bianco su --rose-cta #DB9AA8 fa 2,28:1, sotto la
   soglia WCAG anche per il testo grande, mentre il bordeaux sullo stesso rosa
   fa 6,18:1. I due numeri restano veri. Ha deciso il cliente, e il bianco e'
   anche il colore che questa pillola ha nel Figma: il dietrofront e' un
   ritorno al disegno, non un'invenzione.
   ⚠ Tocca CINQUE pillole, contate nel markup: su Celebrities la hero, il
   blocco 04 GARANZIA e il blocco 06 FITNESS; su Sensuality la hero e il
   blocco 05 GARANZIA. Le altre diciotto CTA del funnel erano gia' bianche su
   bordeaux e non cambiano: 14,11:1.
   ⚠ L'unica leva rimasta per recuperare leggibilita' senza toccare ne' il
   bianco ne' il rosa sarebbe un'ombra sul TESTO: staccherebbe le lettere a
   occhio ma NON alzerebbe il contrasto WCAG, che non ha un termine per
   l'alone. Non e' messa: non e' stata chiesta.
   ⚠ NIENTE ANELLO. Il piano del 15 ne prevedeva uno bordeaux da 2px: misurato
   sui pixel resi fa 1,13-1,32:1 contro cio' che gli sta attorno, cioe' non si
   vede. L'ombra del BOTTONE invece funziona, ed e' quella che il cliente
   aveva chiesto: resta. */
.cta--rose{background:var(--rose-cta);color:var(--white);
  box-shadow:0 10px 24px rgba(49,17,29,.45)}
.cta.is-active,.cta:active{box-shadow:0 3px 8px rgba(49,17,29,.30)}
.cta--rose.is-active,.cta--rose:active{background:#C98392;
  box-shadow:0 0 0 2px rgba(75,28,34,.85), 0 3px 9px rgba(49,17,29,.40)}
.cta{padding-inline:16px;min-width:275px}
/* Pillola larga: blocco 05 di Sensuality e blocco 06 di Celebrities. Nel Figma
   partono da x 25,2 e sono larghe 324,9 (mobile) / 313,0 (desktop), contro i
   50,1 x 274,8 e i 120,5 x 264,5 delle altre. La posizione non serve dichiararla:
   il wrap e' centrato sotto i 900 e allineato a sinistra sopra. */
.cta-wrap--wide .cta,.testi .cta{min-width:325px}
.cta-wrap{display:flex;flex-direction:column;align-items:flex-start;gap:6px}
.cta-wrap--center{align-items:center;text-align:center}
.cta-note{font-size:14.4px;line-height:18.7px}

/* ---- animazioni --------------------------------------------------------- */
/* "1. Hover scale (o zoom) effect" — richiesta della designer */
.zoom{overflow:hidden}
.zoom img{transition:transform .5s cubic-bezier(.22,.61,.36,1);will-change:transform}
@media (hover:hover){ .zoom:hover img{transform:scale(1.045)} }

/* rivelazione allo scroll */
/* Senza JS la classe .js non viene messa e i reveal restano visibili:
   la pagina dev'essere leggibile anche a script disattivato. */
.js .rv{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s cubic-bezier(.22,.61,.36,1)}
.js .rv.in{opacity:1;transform:none}

/* "2. Animazione testo/immagine basata sullo scroll": testo e immagine
   scorrono a velocità diverse. Solo transform, mai top/margin. */
.par{will-change:transform}

/* Le card dei risultati scendono dall'alto fino al loro posto mentre la
   pagina scorre. La corsa la scrive il JS in --drop; .rv qui resta per la
   sola dissolvenza. Se il JS non parte, --drop non esiste e le card sono
   gia' al posto giusto: lo stato di riposo nel CSS e' quello finale.
   Due translateY composti, non una calc: --drop e' negativa e
   calc(22px + -29.2px) e' sintassi non valida, e il browser scarterebbe
   tutta la riga senza dire niente. */
.js .results .card.rv{transform:translateY(22px) translateY(var(--drop,0px))}
.js .results .card.rv.in{transform:translateY(var(--drop,0px))}
@media (prefers-reduced-motion:reduce){
  .js .results .card.rv,.js .results .card.rv.in{transform:none}
}

@media (prefers-reduced-motion:reduce){
  .js .rv{opacity:1;transform:none;transition:none}
  .zoom img{transition:none}
  .zoom:hover img{transform:none}
  .par{transform:none!important}
  .cta{transition:none}
  /* ferma la barra delle testate: resta scorrevole a dito */
  .press__track{animation:none}
  .press__in{overflow-x:auto}
}

/* ---- tipografia --------------------------------------------------------- */
.h-sec{font-size:28.8px;line-height:36px;color:var(--wine)}
/* sotto i 900px il Figma usa 38,4/48 per i blocchi numerati, la FAQ e
   l'interstiziale grande; i 28,8 restano ai moduli 3/4/5/7 */
.blk .h-sec,.faq__head h2,.inter--big .h-sec{font-size:38.4px;line-height:48px}
/* "L’ENDOCRINOLOGO" e' UNA PAROLA SOLA: non ha nessun punto di a-capo, e a
   38,4px l'inchiostro misura 388,4 px contro una colonna di 283 a 375 - la
   parola verrebbe TAGLIATA da .sec{overflow:hidden}, in silenzio. L'unica
   leva e' il corpo, e qui si calcola sulla colonna invece di fissarlo:
   l'inchiostro vale 10,1146 x il corpo (misurato a 17 corpi su due landing:
   non dipende dal viewport) e la colonna sotto i 900 e' 100vw - 92, cioe'
   46 px di gutter per lato. Il divisore e' 10,2 e non 10,1146 per lasciare
   un margine. Il min() riporta il titolo al corpo normale appena c'e' posto:
   da 488 px in su torna a 38,4 come tutti gli altri.
   L'interlinea NON si tocca: resta 48, cosi' il titolo a una riga sola
   conserva un po' dell'aria che aveva quando le righe erano due.
   ⚠ Il selettore ha DUE classi perche' `.blk .h-sec` qui sopra e' 0-2-0 e
   vincerebbe su una classe nuda. */
.blk .h-sec--endo{font-size:min(38.4px,calc((100vw - 76px) / 10.2))}
.h-sec .it{color:var(--rose-cta)}
.h-big{font-size:38.4px;line-height:48px;color:var(--wine)}
.body{font-size:19.2px;line-height:25px}
.body + .body{margin-top:1em}
.body b,.body strong{font-weight:700}
.body i,.body em{font-style:italic}

/* ============================================================================
   SEZIONI
   ========================================================================= */

/* --- 1. Hero VSL --------------------------------------------------------- */
.hero{background:var(--wine);text-align:center;color:var(--white);min-height:750px;display:flex;align-items:center}
.hero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.hero__in{position:relative;z-index:1;width:100%;padding:65px var(--gut) 52px}
/* 10,8/14,04 e' la misura del Figma mobile (SEN 352:1155, CEL 350:1081):
   l'occhiello e' un sopratitolo, non una riga di testo, e a 19,2 px occupava
   cinque righe su 283 di colonna. A desktop p2.html lo riporta a 20. */
/* 12/15,6 e non 10,8/14,04 (Matteo, 15 settembre: «leggermente piu' grande
   su mobile»). ⚠ Dal 15 settembre questa regola vale per la SOLA Celebrities:
   Sensuality l'occhiello non ce l'ha piu'. E 12/15,6 e' anche il corpo che il
   Figma desktop di Celebrities da' a questo nodo. */
.hero__pre{font-size:13.2px;line-height:17.16px;color:var(--white);margin:0 auto 20px}
/* 21,5/26,8 e non 38,4/42,7 (Matteo, 15 settembre: «fallo piu' piccolo come
   per hero sensualita'»). E' esattamente il corpo che la hero di Sensuality
   ha adesso: le due landing a mobile hanno ora la stessa scala di titolo.
   ⚠ Sensuality lo ridichiara comunque in sen-extra.css con lo stesso valore:
   la ripetizione e' voluta, cosi' se un giorno una delle due cambia, l'altra
   non la segue per sbaglio.
   ⚠ Le thank-you page concatenano p1+p2 ma non hanno nessun elemento .hero
   nel corpo: per loro questa riga e' inerte (verificato). */
/* 26,5/33,1 e non 21,5/26,8 (Matteo, «vai a tutto»: il titolo rientra fra
   i testi da ingrandire). 26,5 e' il PIU' GRANDE corpo che regge a TUTTE E
   DUE le misure di controllo, misurato con la colonna nuova da 343:
     a 375  3 righe, fascia 750,0 - identica al disegno
     a 320  5 righe, fascia 756,6
   A 28 il 320 passa a 6 righe e la fascia a 793,4. 33,1 = 26,5 x 1,25, la
   metrica vera di Geologica.
   ⚠ Vale SOLO per Celebrities anche se la regola e' condivisa: Sensuality
   ridichiara il suo titolo mobile in sen-extra.css, e li' 21,5 e' un tetto
   vero - a 22,5 passa da 6 a 7 righe. Le due hero avevano lo stesso corpo
   dal 15 settembre: da adesso non piu', ed e' una conseguenza misurata,
   non una svista. */
.hero h1{font-size:26.5px;line-height:33.1px;color:var(--white)}
.hero h1 .l1{color:var(--rose-cta)}
.on-w{color:var(--white)}
/* Le righe piccole del titolo ereditavano l'interlinea di quelle grandi
   (42,7 px su un corpo di 19,2): il blocco si sfaldava e una riga restava
   sospesa da sola. Nel Figma l'interlinea e' AUTO, cioe' proporzionale a
   ogni tratto: con 25,6 l'altezza del titolo torna quella del nodo
   (2x42,7 + 3x25,6 = 162,2 contro i 162,3 di cel-m). A desktop l'interlinea
   e' gia' dichiarata in p2.html e non cambia nulla. */
/* 15,0/16,67 dal Figma mobile (SEN 352:1143, CEL 352:1083): la riga 2 e'
   Geologica Bold 700, la 3 Geologica BlackItalic 900. Erano 19,2/25,6, cioe'
   il corpo del testo, e il titolo non aveva piu' gerarchia: le tre righe
   pesavano quasi uguale. */
.hero h1 .l2{display:block;font-size:16px;line-height:20px;font-weight:700;color:var(--white)}
.hero h1 .l3{display:block;font-size:16px;line-height:20px;font-weight:900;color:var(--rose-cta)}
/* 15,6/20,28 dal Figma mobile (SEN 352:1144, CEL 180:5942). */
.hero__sub{margin:31px auto 0;font-size:18px;line-height:23.4px}
.hero__sub b{font-weight:700}
/* ---- evidenziazioni dentro i paragrafi ------------------------------------
   Generate da `innesta.py` leggendo i characterStyleOverrides del Figma.
   .hl  = 700 corsivo rosa   .hl2 = 700 tondo rosa   .hl3 = 700 corsivo chiaro
   Il colore di .hl3 dipende dal fondo su cui sta, quindi va ridichiarato
   sezione per sezione qui sotto. */
.hl{font-weight:700;font-style:italic;color:var(--rose-cta)}
.hl2{font-weight:700;color:var(--rose-cta)}
.hl3{font-weight:700;font-style:italic;color:var(--white)}
/* un tratto che nel Figma resta corsivo bianco ma NON grassetto */
.hl3--n{font-weight:400}
.blk--taupe .hl3,.blk--garanzia .hl3{color:var(--cream)}
/* su fondo rosa il rosa non si legge: li' il Figma usa bordeaux o bianco */
.blk--rose .body .hl{color:var(--wine)}
.mod--rose .body .hl{color:var(--wine)}
.hero__sub .hl{color:var(--rose-hero)}
/* .on-rose: bianco, ovunque ci sia un fondo rosa. Era annidata solo dentro
   .mod--split e quindi non raggiungeva i blocchi ne' la FAQ. */
/* ⚠ BORDEAUX E NON PIU' BIANCO (Matteo, «vai a tutto», 15 settembre).
   Bianco su --rose #EAC9D0 fa 1,53:1 - il contrasto peggiore dell'intera
   pagina, su tutte e due le landing: il testo quasi sparisce. Il bordeaux
   sullo stesso rosa fa 9,86:1. Non e' un'invenzione: la regola gemella
   qui sotto (.blk--rose .body .hl) dice gia' che «su fondo rosa il rosa
   non si legge: li' il Figma usa bordeaux o bianco», e fra i due il
   bianco e' quello che non regge.
   ⚠ SCOSTAMENTO VOLUTO, e si vede: nei due titoli che usano .on-rose la
   parte in corsivo diventa dello stesso colore di quella tonda, cioe' il
   titolo perde il bicolore. Segnalato a Matteo. */
.on-rose,.h-sec .it.on-rose,.body .on-rose{color:var(--wine)}
.on-w{color:var(--white)}
.it--light{color:var(--white)}
.h-sec .it--light{color:var(--white)}
/* .cta-note--b (riga garanzia tutta in grassetto) e' un fatto del SOLO desktop:
   la regola sta ora in p2.html, dentro @media (min-width:900px). Nel Figma il
   nodo SEN 222:2098 e' Niramit Bold 700 in blocco, senza override, mentre il
   gemello mobile SEN 222:2559 ha base 400 e il grassetto sui soli due run
   "100% soddisfatta" e "rimborsata" - come le altre ventitre righe garanzia dei
   quattro frame. Qui, nel foglio base, il 700 valeva anche a 375 e ingrassava
   la " o ". */
/* le varianti di colore della linguetta sono state spostate accanto a .doc__tab,
   piu' sotto: qui stavano PRIMA della regola base, a parita' di specificita',
   e non si applicavano mai */
.hero__note{margin-top:6px;font-size:16px;line-height:20.8px}
/* la hero sta su una FOTO: l'ombra non alza il contrasto WCAG (la formula
   non ha un termine per l'alone) ma stacca l'inchiostro dove il fondo
   cambia da pixel a pixel. Precedente in casa: .vsl__t1. */
.hero h1,.hero__pre,.hero__sub,.hero__note{text-shadow:0 1px 3px rgba(0,0,0,.55)}

/* player: la miniatura è un raster con la UI già dentro (vedi SPECIFICA §1) */
.video{position:relative;display:block;width:100%;max-width:322px;margin:30px auto 0;
  border:0;padding:0;background:none;cursor:pointer;border-radius:var(--r-card);overflow:hidden}
.video img{width:100%;height:auto}
/* Nel Figma mobile la VSL della hero e' lo STESSO riquadro dei due video di
   testimonianza: x 26,7 largo 321,7 (cel-m `Group 674` y 407,7; sen-m 222:2724
   y 299,7). La colonna che la contiene ha pero' 46px di gutter e la strozzava a
   283: deve sbordare di 19px per lato, come la pillola larga delle CTA
   (.cta-wrap--wide, piu' sotto). Il margine negativo vale solo finche' la
   colonna e' piu' stretta di 322; da li' in su il max() restituisce meta' dello
   spazio avanzato e il riquadro torna centrato, come faceva `margin:auto` (che
   da solo non basta: con un blocco che sborda Chrome azzera gli auto). */
@media (max-width:899px){
  .hero .video{width:calc(100% + 2 * (var(--gut) - 16px));max-width:343px;
    margin-inline:max(calc(16px - var(--gut)), calc((100% - 343px) / 2))}

  /* Il titolo condivide la stessa colonna del video (322px), non quella piu'
     stretta di occhiello e sottotitolo (303px): col riferimento del cliente
     "italiane a dire addio a quel maledetto" sta su una riga sola, e nella
     colonna a 283-303px del gutter di base non ci sta. Stesso sbordo, stessa
     formula: sotto i ~414px di viewport il titolo esce dal gutter fino a 322,
     sopra torna centrato dentro quella misura invece di allargarsi col resto
     della fascia. */
  .hero h1{width:calc(100% + 2 * (var(--gut) - 16px));max-width:343px;
    margin-inline:max(calc(16px - var(--gut)), calc((100% - 343px) / 2))}
  /* Occhiello e sottotitolo condividono la stessa colonna bleed del titolo e
     del video: sotto i 375px il gutter piatto da 46px la stringerebbe sotto
     i 283px su cui sono tarati gli <br> fissi del riferimento (vedi s3.html),
     spaccando "Ritrova il corpo leggero e tonico che" con un a-capo in piu'
     invece di uno solo. Il bleed la tiene stabile fino a 320px. */
  .hero__pre{width:calc(100% + 2 * (var(--gut) - 16px));max-width:343px;
    margin-inline:max(calc(16px - var(--gut)), calc((100% - 343px) / 2))}
  .hero__sub{width:calc(100% + 2 * (var(--gut) - 16px));max-width:343px;
    margin-inline:max(calc(16px - var(--gut)), calc((100% - 343px) / 2))}
  .hero__note{width:calc(100% + 2 * (var(--gut) - 16px));max-width:343px;
    margin-inline:max(calc(16px - var(--gut)), calc((100% - 343px) / 2))}
  .hero .cta{width:calc(100% + 2 * (var(--gut) - 16px));max-width:343px;
    margin-inline:max(calc(16px - var(--gut)), calc((100% - 343px) / 2))}
  /* la pillola della hero vive su una colonna sua (100vw - 32) e non su
     quella del corpo: l'inchiostro dell'etichetta vale 14,913 px per px di
     corpo, il 15,5 lascia il margine. A 375 fa 18 (tetto), a 320 fa 16,52
     dove la regola generale scende a 14. */
  .hero .cta{font-size:min(18px, calc((100vw - 64px) / 15.5))}

  /* A MOBILE IL SOTTOTITOLO STA SOTTO IL VIDEO. Nei frame mobile del Figma il
     nodo e' a y 553,2 (SEN 352:1144) e 517,5 (CEL 180:5942), col riquadro del
     video in mezzo fra il titolo e lui; a desktop invece sta sopra (279,5 e
     256,0). Il markup tiene l'ordine del desktop e qui si riordina: cosi' la
     frase non e' scritta due volte.
     `align-items` resta `stretch`, come erano da blocchi, altrimenti i
     paragrafi si stringerebbero al contenuto; la pillola, che e' inline-flex,
     va invece centrata a mano, se no si stira a tutta riga. */
  .hero__in{display:flex;flex-direction:column}
  .hero__in > .hero__pre{order:1}
  .hero__in > h1{order:2}
  .hero__in > .video{order:3}
  .hero__in > .hero__sub{order:4}
  .hero__in > .cta{order:5;align-self:stretch}
  .hero__in > .hero__note{order:6}
}
.video__glass{position:absolute;left:50%;top:50%;translate:-50% -50%;
  width:44px;height:44px;display:grid;place-items:center;
  border-radius:8px;border:1px solid rgba(255,255,255,.55);
  background:rgba(255,255,255,.23);backdrop-filter:blur(10.8px);-webkit-backdrop-filter:blur(10.8px)}
.video__glass svg{width:12px;height:13px;fill:#fff}

/* --- 1b. VSL della hero: parte da sola, muta e sfocata -------------------
   Chiesta da Matteo il 15 settembre, sul modello della sua pagina
   /pages/quiz-funnel-vsl-form-3: il video parte al caricamento SENZA AUDIO e
   sfocato, sopra c'e' l'invito ad attivarlo, e al clic riparte da capo con
   l'audio. Tutto e' agganciato a `.video--vsl`, che sta SOLO sul riquadro
   della hero: i sei video di testimonianza restano come prima.
   ⚠ La sfocatura sta su `.video--vsl.is-muto`, una classe che mette il JS:
   se il JS non gira la classe non arriva mai e la pagina resta quella di
   oggi. Nessuno stato "sfocato" puo' restare appeso senza JS.
   ⚠ IMPILAMENTO DICHIARATO, non ereditato: `.zoom img` porta
   `will-change:transform`, che fa della copertina un contesto di impilamento.
   Senza queste righe l'ordine fra copertina e player dipenderebbe
   dall'ordine nel DOM, cioe' da un dettaglio del JS. */
.video--vsl > picture{display:block;position:relative;z-index:2;pointer-events:none;
  transition:opacity .5s ease, filter .45s ease, transform .45s ease}
.video--vsl iframe{z-index:1;transition:filter .45s ease, transform .45s ease}
/* La copertina copre il caricamento di YouTube e si toglie DA SOLA, a tempo.
   A tempo e non su un evento del player: aspettare un evento di YouTube e'
   esattamente l'errore del 12 settembre. */
.video--vsl.is-svelato > picture{opacity:0}
/* `scale(1.06)` non e' decorativo: la sfocatura campiona anche fuori dal
   bordo e senza la scala resterebbe un alone chiaro lungo i quattro lati. */
.video--vsl.is-muto iframe,
.video--vsl.is-muto > picture{filter:blur(12px) brightness(.62);transform:scale(1.06)}

.vsl{position:absolute;inset:0;z-index:20;display:grid;place-items:center;
  cursor:pointer;-webkit-tap-highlight-color:transparent;
  background:radial-gradient(circle at 50% 50%,rgba(49,17,29,.20) 0%,rgba(49,17,29,.66) 100%);
  transition:opacity .35s ease}
.video--vsl.is-audio .vsl{opacity:0;pointer-events:none}
.vsl__in{display:flex;flex-direction:column;align-items:center;gap:11px;
  padding:0 16px;text-align:center;pointer-events:none}
.vsl__ico{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;
  background:var(--rose-cta);box-shadow:0 0 0 0 rgba(219,154,168,.55);
  animation:vsl-pulsa 1.9s ease-out infinite}
.vsl__ico svg{display:block;width:29px;height:29px;fill:var(--wine)}
.vsl__t1{margin:0;font-family:'Geologica',system-ui,sans-serif;font-weight:900;
  font-size:13px;line-height:15px;letter-spacing:.11em;text-transform:uppercase;
  color:var(--white);text-shadow:0 2px 10px rgba(0,0,0,.8)}
@keyframes vsl-pulsa{
  0%{box-shadow:0 0 0 0 rgba(219,154,168,.55)}
  70%{box-shadow:0 0 0 20px rgba(219,154,168,0)}
  100%{box-shadow:0 0 0 0 rgba(219,154,168,0)}}
/* chi ha chiesto meno movimento non si prende una pulsazione infinita in
   cima alla pagina: resta il cerchio pieno, che si vede lo stesso */
@media (prefers-reduced-motion:reduce){
  .vsl__ico{animation:none}
  .vsl,.video--vsl iframe,.video--vsl > picture{transition:none}
}
.hero .cta{margin-top:30px}

/* --- 2. Barra loghi stampa ----------------------------------------------- */
.press{background:var(--white)}
.press__in{overflow:hidden}
/* Su mobile la pista scorre. Le due serie sono identiche, quindi spostarla
   di META' della propria larghezza la riporta esattamente al punto di
   partenza: il giro si chiude senza salto. */
/* 57 s: un ciclo e' una copia, che a mobile misura 1248 px. Sono gli stessi
   21,8 px/s di sempre - la durata segue la larghezza, se no cambia andatura. */
.press__track{display:flex;width:max-content;animation:press-scorre 57s linear infinite}
.press__set{display:flex;align-items:center;gap:38px;padding:45px 19px}
/* Larghezza uguale per tutti e altezza dalle proporzioni: e' il criterio che
   la designer usava gia' sui tre del Figma. Normalizzare sull'ALTEZZA
   farebbe esplodere in larghezza i marchi lunghi e bassi - Corriere Flegreo
   ha proporzione 10,2:1. */
.press__set picture{display:block;flex:0 0 auto}
.press__set img{display:block;width:118px;height:auto}
/* tre copie nella pista: si sposta di UNA, cioe' di un terzo. Le due che
   restano devono coprire la finestra, se no si apre un vuoto a destra.
   La percentuale e' 100/COPIE, e COPIE sta in contenuti.py: si toccano
   insieme. */
@keyframes press-scorre{from{transform:translateX(0)}to{transform:translateX(-33.3333%)}}

/* --- 3 / 5. Modulo testo + foto ------------------------------------------ */
.mod{background:var(--cream);padding:45px 0}
.mod__in{padding-inline:var(--gut)}
.mod h2{margin-top:20px}
.mod__img{margin:45px 0;border-radius:var(--r-card);overflow:hidden}
/* Sotto i 900px l'immagine entra DENTRO la colonna di testo, in posizione
   diversa per ogni modulo (SPECIFICA §3, §4, §5). `display:contents` porta i
   figli di .mod__txt al livello del flex, cosi' `order` puo' interlacciarli. */
@media (max-width:899px){
  .mod__in{display:flex;flex-direction:column}
  .mod__txt{display:contents}
  .mod__txt > .eyebrow{order:1}
  .mod__txt > h2{order:2}
  .mod__txt > .body{order:5}
  .mod__txt > .cta-wrap{order:6}
  /* Nel Figma mobile le tre pillole dei moduli 3/4/5 (cel-m y=1889,7 / 2719,8 /
     4355,1) stanno a x=50,1 w=274,8 come le altre dieci: centrate nella colonna,
     non appoggiate al gutter. Senza questa riga il wrap resta con l'align-items
     di base (flex-start) dentro il box di contenuto di .mod__in (x=46 w=283) e
     la pillola cade a x=46 invece che a 46+(283-275)/2=50. E' l'unica famiglia
     di sezioni per cui il centraggio non era mai stato dichiarato: .blk e
     .cta-wrap--center ce l'hanno gia'. Solo sotto i 900: a desktop il Figma le
     vuole a bandiera (cel-d x=120,5 / 656,5 / 120,5) e li' non si tocca nulla.
     Il bottone cel-m y=4355,1 nel Figma e' a 53,4 w=268,5: e' un'istanza
     RIDIMENSIONATA a mano (stesso fontSize 17,1 e stesso padding 12/12 degli
     altri, ma testo piu' largo — 224,7 contro 220,8 — dentro una pillola piu'
     stretta: una pillola hug non puo' restringersi con piu' testo dentro).
     Il suo CENTRO pero' e' 53,4+134,25 = 187,65, cioe' il centro del frame
     come tutti gli altri (50,1+137,4 = 187,5): non e' spostato, e' solo piu'
     stretto di 6,3px. Centrando, la nostra pillola da 275 gli cade sopra a
     0,15px. Lo scarto che resta e' di larghezza, non di posizione. */
  .mod .cta-wrap{align-items:center}
  /* ⚠ DUE SCHEMI, E SONO VOLUTI COSI' (Matteo, 15 settembre sera).
     - `.mod` base (STAR ITALIANE): titolo, IMMAGINE, testo.
     - `.mod--img-mid` (PASSATI GLI ANTA) e `.mod--split` (PENSI CHE SIA):
       titolo, PRIMO PARAGRAFO, immagine, resto. Sono i due che Matteo ha
       elencato scrivendo «sopra foto».
     Nel pomeriggio erano stati uniformati tutti e tre al primo schema, e le
     due deroghe sono state rimesse: non «sistemarle» di nuovo.
     ⚠ `.mod--split` l'immagine non e' piu' in coda alla sezione ne' a filo
     pagina: quello resta superato.
     Il `margin-top:45px` serve perche' dove il paragrafo segue subito il
     titolo lo stacco non lo da' piu' il margine dell'immagine. */
  .mod__img{order:3}
  .mod--img-mid .mod__txt > .body:first-of-type,
  .mod--split .mod__txt > .body:first-of-type{order:3;margin-top:45px}
  .mod--img-mid .mod__img,
  .mod--split .mod__img{order:4}
}
.mod__img img{width:100%;height:auto}
.mod .cta-wrap{margin-top:45px}
.mod--rose{background:var(--rose)}
.mod--rose .h-sec{color:var(--wine)}

/* --- 4. Sezione rosa ------------------------------------------------------
   ⚠ A MOBILE LA FOTO NON E' PIU' IN CODA NE' A TUTTO SCHERMO (15 settembre).
   Qui c'era l'override che la mandava a filo pagina - margine negativo di un
   gutter e raggio azzerato - piu' un `.mod--split{padding-bottom:0}`, che
   serviva solo perche' la foto era l'ultimo elemento e sotto sarebbe rimasta
   una fascia rosa vuota. Tolti tutti e due: la foto ora sta dopo il titolo,
   dentro la colonna, e prende la cornice di `.mod__img` come le altre.
   A DESKTOP NON CAMBIA NIENTE: li' comanda p2.html, che ridichiara
   `margin:0;border-radius:0` dentro la sua griglia. La foto desktop resta
   quindi ad angoli vivi, che e' una decisione del cliente gia' registrata. */

/* --- 6. Griglia risultati ------------------------------------------------ */
.results{background:var(--rose);padding:45px 0}
.results h2{text-align:center;padding-inline:32px}
.results__grid{display:flex;flex-direction:column;gap:15px;margin-top:40px;padding-inline:37.5px 42.3px}
.card{position:relative;border-radius:var(--r-card);overflow:hidden;aspect-ratio:295.2/207.3}
.card img{width:100%;height:100%;object-fit:cover}
/* su mobile il Figma rende il velo nero al 50%; su desktop no (SPECIFICA §6) */
.card::after{content:"";position:absolute;inset:0;background:rgba(0,0,0,.5)}
.card span{position:absolute;left:31px;bottom:24px;z-index:2;
  font-family:'Geologica',sans-serif;font-weight:900;font-size:28.8px;line-height:36px;color:var(--cream)}
/* Sotto i 900px il Figma mobile mette l'etichetta al CENTRO della card, non in
   basso a sinistra: in tutte e cinque le card la scatola del testo ha scarti
   uguali a sinistra/destra e sopra/sotto. Le tre corte stanno su una riga sola
   (il <br> resta solo da 900px in su, via .only-d); le due lunghe restano su
   due righe dentro la scatola da 231,6px del Figma, col testo a bandiera a
   sinistra: e' la scatola a essere centrata, non le singole righe. I 3px sono
   la discesa che il maiuscolo non usa: senza, il blocco cade 3px piu' in alto
   dell'export (misurato sull'inchiostro, non a occhio). */
@media (max-width:899px){
  .card span{left:0;right:0;top:50%;bottom:auto;transform:translateY(calc(-50% + 3px));
    width:max-content;max-width:100%;margin-inline:auto;text-align:left}
  .results__grid .card:nth-child(4) span,.results__grid .card:nth-child(5) span{width:232px}
}
.results .cta-wrap{margin-top:45px;padding-inline:38px}

/* --- 7 / 17. Interstiziali ----------------------------------------------- */
.inter{background:var(--cream);padding:45px var(--gut)}
.inter h2{margin-top:20px}
.inter .body{margin-top:45px}
.inter--white{background:var(--white);text-align:center}
.inter--white h2{margin-top:21px}

/* --- 8 / 9. Card dottoressa ---------------------------------------------- */
.doc{background:var(--cream);padding:0 0 45px}
.doc__tab{position:relative;z-index:2;display:inline-block;margin-left:20px;
  min-width:156.6px;
  padding:8px 18px;border-radius:9px 9px 0 0;background:var(--wine);color:var(--white)}
/* Le varianti di colore DEVONO stare dopo la base: stessa specificita',
   vince l'ultima. Nel Figma il testo della linguetta della garanzia e'
   rgb(74,27,33) = --wine, quindi il fondo e' rosa come la card. */
.doc__tab--rose,.doc__tab--center{background:var(--rose);color:var(--wine)}
/* Figma mobile: fontSize 48 / lineHeight 60 alla scala 1/3,3333 = 14,4 / 18 */
.doc__tab > b{display:block;font-family:'Geologica',sans-serif;font-weight:500;font-style:italic;
  font-size:14.4px;line-height:18px}
/* "Dott.ssa" e' ExtraLight e a mobile sta su una riga sua (nel Figma il nodo
   contiene un a-capo esplicito). A desktop torna in linea: vedi p2.html. */
.doc__tab > b span{display:block;font-weight:200}
.doc__tab i{display:none;font-family:'Geologica',sans-serif;font-weight:200;font-style:italic;
  font-size:11px;line-height:14px;opacity:.85}
/* Figma: "Biologa Nutrizionista" e' Medium, il resto della qualifica
   ExtraLight; "Medico", che e' una qualifica intera, e' tutto Medium. */
.doc__tab i b{font-weight:500}
.doc__tab--center i{font-weight:500}
.doc__tab--rose i,.doc__tab--center i{opacity:1}
/* Rientro laterale 32 e non 18: con 18 la colonna di testo viene 294 px,
   mentre nel Figma mobile il testo delle card dottoresse sta fra x 56,70 e
   320,06. Non era un'inezia ottica: con la colonna larga ogni riga si
   allungava e la rottura slittava in avanti, e NESSUN a-capo cadeva dove cade
   nel disegno.
   Il 32 non e' dedotto dalla misura del Figma ma TROVATO PROVANDO: rendendo
   le due card a larghezze da 256 a 276 px e contando quanti a-capo coincidono,
   il massimo e' a 266-267 px di colonna (37 su 40; a 256 sono 15, a 276 sono
   26, e a 294 - dove eravamo - praticamente nessuno). 330 - 2x32 = 266.
   Serviva provare perche' il nostro testo rende circa l'1,4% piu' stretto del
   Figma a parita' di corpo dichiarato, quindi la colonna giusta per noi non e'
   quella misurata li'. I tre a-capo che restano fuori sono ai confini fra un
   paragrafo e l'altro, dove l'estrazione dal PDF non e' affidabile.
   Il 28 in basso e i margini della card non si toccano. */
.doc__card{position:relative;margin:0 25px 0 20px;padding:18px 32px 28px;border-radius:9px;background:var(--wine);color:var(--white)}
.doc__card--rose{background:var(--rose);color:var(--wine)}
.doc__photo{border-radius:9px;overflow:hidden}
.doc__photo img{width:100%;height:auto}
.doc__role{margin-top:24px;font-family:'Geologica',sans-serif;font-weight:200;font-style:italic;
  font-size:14.4px;line-height:18px;opacity:.85}
.doc__role b{font-weight:500}
/* --- titolo DENTRO la card dottoressa ------------------------------------
   Non esisteva: arriva col racconto in prima persona di Alessia (15 settembre).
   L'impianto e' quello di `.prob__card h2`, l'unico titolo-dentro-una-card che
   il disegno avesse: prima riga in maiuscolo, seconda in corsivo colorata.
   ⚠ Il colore del titolo NON si dichiara: si eredita dalla card. Cosi' la card
   bordeaux lo prende bianco e quella rosa lo prende bordeaux, senza scrivere
   due regole che poi divergono. Si dichiara solo il corsivo, che sul rosa
   andrebbe a finire in rosa-cta - contrasto 1,54, illeggibile. */
.doc__h{margin:0 0 18px;font-size:24px;line-height:30px}
.doc__h .it{display:block;font-size:19.2px;line-height:24px;color:var(--rose-cta)}
.doc__card--rose .doc__h .it{color:var(--wine)}
/* senza linguetta la seconda card e' tonda su tutti e quattro gli angoli */
.doc__card--sola{border-radius:9px}
/* A MOBILE IL TITOLO VA PRIMA DELLA FOTO, come in tutte le altre sezioni
   («su mobile sempre prima titolo poi immagini», Matteo, 15 settembre).
   Nel markup il titolo deve restare dentro la colonna di testo, perche' a
   desktop quella colonna e' la seconda cella della griglia e il titolo ci
   vive dentro: qui si riordina soltanto. `display:contents` porta i figli
   della colonna al livello del flex della card, cosi' `order` puo'
   interlacciarli con la foto - lo stesso meccanismo gia' usato da .mod__txt.
   Ordine voluto: titolo, foto, qualifica, testo. */
@media (max-width:899px){
  .doc__card{display:flex;flex-direction:column}
  .doc__card > div{display:contents}
  .doc__h{order:1}
  .doc__photo{order:2;margin-top:18px}
  .doc__role{order:3}
  .doc__body{order:4}
}
.doc__body{margin-top:30px;font-size:19.2px;line-height:25px}
.doc__body + .doc__body{margin-top:1em}
.doc__list{margin:28px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:22px}
.doc__list li{display:flex;gap:8px;align-items:flex-start;font-size:19.2px;line-height:25px}
.doc__list picture{flex:0 0 23px;margin-top:2px}
.doc__list img{width:23px;height:25px}
.doc .cta-wrap{margin-top:45px;align-items:center;padding-inline:var(--gut)}
.doc__tab--center{display:block;width:max-content;margin:0 auto;text-align:left;border-radius:9px 9px 0 0}

/* --- 11..16. Blocchi numerati -------------------------------------------- */
.blk{padding:45px 0}
.blk__in{padding-inline:var(--gut)}
.blk h2{margin-top:20px}
/* 45 nel Figma meno i 10,5px in cui la nostra riga in Brush Script e' piu'
   alta di quella a interlinea automatica del Figma (48 contro 37,5).
   p2.html la ridefinisce a 28 sopra i 900. */
.blk .body{margin-top:34.5px}
@media (max-width:899px){
  /* Il titolo delle card ha nel Figma una scatola larga 309,9 che lo manda a
     capo in tre righe. I 307 di colonna sono quei 309,9 meno il tanto in cui
     il nostro Geologica rende piu' largo dell'export (2,5%): con 310 tondi
     "I RISULTATI CHE" rientrerebbe in riga per 0,2px. Il max-width e' 307+64
     perche' box-sizing e' border-box e comprende il padding. Sotto i 371 non
     morde e la colonna la fa il padding, come prima. */
  .results h2{max-width:371px;margin-inline:auto}
  /* fra due paragrafi il Figma ha una riga vuota, non lo stacco del titolo */
  .blk .body + .body{margin-top:25px}
  /* blocco 02 di Celebrities: a 375 il primo .body e' spento (.only-d), e
     il selettore qui sopra colpirebbe il .only-m che gli sta dietro */
  .blk .only-d + .body{margin-top:34.5px}
  /* blocco garanzia: li' dopo il titolo viene l'immagine */
  .blk .h-sec + .blk__img{margin-top:34.5px}
}
.blk__img{margin:45px -6px;border-radius:var(--r-card);overflow:hidden}
.blk__img img{width:100%;height:auto}
/* ⚠ `.blk__bleed` NON ESISTE PIU' (15 settembre). Era la foto a filo pagina in
   fondo ai due blocchi `.blk--split` (NUTRIZIONE e CHEF) di ciascuna landing:
   Matteo ha chiesto che ogni sezione segua lo schema titolo-immagine-testo e
   che la foto sia incorniciata nella card, non a tutto schermo. Nel markup
   quelle quattro figure sono diventate `.blk__img` subito dopo l'`<h2>`, col
   taglio 295x354 che usano gia' tutte le altre - il 375x437 resta generato
   perche' lo usa ancora il `<source>` di `.blk__side`.
   Cade con loro anche `.blk--split{padding-bottom:0}`, che serviva soltanto
   perche' la foto era l'ultimo figlio della sezione. */
.blk .cta-wrap{margin-top:45px;align-items:center;padding-inline:4px}
.blk--rose{background:var(--rose)}
.blk--cream{background:var(--cream)}
/* .blk--garanzia va sempre insieme a .blk--taupe: stesso fondo, stessi
   colori. Stava SOLO in sen-extra.css, e Celebrities - che quel foglio non
   lo carica - si ritrovava il blocco garanzia col testo bordeaux sul velo
   bruno, 2,1:1 di contrasto. Il markup era stato copiato da Sensuality il
   12 settembre, lo stile no. Qui sono nel foglio condiviso: valgono per
   tutte e due le landing e non si possono piu' dimenticare. */
.blk--taupe,.blk--garanzia{background:var(--taupe);color:var(--cream)}
.blk--taupe .h-sec,.blk--garanzia .h-sec{color:var(--cream)}
.blk--taupe .h-sec .it,.blk--garanzia .h-sec .it{color:var(--rose-cta)}
.blk--taupe .cta-note,.blk--garanzia .cta-note{color:var(--cream)}

/* --- 18. Testimonianze --------------------------------------------------- */
.testi{background:var(--rose);padding:45px 0}
.testi h2{text-align:center;padding-inline:32px;font-weight:900}
.testi h2 .w4{font-weight:400}
.testi__list{display:flex;flex-direction:column;gap:45px;margin-top:45px;padding-inline:27px}
.testi__list .video{margin-top:0}
/* Il titolo sotto il video, preso dalla pagina del cliente. Nel Figma i
   riquadri sono nudi: questa e' una scelta, non un riallineamento.
   Centrato come il titolo della fascia, e col CORPO DEL TESTO della pagina -
   `.body`, 19,2/25 e 20/26 - perche' sono frasi vere. Fino al 12 settembre
   aveva la misura della riga di garanzia sotto le CTA (14,4/20 e 16/22), cioe'
   quella di un testo di SERVIZIO, e lette accanto al resto della pagina
   sembravano note a pie' di pagina. Provate anche una misura intermedia
   (17/24 e 18/26) e Geologica 700: scartate, scatti in out/K2. */
.testi__item{display:flex;flex-direction:column;margin:0}
.testi__tit{margin-top:16px;text-align:center;color:var(--wine);
  font-size:19.2px;line-height:25px}
/* --- 18b. Prima e dopo ---------------------------------------------------
   Le diciotto immagini del cliente, sotto i video. Stessa griglia e stesso
   passo dei riquadri video, cosi' la fascia si legge come un blocco solo.
   Le immagini sono gia' montate dal cliente (due o tre pannelli dentro un
   file): qui non si ritagliano, si mostrano intere. */
.galw{position:relative;margin-top:45px}
/* Nastro che scorre da solo, in loop infinito - stesso meccanismo di
   .press__track (vedi piu' sopra): due copie affiancate, il nastro trasla
   della META' esatta della propria larghezza e il giro si richiude senza
   salto, perche' a -50% la copia duplicata e' arrivata esattamente dove
   stava la prima all'inizio. Chiesto da Matteo il 12 settembre ("tipo
   testate sotto hero"): prima qui c'era uno scorrimento a mano con frecce,
   tolto insieme a loro - lo spostamento e' passivo, non c'e' piu' niente da
   trascinare o su cui navigare col tab. */
.gal{overflow:hidden}
.gal__track{display:flex;gap:14px;width:max-content;
  animation:pd-scorre 259s linear infinite}
.pd{flex:0 0 300px;border-radius:var(--r-card);overflow:hidden}
.pd img{width:100%;height:auto}
@keyframes pd-scorre{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){
  /* ferma il nastro: resta scorrevole a dito, come la barra delle testate */
  .gal__track{animation:none}
  .gal{overflow-x:auto}
}
.testi .cta-wrap{margin-top:45px;align-items:center;padding-inline:25px}

/* --- 19. FAQ ------------------------------------------------------------- */
.faq{background:var(--rose);padding:45px 0}
.faq__head{text-align:center}
.faq__head .eyebrow svg{margin-inline:auto}
.faq__head h2{margin-top:21px}
.faq__list{margin-top:45px;padding-inline:25.8px;display:flex;flex-direction:column;
  align-items:flex-start;gap:15px;width:100%}
/* Le pillole si adattano al testo (larghezza hug), non sono a piena riga:
   nel Figma vanno da 210 a 298 px su mobile. */
/* nessun limite di larghezza: nel Figma le righe 6-8 arrivano a x361, cioe'
   a 14px dal bordo, sbordando oltre il gutter da 26 */
.faq__row{display:flex;gap:.6px;align-items:stretch;width:100%}
.faq__q{flex:1 1 auto;display:flex;gap:4.8px;align-items:center;min-height:40.8px;
  padding:0 19.2px;border:0;text-align:left;cursor:pointer;
  border-radius:20.4px 3.6px 3.6px 20.4px;background:var(--wine-deep);color:var(--rose-faq);
  font-family:'Roboto',system-ui,sans-serif;font-weight:400;font-size:13.5px;line-height:15.6px}
.faq__t{flex:0 0 40.8px;width:40.8px;min-height:40.8px;display:grid;place-items:center;border:0;
  cursor:pointer;border-radius:3.6px 20.4px 20.4px 3.6px;background:var(--wine-deep);color:var(--rose-faq)}
/* icone: sono i Material Symbols di default del componente Figma.
   Il testo dello span E' la legatura ("settings", "front_hand", ...): finche' il
   font delle icone non arriva il browser mostra il ripiego, cioe' la PAROLA, che
   sborda dalla pillola. Due difese indipendenti:
   1) box fissato a 1em x 1em con overflow:hidden. Col font caricato e' esattamente
      la misura del glifo (20x20 a fs 20px, 25x25 a fs 25px): geometria invariata.
      Senza font il ripiego resta tagliato dentro il quadrato e il layout non si
      muove di un pixel;
   2) visibility:hidden finche' <html> non prende la classe .mso, che lo script in
      fondo all'head aggiunge solo quando document.fonts conferma il font. */
.msym{font-family:'Material Symbols Outlined',sans-serif;font-weight:400;font-style:normal;
  line-height:1;letter-spacing:normal;text-transform:none;white-space:nowrap;direction:ltr;
  -webkit-font-feature-settings:'liga';font-feature-settings:'liga';
  -webkit-font-smoothing:antialiased;flex:0 0 auto;
  width:1em;height:1em;overflow:hidden}
.js .msym{visibility:hidden}
.mso .msym{visibility:visible}
.faq__q .msym{font-size:12px}
.faq__t .msym{font-size:15px;transition:transform .25s ease}
.faq__row.open .faq__t .msym{transform:rotate(180deg)}
.js .faq__a{display:none}
.faq__a{margin:0 0 0 19.2px;padding:10px 19.2px 4px 0;font-size:15px;line-height:22px;color:var(--wine)}
.faq__row.open + .faq__a{display:block}

/* ---- risposte delle FAQ --------------------------------------------------
   Testo preso dalla pagina pubblicata del cliente; sta sul rosa della sezione,
   quindi in bordeaux. */
.faq__a p{margin:0}
.faq__a p + p{margin-top:.7em}
.faq__a strong{font-weight:700}
.faq__a u{text-decoration:underline;text-underline-offset:2px}
.faq__a a{color:var(--wine);font-weight:700}

/* ---- footer -------------------------------------------------------------
   Contenuti dalla pagina pubblicata (oasiormonale.com/pages/sensualita),
   ridisegnati con la palette del Figma: fondo prugna, testo crema, link rosa. */
.legal{background:var(--wine-deep);color:var(--cream);
  padding:45px var(--gut) calc(38px + env(safe-area-inset-bottom));
  font-size:14.4px;line-height:22px}
.legal__in{max-width:var(--maxw);margin-inline:auto}
/* Oltre gli ~80 caratteri per riga la lettura si perde, e senza freno il footer
   largo 1250 arrivava a 176. Le tre misure qui sotto sono i pixel che, con
   questi corpi, fanno 82 caratteri: misurati, non stimati. */
.legal__claim{font-size:16px;line-height:24px;color:var(--cream);max-width:640px}
.legal__cols{display:flex;flex-direction:column;gap:26px;margin-top:32px}
.legal__col h3{font-family:'Geologica',sans-serif;font-weight:900;font-size:13px;
  line-height:18px;letter-spacing:.04em;text-transform:uppercase;color:var(--rose-cta);margin-bottom:8px}
.legal a{color:var(--rose-cta);text-decoration:none;border-bottom:1px solid rgba(219,154,168,.35)}
.legal a:hover{color:var(--cream);border-bottom-color:currentColor}
/* I quattro link legali, uno per riga. Stavano in linea separati da «·» e
   andavano a capo DENTRO il nome: a 1000 px «Cookie / Policy» e «Termini e /
   Condizioni», a 1250 e a 1920 un «·» appeso a fine riga. La colonna e' larga
   245 px a 1250 e 182,5 a 1000; i quattro nomi in linea ne chiedono 390 piu' i
   separatori, quindi in riga non ci stanno a nessuna larghezza di questo
   disegno. Misure in scratchpad/out/R1.
   ⚠ `.legal__sep` e' stato tolto con loro: non lo usava piu' nessuno. */
.legal__voci{margin:0;padding:0;list-style:none;
  display:flex;flex-direction:column;align-items:flex-start;gap:7px}
.legal__fonti{margin-top:32px;border-top:1px solid rgba(246,237,228,.14);padding-top:20px}
.legal__fonti summary{font-family:'Geologica',sans-serif;font-weight:900;font-size:13px;
  letter-spacing:.04em;text-transform:uppercase;color:var(--rose-cta);cursor:pointer;list-style:none}
.legal__fonti summary::-webkit-details-marker{display:none}
.legal__fonti summary::after{content:" +";font-family:'Niramit',sans-serif;font-weight:400}
.legal__fonti[open] summary::after{content:" –"}
.legal__fonti ul{margin:16px 0 0;padding:0;list-style:none;display:grid;gap:8px;font-size:13px;line-height:19px}
.legal__fonti a{word-break:break-word}
/* ⚠️ `.legal__disclaimer` non esiste piu': il disclaimer medico e' stato
   tolto il 20 settembre perche' non era testo del cliente. Se torna, torna
   anche questa riga. */
.legal__copy{margin-top:22px;font-size:12.5px;line-height:19px;color:rgba(246,237,228,.62)}
.legal__meta{margin-top:14px;font-size:11.5px;line-height:17px;color:rgba(246,237,228,.42);max-width:425px}

/* ---- popup di opt-in ------------------------------------------------------
   Il form della pagina pubblicata del cliente, rivestito con la palette del
   Figma: pannello crema, testo bordeaux, accenti rosa antico. Base = mobile. */
/* Centrato a OGNI larghezza, dal 12 settembre. Prima sotto i 640 era un
   foglio che saliva dal basso (angoli arrotondati solo in cima, ombra verso
   l'alto) e solo da tablet in su diventava una finestra: adesso il trattamento
   della finestra e' quello di base, e il blocco da 640 tiene solo cio' che e'
   davvero suo. `env(safe-area-inset-bottom)` sta qui e non dentro il pannello:
   il pannello non tocca piu' il fondo, e li' dentro sarebbe un vuoto morto. */
.oo-modal{--gut-mod:22px;position:fixed;inset:0;z-index:9999;display:flex;
  align-items:center;justify-content:center;
  padding:16px 16px calc(16px + env(safe-area-inset-bottom))}
.oo-modal[hidden]{display:none}
html.oo-modal-open{overflow:hidden}
.oo-modal__backdrop{position:absolute;inset:0;background:rgba(49,17,29,.62);
  backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);
  opacity:0;transition:opacity .26s ease}
.oo-modal.is-open .oo-modal__backdrop{opacity:1}
.oo-modal__panel{position:relative;width:100%;max-width:640px;max-height:92vh;max-height:92dvh;
  display:flex;flex-direction:column;overflow:hidden;background:var(--cream);color:var(--wine);
  border-radius:var(--r-card);
  box-shadow:0 18px 50px rgba(49,17,29,.38);
  transform:translateY(14px) scale(.985);opacity:0;transition:transform .3s cubic-bezier(.2,.8,.3,1),opacity .26s ease}
.oo-modal.is-open .oo-modal__panel{transform:none;opacity:1}
/* la fascia rosa in cima ripete il bordo delle sezioni del Figma */
.oo-modal__panel::before{content:"";display:block;height:5px;flex:none;
  border-radius:var(--r-card) var(--r-card) 0 0;background:var(--rose-cta)}
/* 20/22 e non 26/26: 10 px. Da 640 in su torna a 34, dove lo spazio c'e'. */
.oo-modal__inner{overflow-y:auto;-webkit-overflow-scrolling:touch;
  padding:20px var(--gut-mod) 22px}
.oo-modal__close{position:absolute;top:18px;right:14px;z-index:2;
  width:38px;height:38px;display:flex;align-items:center;justify-content:center;
  padding:0;border:0;border-radius:50%;background:rgba(246,237,228,.12);color:var(--rose-faq);
  cursor:pointer;transition:background-color .18s ease,transform .18s ease}
.oo-modal__close svg{width:19px;height:19px}
.oo-modal__close:hover{background:rgba(246,237,228,.24);transform:rotate(90deg)}
/* il bottone e' 38px: l'area che risponde al dito arriva a 46 */
.oo-modal__close::after{content:"";position:absolute;inset:-4px}
/* La testata e' una fascia prugna, come le sezioni scure delle landing: e' li'
   che il rosa antico ha il contrasto per reggere un titolo (7,5:1 contro il 2:1
   che avrebbe sul crema). Sborda dal padding del contenitore. */
/* ⚠ Il margine negativo DEVE valere quanto l'imbottitura di .oo-modal__inner
   qui sopra, se no la fascia scura non arriva piu' al bordo del pannello.
   20/18 invece di 26/24: altri 12 px. */
.oo-modal__head{margin:-20px calc(var(--gut-mod) * -1) 18px;
  padding:20px var(--gut-mod) 18px;padding-right:calc(var(--gut-mod) + 34px);
  background:var(--wine-deep);color:var(--cream)}
.oo-modal__title{margin:0;font-family:'Geologica',sans-serif;font-weight:900;
  font-size:27px;line-height:32px;letter-spacing:-.01em;color:var(--white)}
.oo-modal__title em{font-style:italic;color:var(--rose-cta)}
.oo-modal__sub{margin:9px 0 0;font-size:16px;line-height:23px;color:rgba(246,237,228,.76)}

/* 12 e non 14: quattro spazi fra i campi, 8 px risparmiati. */
.oo-form{display:flex;flex-direction:column;gap:12px}
/* NOME E COGNOME AFFIANCATI ANCHE A MOBILE. Impilati pesavano 160 px sui
   742 del contenuto: affiancati ne pesano 73, cioe' 87 px risparmiati - il
   taglio piu' grosso di tutti, e senza togliere niente. A 360 px la
   colonna interna e' 284 e ogni campo ne prende 136: per questo i
   segnaposto sono stati accorciati a "Nome" e "Cognome" (l'etichetta sopra
   il campo resta, e dice gia' tutto). */
.oo-form__row{display:flex;flex-direction:row;gap:12px}
.oo-form__row .oo-field{flex:1 1 0;min-width:0}
.oo-field{display:flex;flex-direction:column;gap:6px;min-width:0}
.oo-field__label{font-family:'Geologica',sans-serif;font-weight:900;font-size:11.5px;
  line-height:15px;letter-spacing:.06em;text-transform:uppercase;color:rgba(75,28,34,.6)}
.oo-field__wrap{position:relative;display:flex;align-items:center}
.oo-field__icon{position:absolute;left:15px;width:19px;height:19px;
  fill:var(--rose-cta);pointer-events:none;transition:fill .18s ease}
/* 48 e non 52: quattro campi, 16 px. Resta sopra i 44 px di bersaglio
   tattile consigliati. */
.oo-field input{width:100%;min-width:0;height:48px;padding:0 16px 0 44px;
  border:1.5px solid rgba(75,28,34,.16);border-radius:14px;
  background:var(--white);color:var(--wine);
  font-family:'Niramit',system-ui,sans-serif;font-size:16.5px;line-height:22px;
  transition:border-color .18s ease,box-shadow .18s ease}
.oo-field input::placeholder{color:rgba(75,28,34,.36)}
.oo-field input:focus{outline:0;border-color:var(--rose-cta);box-shadow:0 0 0 3px rgba(219,154,168,.32)}
.oo-field input:focus + .oo-field__icon,.oo-field__wrap:focus-within .oo-field__icon{fill:var(--wine)}
.oo-field.is-invalid input{border-color:#B3323F;background:#FFF6F7}
.oo-field.is-invalid .oo-field__icon{fill:#B3323F}
.oo-field__err{margin:0;min-height:0;font-size:13.5px;line-height:18px;color:#B3323F}
.oo-field__err:empty{display:none}
/* consenso: casella disegnata, con l'input vero sotto per accessibilita' */
.oo-consenso{margin-top:4px}
.oo-check{display:flex;align-items:flex-start;gap:10px;cursor:pointer;
  font-size:13.5px;line-height:19px;color:rgba(75,28,34,.78)}
.oo-check input{position:absolute;opacity:0;width:22px;height:22px;margin:0;cursor:pointer}
.oo-check__box{flex:none;width:22px;height:22px;margin-top:1px;border-radius:6px;
  border:1.5px solid rgba(75,28,34,.28);background:var(--white);
  display:flex;align-items:center;justify-content:center;
  transition:background-color .15s ease,border-color .15s ease}
.oo-check__box svg{width:16px;height:16px;fill:var(--white);opacity:0;transform:scale(.6);
  transition:opacity .15s ease,transform .15s ease}
.oo-check input:checked + .oo-check__box{background:var(--wine);border-color:var(--wine)}
.oo-check input:checked + .oo-check__box svg{opacity:1;transform:none}
.oo-check input:focus-visible + .oo-check__box{outline:0;box-shadow:0 0 0 3px rgba(219,154,168,.45)}
.oo-check__txt a{color:var(--wine);text-decoration:underline;text-underline-offset:2px}
.oo-consenso.is-invalid .oo-check__box{border-color:#B3323F;background:#FFF6F7}
.oo-consenso .oo-field__err{margin-top:5px}

/* honeypot: fuori dalla vista ma raggiungibile dai bot */
.oo-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

.oo-form__submit{margin-top:6px;width:100%;min-height:56px;padding:15px 22px;
  border:0;border-radius:var(--r-pill);background:var(--wine);color:var(--white);
  font-family:'Roboto',system-ui,sans-serif;font-weight:500;font-size:17px;line-height:19.2px;
  letter-spacing:-.08px;cursor:pointer;
  transition:transform .18s ease,background-color .18s ease,opacity .18s ease}
.oo-form__submit:hover{transform:translateY(-2px)}
.oo-form__submit:active{transform:translateY(0) scale(.98);background:#3C1319}
.oo-form__submit:disabled{opacity:.72;cursor:default;transform:none}
.oo-form__submit.is-loading .oo-form__submit-text::after{content:"";display:inline-block;
  width:1.1em;text-align:left;animation:oo-dots 1.1s steps(4,end) infinite}
@keyframes oo-dots{0%{content:""}25%{content:"."}50%{content:".."}75%{content:"..."}}
.oo-form__submit--ghost{margin-top:22px;background:transparent;color:var(--wine);
  box-shadow:inset 0 0 0 1.5px rgba(75,28,34,.28)}
.oo-form__submit--ghost:active{background:rgba(75,28,34,.06)}
.oo-form__msg{margin:0;font-size:14.5px;line-height:20px;color:#B3323F;text-align:center}
.oo-form__msg:empty{display:none}
.oo-form__note{margin:2px 0 0;display:flex;flex-direction:column;gap:5px;
  font-size:13px;line-height:18px;color:rgba(75,28,34,.6);text-align:center}
.oo-form__note-line{display:inline-flex;align-items:center;justify-content:center;gap:6px}
.oo-form__note svg{width:14px;height:14px;flex:none;fill:var(--rose-cta)}
.oo-form__note a{color:var(--wine);text-decoration:underline;text-underline-offset:2px;
  display:inline-block;padding:4px 2px;margin:-4px -2px}

.oo-modal__head--ok{text-align:center;padding-right:var(--gut-mod)}
.oo-modal__view--success{padding-bottom:6px}
.oo-success__badge{width:66px;height:66px;margin:0 auto 20px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:var(--rose);animation:oo-pop .42s cubic-bezier(.2,1.4,.4,1) both}
.oo-success__badge svg{width:36px;height:36px;fill:var(--wine)}
@keyframes oo-pop{from{transform:scale(.5);opacity:0}to{transform:none;opacity:1}}

@media (prefers-reduced-motion:reduce){
  .oo-modal__panel,.oo-modal__backdrop,.oo-modal__close,.oo-form__submit{transition:none}
  .oo-modal__panel{transform:none}
  .oo-success__badge{animation:none}
}

/* ---- adattamento alle larghezze fuori progetto ---------------------------
   Il Figma da' due misure sole: 375 e 1250. Qui si copre quello che c'e' in
   mezzo e ai lati, senza toccare le due misure di progetto. */

@media (max-width:899px){
  /* Sopra i ~650px le colonne continuerebbero a crescere e le righe di testo
     arriverebbero a 150 caratteri: si fermano a 560 e i margini prendono il
     resto. Sotto quella soglia il gutter resta quello del Figma. */
  :root{--gut:max(36px, calc((100vw - 560px) / 2))}

  /* Le pillole delle FAQ sono alte 40,8px: il bersaglio tattile si estende di
     3px sopra e sotto senza spostare nulla di visibile. */
  .faq__q,.faq__t{position:relative}
  .faq__q::after,.faq__t::after{content:"";position:absolute;inset:-3px 0}
}

@media (min-width:620px) and (max-width:899px){
  /* questi tre hanno margini fissi, non legati al gutter */
  .doc__card{max-width:560px;margin-inline:auto}
  .doc__tab{margin-left:calc((100vw - 560px) / 2)}
  .faq__list{max-width:560px;margin-inline:auto;padding-inline:0}
}

/* La fascia testimonianze ha lo stesso problema, e la stessa cura: sopra i 375
   teneva il layout di mobile mentre la banda cresceva. Misurato a 899: il video
   restava a 322 - la misura di mobile - mentre la didascalia si allargava a 829,
   cioe' da bordo a bordo sotto un riquadro largo un terzo, e le prima/dopo
   venivano stirate a 801 px da un raster di 383x303 (@2x 766), cioe' 2,09 volte.
   A 600 erano 530 e 502; a 414, 360 e 332.
   Qui video, didascalia, prima/dopo e CTA condividono UNA colonna: 383 e' la
   misura di progetto del desktop ed e' anche il punto oltre il quale le immagini
   si sgranano; +54 e' il gutter da 27 per lato, che resta quello del Figma.
   ⚠ A 375 non cambia niente: li' la colonna e' gia' piu' stretta di 383 e il
   tetto non morde. Parte da 376 apposta. */
@media (min-width:376px) and (max-width:899px){
  .testi__list{max-width:437px;margin-inline:auto}
  /* il video riempie la colonna invece di fermarsi ai 322 di mobile */
  .testi__list .video{max-width:none}
  .galw{max-width:437px;margin-inline:auto}
  .testi .cta-wrap{max-width:437px;margin-inline:auto}
}

@media (max-width:374px){
  /* Sotto la misura di progetto il Figma non dice piu' nulla, e le larghezze
     fisse escono dallo schermo. Le regole qui dentro valgono solo qui: a 375
     nulla cambia. */
  /* Con l'etichetta unica la pillola serve 238,61 px di inchiostro a 16px
     (1 px di inchiostro ogni 0,0671 px di corpo, misurato). Sotto i 375 la
     colonna non li regge piu': lo spazio utile dentro la pillola e'
     100vw - 132 (92 di gutter, 8 del wrap, 32 di padding della pillola).
     Il corpo scende con la colonna, ma non sotto i 14 px: piu' in giu'
     diventerebbe illeggibile, e a quel punto e' meglio una riga in piu'.
     Effetto misurato: niente piu' a-capo da 341 px in su (prima, con
     l'etichetta nuova, andavano a capo 10 CTA su 14 gia' a 360). */
  .cta{font-size:max(14px,min(18px,calc((100vw - 112px) / 15)))}
  .cta{min-width:min(275px,100%)}
  .cta-wrap--wide .cta,.testi .cta{min-width:min(325px,100%)}
  /* Qui sotto il 100% e' quello del wrap: senza lo sbordo la pillola larga
     diventerebbe identica alle altre (a 320 passerebbe da 262 a 220). Il
     margine negativo serve SOLO in questo intervallo. */
  .cta-wrap--wide{margin-inline:calc(16px - var(--gut))}

  /* Le pillole delle FAQ — che nel Figma restano su una riga e sbordano di
     proposito — qui vanno a capo. */
  .faq__list{padding-inline:16px}
  .faq__q{padding:8px 14px;align-items:flex-start}
  .faq__q .msym{margin-top:1px}
}

/* ============================================================================
   DESKTOP — artboard 163:5310, 1250 px CSS
   Le altezze fisse del Figma (725) non sono replicate: in più punti le
   text-box sono più basse delle righe che contengono e i titoli finiscono
   sotto le card (SPECIFICA §6 e §18). Qui il ritmo è dato dal padding.
   ========================================================================= */
@media (min-width:900px){
  :root{--gut:120px}
  body{font-size:20px;line-height:26px}
  .only-d{display:revert!important}
  .only-m{display:none!important}

  .h-sec{font-size:48px;line-height:48px}
  .h-big{font-size:64px;line-height:72px}
  .body{font-size:20px;line-height:26px}
  .eyebrow svg,.num svg{width:calc(var(--vw, 117) * .5px);height:auto}

  .cta{min-height:70px;min-width:264px;padding:16px 30px;font-weight:400;font-size:16px;line-height:20px;letter-spacing:0}
  /* la pillola larga su desktop e' 313, non 264 (Figma: sen-d e cel-d, x 120,5 w 313,0) */
  .cta-wrap--wide .cta{min-width:313px}
  /* Pillola corta: SOLO il bottone del blocco 02 di Celebrities (Figma cel-d
     163:5379, x 120,5 w 184,0 h 69,5). E' l'unico che la designer ha stretto a
     mano: le altre dodici pillole di quel frame stanno su 264,5 / 313,0 / 329,0,
     e il min-width generale da 264 lo gonfiava a 264,0, cioe' +80,0. Il tetto da
     solo non basta, perche' con padding-inline 30 l'etichetta chiede 133,0 + 60
     = 193: si stringe anche il padding a 25,5, che e' esattamente l'aria che il
     Figma lascia intorno all'inchiostro, (184,0 - 133,0) / 2. Sta qui dentro e
     non piu' in basso perche' a mobile il Figma vuole i soliti 274,8 (cel-m
     182:6078) e sotto i 900 non deve cambiare niente. */
  .cta--narrow{min-width:184px;padding-inline:25.5px}
  .cta-wrap{gap:10px}
  /* la riga garanzia e' una scatola fissa da 264 (la misura del Figma, che
     resta 264,5 anche dove il bottone cresce a 313 o 329) col testo centrato
     dentro: nei gruppi allineati a sinistra parte dal bordo sinistro del
     bottone, in quelli centrati resta libera (nel Figma e' larga 406).
     align-self:center la centrava invece sull'intera colonna di testo. */
  .cta-wrap .cta-note{align-self:flex-start;text-align:center;width:264px;max-width:100%}
  .cta-wrap--center .cta-note{align-self:center;width:auto;max-width:none}
  .cta-note{font-size:16px;line-height:20.8px}
  /* Figma SEN 222:2098: su desktop questa riga e' Niramit Bold 700 in blocco,
     senza override. E' l'unica delle 24 righe garanzia dei quattro frame
     fatta cosi', ma e' quello che il Figma dice e resta. Il gemello mobile
     (SEN 222:2559) torna a base 400 col grassetto sui soli due run, quindi la
     regola vive qui e non nel foglio base: li' valeva anche a 375.
     `b{font-weight:inherit}` spegne il `bolder` del browser, che dentro un
     genitore a 700 salirebbe a 900: oggi non si vede perche' Niramit e'
     caricato solo a 400 e 700 e il 900 ricade sul 700 (misurato: stessa
     larghezza d'inchiostro, 128,72 e 80,89 a 1250), ma con una faccia piu'
     pesante diventerebbe un difetto. */
  .cta-note--b{font-weight:700}
  .cta-note--b b{font-weight:inherit}

  /* --- 1. Hero ----------------------------------------------------------- */
  .hero{min-height:725px}
  .hero__in{padding:72px 24px 77px}
  /* 850 e non 837: l'occhiello di Celebrities chiede 839,3 px su una riga
     sola e a 837 andava a capo lasciando "TV?" da solo sulla riga sotto, a
     OGNI larghezza da 900 a 1920 (misurato). Mancavano 2,3 px. Lo spazio
     c'e': la colonna della hero e' 100vw - 48, cioe' 852 gia' a 900 px.
     ⚠ Regola CONDIVISA, ma su Sensuality non cambia niente: li' la riga
     misura 778,0 px e stava su una riga sola anche prima (verificato).
     ⚠ Nel Figma di Celebrities questo occhiello e' 12 px su una riga larga
     503,6, non 20: la hero di questa landing e' ancora quella dell'8
     settembre e il riallineamento e' un cantiere a se'. Questa riga chiude
     l'a-capo senza rimpicciolire il testo. */
  .hero__pre{font-size:20px;line-height:26px;max-width:850px;margin-bottom:18px}
  .hero h1{font-size:48px;line-height:60px;max-width:987px;margin-inline:auto}
  .hero h1 .l2,.hero h1 .l3{font-size:32px;line-height:40px}
  .hero h1 .l2{font-weight:700}
  /* 838, non 812: a 812 il sottotitolo di Sensuality andava a capo su
     "palestra" da sola (misurato: la riga intera chiede 836,9px). Segnalato
     nel video di Matteo del 12 settembre (0:20-0:34), evidenziando proprio
     quella parola. Su Celebrities il sottotitolo resta piu' lungo di suo e
     va a capo comunque: qui non cambia niente. */
  .hero__sub{max-width:838px;margin-top:25px;font-size:20px;line-height:26px}
  .hero__note{margin-top:10px;font-size:16px;line-height:20.8px}
  .video{max-width:383px;margin-top:25px;border-radius:40px}
  /* 438 = nodo Figma SEN 222:2194 (438,5x257), la VSL della fascia scura di
     questa stessa pagina: gia' costruita in sen-extra e gia' prodotta come
     asset. Va su .hero .video (0,2,0) e DENTRO questo blocco: la fascia
     fluida 900-1199 viene dopo e le media query non danno specificita'. */
  .hero .video{max-width:438px}
  .video__glass{width:39px;height:27.5px;border-radius:5px;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
  .video__glass svg{width:14px;height:15px}
  .vsl__ico{width:76px;height:76px}
  .vsl__ico svg{width:34px;height:34px}
  .vsl__t1{font-size:14.5px;line-height:17px}
  .hero .cta{margin-top:25px;min-width:264px}

  /* --- 2. Barra loghi ---------------------------------------------------- */
  /* Su desktop una riga sola: i tre marchi distribuiti e centrati sul loro
     inchiostro. Le larghezze sono in percentuale della riga, cosi' le
     proporzioni fra i tre - decise dalla designer - restano quelle a ogni
     larghezza. La seconda serie serve solo allo scorrimento del mobile. */
  /* scorre anche a desktop: la pista torna flessibile e va ritagliata */
  .press__in{overflow:hidden}
  /* 74 s: con otto marchi una copia misura 1616 px. La durata segue la
     larghezza della copia, se no la barra cambia andatura. 21,8 px/s. */
  .press__track{display:flex;width:max-content;animation:press-scorre 74s linear infinite}
  /* I marchi si susseguono a passo costante, e il mezzo passo per lato (26)
     fa 52 anche fra una copia e l'altra, cosi' il ritmo non ha giunture.
     La fascia non tiene piu' i 212 px del Figma: li' il contenuto ne chiedeva
     134 e gli altri 78 erano aria vuota. Ora hugga i marchi. */
  .press__set{gap:52px;min-height:116px;padding:32px 26px}
  /* ATTENZIONE: cambiando questa larghezza si accorcia o si allunga una copia
     della pista, e le copie servono a coprire la finestra. Va ricontrollato
     COPIE in contenuti.py e la durata qui sopra. */
  .press__set img{width:150px}

  /* --- 3 / 5. Modulo testo + foto (foto a destra) ------------------------- */
  .mod{padding:0}
  .mod__in{max-width:var(--maxw);margin-inline:auto;padding:98px 96px 98px 120px;
    display:grid;grid-template-columns:536px 440px;gap:58px;align-items:start}
  .mod__txt{grid-column:1;max-width:536px}
  .mod__img{grid-column:2;grid-row:1;margin:13px 0 0;border-radius:40px;align-self:start}
  .mod h2{margin-top:25px}
  /* Larghezze dei box di testo prese dal Figma. Non sono uniformi (532 / 496 /
     505 a parita' di colonna): e' una disuniformita' del file, ma replicarla
     e' l'unico modo perche' gli a-capo cadano dove cadono nel progetto. */
  .mod .body{margin-top:25px;max-width:532px}
  .mod--split .body{max-width:496px}
  .mod--img-mid .body{max-width:505px}
  .mod .cta-wrap{margin-top:26px}

  /* --- 4. Split: foto a sinistra a tutta altezza -------------------------- */
  .mod--split{background:var(--rose);padding:0}
  .mod--split .mod__in{max-width:none;padding:0;grid-template-columns:536px 1fr;gap:0;align-items:stretch}
  .mod--split .mod__img{grid-column:1;grid-row:1;margin:0;border-radius:0}
  .mod--split .mod__img img{width:100%;height:100%;object-fit:cover}
  .mod--split .mod__txt{grid-column:2;grid-row:1;max-width:656px;padding:82px 0 79px 120px;align-self:center}
  .mod--split .h-sec{color:var(--wine)}
  .mod--split .eyebrow{color:var(--white)}

  /* --- 6. Griglia risultati ---------------------------------------------- */
  .results{padding:86px 0 86px}
  .results h2{font-size:64px;line-height:80px;padding-inline:0}
  .results__grid{flex-direction:row;gap:0;justify-content:space-between;
    margin-top:44px;padding-inline:46px;max-width:var(--maxw);margin-inline:auto}
  .card{flex:0 1 212.4px;aspect-ratio:192/346;border-radius:40px}
  /* il velo nero al 50% e' renderizzato anche su desktop: verificato sulla
     luminanza media dell'export (38-64 contro 96-142 senza velo) */
  /* centrate in verticale come nel Figma (centro etichetta = centro card,
     scarto 0,00 su tutte e cinque); a sinistra restano dov'erano */
  .card span{left:26px;top:50%;bottom:auto;transform:translateY(-50%);
    font-size:20px;line-height:25px}
  .results .cta-wrap{margin-top:50px;padding-inline:0}

  /* --- 7 / 17. Interstiziali --------------------------------------------- */
  .inter{padding:48px 120px 51px;text-align:center}
  .inter .eyebrow{margin-inline:auto}
  .inter .eyebrow svg{margin-inline:auto}
  .inter h2{margin-top:25px}
  /* 665 e non 810: a 810 la frase «Perche' a te serve una soluzione sicura e
     mirata che risolve il problema alla radice» sta su UNA riga, mentre nei due
     Figma va a capo su due, con «alla radice.» da sola. La riga lunga misura
     650,0 px d'inchiostro in tutti e due gli export, quindi la colonna deve
     starci sopra ma non arrivare a contenere anche «alla»: 665 e' in mezzo.
     ⚠ Regola condivisa, ma il rischio e' nullo: in tutto il funnel c'e' UN SOLO
     `.inter` con del `.body` dentro (la sezione «PERCHE' DOVREI fidarmi di
     voi?»), una per landing, e i due Figma la danno identica - stessa x
     (303,1 -> 953,2) e stessa larghezza. Gli altri quattro `.inter` hanno solo
     il titolo. */
  .inter .body{margin-top:25px;max-width:665px;margin-inline:auto}
  .inter--white{padding:50px 120px}
  .inter--white h2{margin-top:25px}
  .inter--big .h-sec{font-size:55px;line-height:55px;max-width:473px;margin-inline:auto}

  /* --- 8 / 9. Card dottoressa -------------------------------------------- */
  .doc{padding:0 0 50px}
  .doc__wrap{max-width:var(--maxw);margin-inline:auto;padding:0 72px}
  .doc__tab{margin-left:0;padding:13px 33px;border-radius:15px 15px 0 0}
  /* La pillola e' centrata, il testo dentro NO: nel Figma i due nodi sono
     entrambi textAlignHorizontal=LEFT, a x=453,5 tutti e due.
     padding-block 11 porta l'altezza a 72px: misurata sull'export del Figma
     la linguetta va da cssY 4995,5 al tetto della card a 5064,5 (69-72),
     non i 75,3 che si ottengono per deduzione. */
  .doc__tab--center{margin-inline:auto;text-align:left;padding-block:11px}
  /* A desktop il nome resta ExtraLight. Due ragioni misurate: il nodo cel-d
     e' uniformemente 200, e l'intaglio del Figma e' largo 330,8 su tutte e
     quattro le linguette desktop — a peso 500 la linguetta 1 passa da 337,9
     a 347,8 e se ne allontana invece di avvicinarsi. Il peso spezzato resta
     dov'e' documentato senza eccezioni: a mobile. */
  /* Nel Figma desktop il nome e' Medium in tre linguette su quattro; l'unica
     uniformemente ExtraLight e' la prima di Celebrities. Base leggera, e le
     altre tre la scavalcano: la centrata qui sotto, la prima di Sensuality in
     sen-extra.css. A mobile restano tutte Medium, come il Figma. */
  .doc__tab > b{font-size:24px;line-height:30px;font-weight:200}
  .doc__tab--center > b{font-weight:500}
  /* a desktop "Dott.ssa" torna sulla riga del nome: nel Figma desktop il testo
     e' su una riga sola, l'a-capo esiste solo a mobile */
  .doc__tab > b span{display:inline}
  /* su desktop la qualifica sta DENTRO la linguetta; su mobile scende
     sotto la foto (.doc__role), quindi in base e' nascosta */
  .doc__tab i{display:block;font-size:12px;line-height:15px;max-width:259px}
  /* "Medico" nel Figma e' fontSize 32 / lineHeight 40 a scala 1/2 = 16/20,
     non 12/15 come la qualifica lunga di Alessia Migliore */
  .doc__tab--center i{font-size:16px;line-height:20px}
  .doc__card{margin:0;padding:37px 74px 42px 54px;border-radius:0 15px 15px 15px;
    display:grid;grid-template-columns:440px 1fr;gap:95px;align-items:start}
  /* Figma: il blocco di testo e' centrato verticalmente sulla foto (Celebrities
     38,5/38,5 nella card bordeaux e 61/61 in quella rosa; Sensuality 38,5/23,5
     e 61/61). Si centra SOLO la colonna di testo, non la card: sotto i ~1050 px
     il testo diventa piu' alto della foto e un align-items:center farebbe
     scendere la foto staccandola dalla linguetta. */
  .doc__card > div{align-self:center}
  .doc__tab--center + .doc__card{border-radius:15px}
  .doc__photo{border-radius:15px}
  .doc__role{display:none}
  .doc__h{margin:0 0 22px;font-size:32px;line-height:38px}
  .doc__h .it{font-size:24px;line-height:30px}
  /* La foto riempie l'altezza della card. Col testo nuovo, piu' lungo, la
     colonna supera l'altezza dei ritratti e sotto la foto restava un buco:
     284 px di rosa vuoto sulla seconda card di Celebrities, misurati. Con
     `stretch` + `cover` si chiude da solo a ogni larghezza.
     ⚠ Vale anche per la PRIMA card, dove chiude un vuoto che c'era gia'
     prima (130 px): e' un cambio visibile che il cliente non aveva chiesto,
     ed e' segnalato. */
  .doc__photo{align-self:stretch}
  .doc__photo img{height:100%;object-fit:cover}
  .doc__card--sola{border-radius:15px}
  .doc__body{margin-top:0;font-size:20px;line-height:26px}
  .doc__body + .doc__body{margin-top:1.1em}
  .doc__list{margin-top:34px;gap:26px}
  .doc__list li{font-size:20px;line-height:26px}
  .doc__list picture{flex-basis:32px}
  .doc__list img{width:32px;height:29px}
  .doc .cta-wrap{margin-top:50px;padding-inline:0}

  /* --- 11..16. Blocchi numerati ------------------------------------------ */
  .blk{padding:0}
  .blk__in{max-width:var(--maxw);margin-inline:auto;padding:94px 120px}
  .blk .h-sec,.faq__head h2{font-size:48px;line-height:48px}
  /* Titolo a parola sola: da 1200 in su la colonna di testo misura
     100vw - 776 (misurato: 424 a 1200, 474 a 1250) e si ferma li', perche'
     .blk__grid e' limitata a --maxw. Il tetto di 46,5 px tiene 3,7 px di
     margine sulla colonna da 474. Sotto i 1200 comanda la fascia fluida. */
  .blk .h-sec--endo{font-size:min(46.5px,calc((100vw - 780px) / 10.2))}
  .blk h2{margin-top:25px}
  .blk .body{margin-top:28px;max-width:494px}
  /* Nei due blocchi a foto piena (NUTRIZIONE e CHEF) la colonna di testo del
     Figma e' piu' stretta dei 494 generali, e il 494 non morde perche' la
     cella della griglia ne lascia gia' solo 474: il testo va a capo un po'
     piu' in la' del disegno. Misurate le quattro colonne nei due export, la
     riga piu' larga e' 459,8 px (CHEF, identica sulle due landing) e la piu'
     stretta 439,7.
     Il valore NON e' dedotto da quelle misure ma trovato provando, perche' il
     nostro testo rende circa l'1% piu' stretto del Figma a parita' di corpo:
     provate le larghezze da 446 a 466, il blocco CHEF riproduce 9 righe su 9
     fra 450 e 462, cala a 8 su 9 a 446 e a 464, e crolla a 6 su 9 a 466.
     456 e' il centro di quel pianoro, cosi' non si sta su un bordo.
     ⚠ Si scrive su `.blk--split` e non su `.blk--imgL`/`.blk--imgR` perche' le
     due landing SPECCHIANO le foto: `imgL` e' CHEF su Sensuality ma NUTRIZIONE
     su Celebrities. Una regola sul lato avrebbe colpito blocchi diversi. */
  .blk--split .body{max-width:456px}
  .blk .cta-wrap{margin-top:44px;align-items:flex-start;padding-inline:0}
  /* l'immagine incorniciata e' solo di mobile: a desktop la foto la fa
     .blk__side. (`.blk__bleed` non esiste piu' dal 15 settembre) */
  .blk__img{display:none}

  /* split con immagine a filo pagina */
  .blk--split{display:grid;align-items:stretch}
  .blk--split .blk__side{display:block;grid-row:1}
  .blk--split .blk__side img{width:100%;height:100%;object-fit:cover;border-radius:0}
  .blk--imgL{grid-template-columns:536px 1fr}
  .blk--imgL .blk__side{grid-column:1}
  .blk--imgL .blk__in{grid-column:2;max-width:none;padding:94px 120px 94px 120px;align-self:center}
  .blk--imgR{grid-template-columns:minmax(0,1fr) 536px}
  .blk--imgR .blk__side{grid-column:2}
  /* la colonna testo si allinea al container centrato da 1250, mentre
     l'immagine resta a filo del bordo destro della pagina */
  .blk--imgR .blk__in{grid-column:1;width:100%;max-width:714px;
    margin-left:max(0px,calc((100vw - var(--maxw)) / 2));padding:131px 120px;align-self:center}

  /* colonna testo + foto arrotondata (blocchi 03 e 05) */
  .blk--photo{background:var(--cream)}
  .blk--photo .blk__grid{max-width:var(--maxw);margin-inline:auto;
    display:grid;grid-template-columns:536px 1fr;align-items:center;gap:0}
  .blk--photo .blk__side{display:block;padding:98px 0 98px 96px}
  .blk--photo .blk__side img{border-radius:40px;width:440px;height:auto}
  .blk--photo .blk__in{padding:94px 120px 94px 120px}

  /* fondo fotografico con velo bruno (blocchi 02 e 06) */
  .blk--veil{position:relative;background:var(--taupe)}
  .blk--veil .blk__side{display:block;position:absolute;inset:0;z-index:0}
  .blk--veil .blk__side img{width:100%;height:100%;object-fit:cover}
  .blk--veil::after{content:"";position:absolute;inset:0;z-index:1;background:var(--veil)}
  .blk--veil .blk__in{position:relative;z-index:2;padding:97px 120px}
  /* il testo non deve superare x287, oltre il velo si dissolve (SPECIFICA §16) */
  .blk--veil .body{max-width:494px}
  .blk--veil h2,.blk--veil .num{max-width:473px}

  /* --- rientro superiore: e' del BLOCCO, non del lato della foto ---------
     Nel Figma ogni fascia numerata e' alta 1450 artboard = 725 css e il
     gruppo di testo ci sta dentro centrato: il rientro e' (725 - altezza
     del gruppo)/2, cioe' una proprieta' del singolo blocco. Finche' stava
     su .blk--imgL (94) e .blk--imgR (131) lo stesso blocco prendeva numeri
     diversi sulle due landing, perche' il Figma SPECCHIA le foto: il
     blocco 01 e' 218:756 in 218:757 su Celebrities e 222:2121 in 222:2529
     su Sensuality, gruppo alto 536 e rientro 94,5 tutte e due le volte.
     I valori e il gruppo Figma da cui vengono:
       68,5 = (725-588)/2    CEL 218:767  /  SEN 222:2159
       79   = (725-567)/2    CEL 218:764  /  SEN 222:2149
       94  ~= (725-536)/2    CEL 218:756 e 218:760  /  SEN 222:2121
       97  ~= (725-532)/2    CEL 218:758
      131                    CEL 218:762  /  SEN 222:2063 (li' il Figma NON
                             centra: 131 sopra e 152,5 sotto, cioe' il
                             numero e' stato copiato da Celebrities)
     Solo padding-top/bottom: il padding-inline resta alle regole qui sopra
     e la fascia fluida 900-1199 continua a riscriverlo per conto suo. */
  .blk--r68 .blk__in{padding-top:68.5px;padding-bottom:68.5px}
  .blk--r79 .blk__in{padding-top:79px;padding-bottom:79px}
  .blk--r94 .blk__in{padding-top:94px;padding-bottom:94px}
  .blk--r97 .blk__in{padding-top:97px;padding-bottom:97px}
  .blk--r131 .blk__in{padding-top:131px;padding-bottom:131px}
  /* Senza ancoraggio il numero dichiarato non si vede: dove la fascia la fa
     la foto (536x725 in .blk--split, 98+528+98 in .blk--photo) e la colonna
     di testo e' piu' bassa, a posizionarla e' il centraggio e il padding
     resta inerte - il CHEF di Sensuality restava a 154,5 con qualunque
     numero. */
  .blk--split .blk__in,.blk--photo .blk__in{align-self:start}
  /* Unica deroga, dichiarata: il SUPPORTO di Sensuality (222:2135) vuole
     156,5, ma li' la foto tonda non si allunga e a 900 quel numero gonfia
     la fascia di 125 px di crema vuota. Il blocco resta centrato: con la
     nostra copia rende 154,0, cioe' 2,5 px dal Figma. */
  .blk--rmid .blk__in{align-self:center}

  /* --- 18. Testimonianze ------------------------------------------------- */
  .testi{padding:80px 0 81px}
  .testi h2{font-size:64px;line-height:64px;padding-inline:0;max-width:805px;margin-inline:auto}
  /* sei riquadri su due colonne: stessa griglia, stessa larghezza e
     stesso passo delle prima/dopo qui sotto, cosi' la fascia si legge
     come un blocco solo invece che come due sezioni diverse */
  .testi__list{display:grid;grid-template-columns:repeat(2,1fr);gap:50px;
    margin-top:44px;padding-inline:0;max-width:816px;margin-inline:auto}
  .testi__list .video{max-width:none;width:100%;margin:0;border-radius:40px}
  .testi__tit{margin-top:18px;font-size:20px;line-height:26px}
  /* la galleria continua la riga dei due video: stessa larghezza (383x2 piu'
     50 di gap) e stesso passo, cosi' i dieci riquadri si leggono come un
     blocco solo invece che come due sezioni diverse */
  /* due per volta: 383 + 50 + 383 = 816, cioe' esattamente la griglia dei
     video qui sopra. Le due fasce restano incolonnate. */
  .galw{max-width:816px;margin:50px auto 0}
  .gal__track{gap:50px;animation-duration:355s}
  .pd{flex:0 0 383px;border-radius:40px}
  .testi .cta-wrap{margin-top:50px;padding-inline:0}

  /* --- 19. FAQ ----------------------------------------------------------- */
  .faq{padding:0;position:relative}
  /* minmax(0,1fr): senza, la pillola piu' larga (828px, che sborda di proposito)
     farebbe crescere la prima colonna e schiaccerebbe quella della foto. */
  /* La griglia NON e' centrata dentro i 1250: come in .blk--imgR la foto resta
     a filo del bordo destro a qualunque larghezza. Nel Figma 789,5 + 460,5 =
     1250,0, ed e' proprio perche' tocca il bordo che ha raggio 0.
     Lo scarto sta sul padding della griglia e usa 100% — la larghezza di LAYOUT
     della sezione — non 100vw, che comprende la barra di scorrimento e a 1250
     sposterebbe la colonna di 7,5px. Sotto i 1250 vale 0: 375, 900, 1100, 1249
     e 1250 non cambiano di un pixel. */
  /* Senza la foto la sezione non e' piu' a due colonne: il blocco si centra
     sulla propria larghezza, che e' quella della pillola piu' lunga. Le
     pillole restano allineate a sinistra fra loro, come nel Figma. */
  .faq__grid{display:block;overflow:visible}
  .faq__col{max-width:var(--maxw);margin-inline:auto;padding:45px 120px 76px}
  /* tolta la foto, la sezione si centra: titolo al centro e pillole centrate
     una per una sull'asse della pagina. Restano di larghezze diverse, come
     nel Figma, ma il blocco non pende piu' a sinistra. */
  /* l'occhiello e' centrato solo su mobile: su desktop sta a sinistra */
  .faq__head h2{margin-top:25px;font-size:55px;line-height:55px;max-width:473px;margin-inline:auto}
  .faq .h-sec{font-size:55px;line-height:55px}
  /* Nel Figma le righe partono a x113,5, cioe' 6,5px fuori dal gutter da 120. */
  .faq__head h2{max-width:473px}
  /* la colonna delle domande e' quella della pagina: 1010 px, cioe' da 120 a
     1130, gli stessi margini di tutte le altre sezioni */
  .faq__list{margin-top:50px;padding-inline:0;margin-left:0;gap:25px;
    max-width:none;align-items:stretch}
  /* Ogni pillola sta su una riga sola e si allarga fino a contenere il testo:
     nel Figma la decima arriva a 828px e sborda oltre la colonna, sopra la
     foto (che pero' finisce 242px piu' in alto, quindi non collidono). */
  .faq__row{gap:1px;max-width:none}
  .faq__col{overflow:visible}
  .faq__q{min-height:68px;padding:0 32px;gap:8px;border-radius:34px 6px 6px 34px;
    font-size:22.5px;line-height:26px}
  .faq__t{flex-basis:68px;width:68px;min-height:68px;border-radius:6px 34px 34px 6px}
  .faq__q .msym{font-size:20px}
  .faq__t .msym{font-size:25px}
  .faq__a{margin-left:32px;padding:12px 32px 6px 0;font-size:17px;line-height:26px}

  .legal{padding:64px 120px 52px;font-size:15px;line-height:24px}
  .legal__claim{font-size:18px;line-height:28px;max-width:645px}
  .legal__cols{flex-direction:row;gap:96px;margin-top:40px}
  .legal__fonti ul{grid-template-columns:1fr 1fr;gap:8px 40px}
}

/* Footer su tutta la larghezza: tre bande che arrivano tutte a 1010.
   Da 1000 in su, non da 900: sotto, la colonna dei contatti si stringe
   sotto la larghezza dell'indirizzo email, che non si puo' spezzare. */
@media (min-width:1000px){
  .legal__in{display:grid;grid-template-columns:repeat(12,1fr);
    column-gap:10px;row-gap:38px;align-items:start}
  .legal__claim{grid-area:1/1/2/7;max-width:none;margin:0}
  .legal__cols{grid-area:1/7/2/13;margin:0;gap:10px}
  .legal__cols .legal__col{flex:1 1 0}
  .legal__fonti{grid-area:2/1/3/13;margin:0}
  /* ⚠️ LA RIGA IN FONDO E' STATA RICHIUSA IL 20 SETTEMBRE. Era a tre colonne
     — disclaimer 1-5, dicitura Facebook 5-9, copyright 9-13 — perche' li'
     c'era anche un disclaimer medico. Quello e' stato tolto (non era testo del
     cliente: l'avevo scritto io), e senza richiudere la griglia restava un
     BUCO di quattro colonne a sinistra, con la dicitura Facebook sospesa in
     mezzo al niente. Misurato sullo scatto: la riga partiva a 1/3 di pagina.
     Adesso i due blocchi rimasti si dividono la larghezza, 1-7 e 7-13.
     ⚠️ Quando arriveranno i DATI SOCIETARI (ragione sociale, sede, P.IVA —
     obbligatori per una pagina commerciale italiana e ancora mancanti) la riga
     torna a tre: e' questo il posto dove rimetterli. */
  .legal__meta{grid-area:3/1/4/7;max-width:none;margin:0}
  .legal__copy{grid-area:3/7/4/13;margin:0;align-self:start}
}

/* Larghezze intermedie: il desktop scala fluido invece di rompersi.
   Si ferma a 1249: da 1250 in su valgono i valori esatti del Figma. */
@media (min-width:900px) and (max-width:1199px){
  :root{--gut:6vw}
  .mod__in{padding-left:6vw;padding-right:5vw;grid-template-columns:minmax(0,536px) minmax(0,440px);gap:4vw}
  .mod--split .mod__txt{padding-left:6vw}
  /* Le colonne di testo vanno dichiarate minmax(0,...): senza, la larghezza
     minima di un elemento di griglia e' il suo contenuto, e la colonna sfonda
     la traccia invece di restringersi (a 900px sbordava di 26px). */
  .blk__in{padding-left:6vw;padding-right:6vw}
  .blk--imgL,.blk--imgR{grid-template-columns:42% minmax(0,58%)}
  .blk--imgR{grid-template-columns:minmax(0,58%) 42%}
  .blk--photo .blk__grid{grid-template-columns:44% minmax(0,56%)}
  /* Titolo a parola sola: qui la colonna e' il 44% della pagina (misurato:
     396 a 900, 440 a 1000, 484 a 1100), quindi il corpo massimo e' 4,35vw;
     4,3 lascia 4,6 px di margine a 900 e 5,6 a 1100. Il tetto di 48 e' il
     corpo dei titoli normali: si raggiunge a 1116 px, dove la colonna ne
     regge 48,8. */
  .blk .h-sec--endo{font-size:min(48px,4.3vw)}
  /* Qui i 120px di gutter del Figma sono un quarto della pagina: in questa
     fascia valgono i 6vw come per gli altri blocchi. Queste regole sono piu'
     specifiche di `.blk__in`, quindi vanno ripetute. */
  .blk--imgL .blk__in,.blk--imgR .blk__in,
  .blk--photo .blk__in,.blk--veil .blk__in{padding-inline:6vw}
  .blk--photo .blk__side{padding-left:5vw}
  .blk--photo .blk__side img{width:100%;max-width:440px}
  .doc__wrap{padding-inline:5vw}
  .doc__card{grid-template-columns:minmax(0,440px) 1fr;gap:5vw;padding-inline:4vw 5vw}
  /* le pillole non vanno a capo per scelta: senza minmax(0,...) la prima
     colonna cresce fino alla pillola piu' larga e spinge fuori la foto */
  .faq__col{padding-inline:6vw}
  .results__grid{padding-inline:4vw;gap:1.4vw}
  .card{flex:1 1 0}
  .inter,.inter--white{padding-inline:6vw}
}

/* ---- popup di opt-in: da tablet in su ------------------------------------
   Smette di essere un foglio dal basso e diventa una finestra centrata;
   nome e cognome tornano affiancati. */
@media (min-width:640px){
  /* ⚠ Qui resta SOLO cio' che e' davvero del tablet in su. Il centraggio,
     l'entrata in scala e gli angoli tutt'intorno stanno ora nella base
     (p1.html): ridichiararli qui sarebbe stato codice morto. */
  .oo-modal{--gut-mod:38px;padding:24px}
  .oo-modal__panel{max-width:556px;border-radius:22px;max-height:90vh;max-height:90dvh;
    box-shadow:0 24px 70px rgba(49,17,29,.42)}
  .oo-modal__panel::before{border-radius:22px 22px 0 0}
  .oo-modal__inner{padding:34px var(--gut-mod) 34px}
  .oo-modal__head{margin:-34px calc(var(--gut-mod) * -1) 30px;padding:32px var(--gut-mod) 30px;
    padding-right:calc(var(--gut-mod) + 30px)}
  .oo-modal__head--ok{padding-right:var(--gut-mod)}
  .oo-modal__close{top:22px;right:22px}
  .oo-modal__title{font-size:32px;line-height:38px}
  .oo-form__row{flex-direction:row;gap:16px}
  .oo-form__row .oo-field{flex:1 1 0}
}
/* ---- il popup si COMPATTA dove lo schermo e' basso ------------------------
   Matteo, 19 settembre. Misurato aprendolo davvero: il contenuto pesa 588 px a
   mobile e 595 a desktop, e SBORDAVA in due casi su otto — 84 px su iPhone SE
   con la barra degli indirizzi (375x553) e 37 px su un portatile 1280x720, che
   di utili ne lascia 625. Valeva per TUTTE E TRE le landing: e' lo stesso
   componente.
   ⚠️ IL PROBLEMA E' L'ALTEZZA, NON LA LARGHEZZA, quindi ci si aggancia a
   `max-height` e non a `max-width`: un telefono corto e un portatile basso
   hanno lo stesso guaio e si curano insieme. A 700 px di soglia si prendono
   553, 625 e 667 e si lasciano stare 730, 805 e 985, dove lo spazio c'e' e
   stringere sarebbe solo peggio.
   ⚠️ QUESTO BLOCCO VA TENUTO QUI, dentro l'intervallo che `build-vsl.py`
   estrae da p2.html per la landing VSL Delay: spostato dopo la riga
   `prefers-reduced-motion` qui sotto, quella landing non lo riceverebbe piu'.
   I tagli, -90 px dove ne servivano 84: testata 20/18 -> 12/10 (-16), titolo
   27/32 -> 21/25 (-14), sottotitolo 16/23 -> 14/19 (-8), stacco sotto la
   testata 18 -> 12 (-6), spazi fra i campi 12 -> 8 per cinque volte (-20),
   etichetta/campo 6 -> 4 per quattro (-6), altezza dei campi 48 -> 44 per tre
   (-12), bottone d'invio 56 -> 48 (-8).
   ⚠️ I campi si fermano a 44 e NON SCENDONO: e' il bersaglio tattile minimo
   consigliato, sotto il quale si sbaglia a premere. Il resto dei pixel si
   prende dagli spazi, non dalle cose che si toccano.
   ⚠️ La riga «I tuoi dati sono al sicuro e protetti» non si tocca: sono 18 px
   su un form che chiede un numero di telefono per una cosa di salute. */
@media (max-height:700px){
  .oo-modal__inner{padding:14px var(--gut-mod) 16px}
  .oo-modal__head{margin:-14px calc(var(--gut-mod) * -1) 12px;
    padding:12px var(--gut-mod) 10px;padding-right:calc(var(--gut-mod) + 34px)}
  .oo-modal__head--ok{padding-right:var(--gut-mod)}
  .oo-modal__title{font-size:21px;line-height:25px}
  .oo-modal__sub{margin-top:6px;font-size:14px;line-height:19px}
  .oo-form{gap:8px}
  .oo-field{gap:4px}
  .oo-field input{height:44px}
  .oo-form__submit{min-height:48px;padding:12px 22px}
  .oo-modal__close{top:12px;right:10px;width:34px;height:34px}
  .oo-success__badge{width:54px;height:54px;margin-bottom:14px}
}
@media (prefers-reduced-motion:reduce){.oo-modal__panel{transform:none}}

/* Oltre i 1250 il Figma non dice niente, e la fascia non deve stirarsi:
   si blocca e si centra come gia' fanno il footer e la barra stampa.
   Sotto i 1250 non cambia un pixel, perche' li' e' gia' larga 1250.
   NOTA: oltre i 1250 la foto si stacca dal bordo pagina e resta ad angoli
   vivi. Era stato proposto di darle il raggio da 40 - la regola che questo
   disegno segue per ogni immagine che NON tocca il bordo - ed e' stato
   scartato dal cliente: va lasciata cosi'. */
@media (min-width:1250px){
  .mod--split .mod__in{max-width:var(--maxw);margin-inline:auto}
}

/* ---- thank-you page ------------------------------------------------------
   Riusa il foglio delle landing e aggiunge solo i tre pezzi che qui servono:
   la fascia col marchio, il titolo e la card dell'avviso. Base = mobile. */
.typ{background:var(--cream)}
.typ__hero{position:relative;overflow:hidden;background:var(--wine-deep);
  padding:38px var(--gut) 42px;text-align:center}
.typ__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.typ__hero::after{content:"";position:absolute;inset:0;z-index:1;
  background:linear-gradient(180deg,rgba(49,17,29,.62),rgba(49,17,29,.86))}
.typ__hero > *{position:relative;z-index:2}
/* il <picture> deve restare non posizionato: e' una scatola inline di altezza
   zero, e l'immagine assoluta dentro vi collasserebbe invece di riempire la
   fascia. Il riferimento e' la sezione. */
.typ__hero > picture{position:static}
.typ__mark{max-width:270px;margin:0 auto 30px;line-height:0}
.typ__mark svg{width:100%;height:auto;color:var(--rose)}
.typ__mark .txt{display:none}
/* spunta d'avvenuta iscrizione, come nella schermata di conferma del popup */
.typ__badge{width:74px;height:74px;margin:0 auto 22px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;background:var(--rose);
  animation:oo-pop .5s cubic-bezier(.2,1.4,.4,1) both}
.typ__badge svg{width:40px;height:40px;fill:var(--wine)}
.typ__h1{margin:0;font-family:'Geologica',sans-serif;font-weight:900;
  font-size:38px;line-height:44px;letter-spacing:-.01em;color:var(--rose-hero);
  text-transform:uppercase}
.typ__lead{margin:16px auto 0;max-width:26em;
  font-family:'Geologica',sans-serif;font-weight:900;
  font-size:20px;line-height:27px;color:var(--white)}
.typ__lead em{font-style:normal;color:var(--rose-cta)}
.typ__sub{margin:12px auto 0;max-width:30em;font-size:17px;line-height:25px;
  color:rgba(246,237,228,.8)}

.typ__body{padding:38px var(--gut) 48px}
.typ__card{max-width:var(--maxw);margin-inline:auto;background:var(--white);
  border:1.5px solid var(--rose);border-radius:var(--r-card);
  padding:28px 22px;box-shadow:0 10px 34px rgba(75,28,34,.07)}
.typ__tag{display:inline-flex;align-items:center;gap:8px;margin-bottom:14px;
  padding:7px 15px;border-radius:var(--r-pill);background:var(--wine);color:var(--rose-faq);
  font-family:'Geologica',sans-serif;font-weight:900;font-size:12.5px;
  line-height:16px;letter-spacing:.06em;text-transform:uppercase}
.typ__tag svg{width:15px;height:15px;fill:currentColor}
.typ__num{display:block;margin:4px 0 14px;font-family:'Geologica',sans-serif;
  font-weight:900;font-size:31px;line-height:38px;color:var(--wine);letter-spacing:.01em}
.typ__card p{margin:0;font-size:17px;line-height:25px}
.typ__card p + p{margin-top:10px}
.typ__card strong{font-weight:700}


/* ---- thank-you page: desktop -------------------------------------------- */
@media (min-width:900px){
  .typ__hero{padding:66px 46px 74px}
  .typ__mark{max-width:520px;margin-bottom:40px}
  .typ__badge{width:88px;height:88px;margin-bottom:28px}
  .typ__badge svg{width:48px;height:48px}
  /* Il titolo e' l'unica riga della hero senza tetto: il marchio si ferma a
     520, il lead a 26em e il sub a 30em. Oggi "Complimenti!" misura 488 px
     d'inchiostro e il tetto non tocca niente (+0,0 a tutte le larghezze), ma
     con un titolo lungo a 1920 la riga arriverebbe a 1490 px e sborderebbe di
     120 a sinistra della colonna del footer. 1010 e' quella colonna a 1250. */
  .typ__h1{font-size:64px;line-height:72px;max-width:1010px;margin-inline:auto}
  .typ__lead{font-size:26px;line-height:35px;margin-top:20px}
  .typ__sub{font-size:19.2px;line-height:28px}
  /* Il corpo si incolonna col FOOTER, non col gutter di mobile. `.legal` ha
     120 di padding e `.legal__in` si ferma a var(--maxw): con lo stesso 120 e
     lo stesso tetto, card e passi partono e finiscono dove parte e finisce il
     footer, a ogni larghezza. Prima erano due griglie nella stessa pagina: a
     1250 la card partiva da x=46 e il footer da x=120, 74 px di scarto (25 a
     1440; a 1920 coincidevano per caso, perche' li' sono tutt'e due ferme a
     1250 e centrate). Misurato +0,0 a 900, 1000, 1100, 1199, 1200, 1250, 1440
     e 1920.
     ⚠ Il 6vw della fascia fluida delle landing qui NON va copiato: il footer
     non lo usa - resta 120 anche fra 900 e 1199 - e copiandolo lo scarto
     resterebbe -66 a 900 e -48 a 1199, con un salto di 48 px a 1200.
     La hero invece resta a 46: e' a fondo pieno e centrata, non ha un bordo in
     comune con nessuno, e le landing fanno lo stesso. */
  .typ__body{padding:56px 120px 74px}
  .typ__card{padding:40px 44px;display:grid;grid-template-columns:auto 1fr;
    gap:0 40px;align-items:center}
  .typ__card .typ__tag{grid-column:1/-1;justify-self:start;margin-bottom:18px}
  .typ__num{margin:0;font-size:44px;line-height:52px;white-space:nowrap}
  .typ__card .typ__txt{margin:0}
}

/* ---- corazza: GemPages non deve disfare la pagina ------------------------
   Vale SOLO per la thank-you page, che e' l'unica incollata dentro una pagina
   GemPages: le due landing vivono in un iframe e il reset `.gps` non le
   raggiunge. Il foglio di GemPages usa selettori di TAG discendenti -
   `.gps p{color/font-size/font-weight/line-height/text-align:inherit}`,
   `.gps h1..h6{font-size:inherit;font-weight:inherit}`, `.gps p{margin:0}`,
   `.gps ul{margin:0}` - che valgono 0,1,1 e battono le nostre classi singole
   da 0,1,0. Piu' `.gps-... .[&_*]:gp-max-w-full *{max-width:100%}`, 0,2,0, su
   OGNI discendente. Non e' ordine: il nostro <style> e' gia' l'ultimo dei
   sette del documento (posizione 186364 contro 183198 della regola `*`).
   La classe raddoppiata vale 0,2,0: batte i selettori di tag per specificita'
   e la regola `*` per ordine. Niente `!important`.
   ⚠ Qui c'e' SOLO cio' che la misura ha visto perdere davvero (locale contro
   online, elemento per elemento, t/G1_diff.py e t/G2_tag.py). `.typ__card p`,
   `.legal__col h3`, `.legal__fonti ul`, `.legal a` NON ci sono: li' la
   specificita' e' pari e la nostra regola vince gia', perche' viene dopo.
   ⚠ Il font lo perdevano 54 elementi, ma per EREDITA': basta ridichiararlo
   sulle due radici. `text-align:start` che diventa `left` non e' un difetto,
   rende identico. */
.typ.typ,.legal.legal{font-family:'Niramit',system-ui,-apple-system,'Segoe UI',sans-serif}
/* `.gps img{height:auto}` schiacciava la foto di fondo della hero: alta 716
   invece di 509, cioe' un'altra inquadratura. */
/* ⚠ NON C'E' SOLO GEMPAGES. Il foglio del TEMA Shopify - base.css, che la
   pagina carica con un <link> prima di tutto il resto - porta selettori di TAG
   NUDI, fuori da ogni `.gps`: valgono 0,0,1, ma passano lo stesso, perche'
   quelle due proprieta' noi non le nominavamo affatto.
     p,h1..h6{overflow-wrap:break-word}  spezzava «COMPLIMENTI!» dentro la
       parola a 375 e a 320: «COMPLIMENTI» sopra e «!» da solo sotto, titolo da
       44 a 88 px e pagina piu' alta di 44. In locale quella riga sborda di 7 px
       dalla colonna e basta, dentro una hero centrata con overflow:hidden.
     summary{padding-block:var(--padding-sm)}  gonfiava la linguetta «Fonti»
       di 22,375 px a OGNI larghezza, spingendo giu' tutto il footer.
   `:is()` prende la specificita' del suo argomento piu' alto, cioe' 0,0,1: con
   `.typ.typ` davanti la riga vale 0,2,1 e passa avanti. */
.typ.typ :is(p,h1,h2,h3,h4,h5,h6),
.legal.legal :is(p,h1,h2,h3,h4,h5,h6){overflow-wrap:normal}
.legal__fonti.legal__fonti summary{padding-block:0}
.typ__bg.typ__bg{height:100%}
.typ__mark.typ__mark{max-width:270px}
.typ__h1.typ__h1{font-size:38px;line-height:44px;font-weight:900}
.typ__lead.typ__lead{margin:16px auto 0;max-width:26em;font-weight:900;
  /* `.gps p{font-family:inherit}` vale 0,1,1 e toglie GEOLOGICA al lead, che
     allora eredita il Niramit messo qui sopra sulle due radici. Il difetto non
     lo vede nessuna misura di geometria: il tetto e' in `em`, quindi dipende
     dal corpo e non dal carattere, e la scatola resta identica (676x35 a
     1250). E' l'unica riga della pagina che il disegno vuole in Geologica. */
  font-family:'Geologica',sans-serif;
  font-size:20px;line-height:27px;color:var(--white)}
.typ__sub.typ__sub{margin:12px auto 0;max-width:30em;font-size:17px;
  line-height:25px;color:rgba(246,237,228,.8)}
.typ__card.typ__card{max-width:var(--maxw)}
.legal__in.legal__in{max-width:var(--maxw)}
.legal__claim.legal__claim{font-size:16px;line-height:24px;max-width:640px}
/* ⚠️ `.legal__disclaimer` non esiste piu' nel markup: il disclaimer medico e'
   stato tolto il 20 settembre perche' non era testo del cliente, l'avevo
   scritto io. Se un giorno ne arriva uno loro, torna anche questa riga. */
.legal__copy.legal__copy{margin-top:22px;font-size:12.5px;line-height:19px;
  color:rgba(246,237,228,.62)}
.legal__meta.legal__meta{margin-top:14px;font-size:11.5px;line-height:17px;
  color:rgba(246,237,228,.42);max-width:425px}
@media (min-width:900px){
  .typ__mark.typ__mark{max-width:520px}
  /* ⚠ IL MARGINE VA RIDICHIARATO QUI. `.gps h1{margin:0}` di GemPages vale
     0,1,1 e si mangia il `margin-inline:auto` della riga base, che vale 0,1,0.
     Senza, online il titolo non e' centrato ma incollato a sinistra della
     colonna: 66 px fuori asse a 1250, 401 a 1920, e lo scarto e'
     (larghezza - 1102)/2, cioe' cresce senza limite. Non si vedeva prima del
     tetto di 1010, perche' il titolo riempiva la hero. */
  .typ__h1.typ__h1{font-size:64px;line-height:72px;max-width:1010px;
    margin-inline:auto}
  .typ__lead.typ__lead{font-size:26px;line-height:35px;margin-top:20px}
  .typ__sub.typ__sub{font-size:19.2px;line-height:28px}
  .legal__claim.legal__claim{font-size:18px;line-height:28px;max-width:645px}
}
/* dai 1000 in su il footer diventa una griglia a 12 colonne e i tre blocchi
   bassi perdono il tetto: la corazza deve seguirli, se no restano incolonnati
   sulla misura di mobile dentro una banda larga 1010 */
@media (min-width:1000px){
  .legal__claim.legal__claim,
  .legal__meta.legal__meta{max-width:none;margin:0}
  .legal__copy.legal__copy{margin:0}
}

/* ---- VESTE «VSL DELAY»: stessa veste della landing ----------------------- */
:root{
  --cream:#F5EDE5;      /* sabbia: il fondo della landing */
  --wine:#2B2124;       /* inchiostro: il testo della landing */
  --wine-deep:#2F2327;  /* lo scuro del riquadro video della landing */
  --rose:#F2DFDC;       /* cipria */
  --rose-cta:#D8A7A0;   /* accento CHIARO, per fondo scuro: vedi la nota sopra */
  --rose-faq:#F2DFDC;
  --rose-hero:#F2DFDC;
}
/* ⚠️ CLASSI RADDOPPIATE, e non e' un vezzo. Piu' sopra in questo foglio c'e'
   un blocco di regole scritte `.typ__lead.typ__lead` — specificita' 0,2,0 —
   che esistono per battere gli stili che il page builder di GoHighLevel
   inietta nella pagina (`.gps p{...}`, 0,1,1). Una veste scritta a classe
   singola vale 0,1,0 e PERDE contro quelle: misurato, «Il primo passo e'
   fatto.» restava in sans grassetto mentre il titolo diventava serif.
   Qui si usa lo stesso idioma, se no meta' della veste non si applica. */
/* i due caratteri della landing */
.typ.typ,.legal.legal{font-family:'Jost',system-ui,-apple-system,'Segoe UI',sans-serif}
.typ__h1.typ__h1,.typ__lead.typ__lead,.typ__num.typ__num{
  font-family:'Cormorant Garamond',Georgia,serif}
/* ⚠️ Cormorant Garamond NON HA IL 900: arriva a 700. Lasciando il 900 di
   Geologica il browser lo sintetizzerebbe, ingrassando i tratti a occhio e
   sporcando una serif che vive di sottigliezza. I pesi scendono a quelli che
   la landing usa davvero: 400 per il titolo, 500 per i due rilievi. */
.typ__h1.typ__h1{font-weight:400;text-transform:none;letter-spacing:-.01em}
.typ__lead.typ__lead{font-weight:500}
.typ__num.typ__num{font-weight:500}
/* La targhetta piccola resta in Jost maiuscolo spaziato, come l'occhiello e la
   riga di rinforzo della landing: li' il maiuscolo e' del sans, non della serif. */
.typ__tag.typ__tag{font-family:'Jost',system-ui,sans-serif;font-weight:400;
  letter-spacing:.16em}
/* i tre valori scritti a mano, riscritti sul nuovo scuro */
.typ__hero.typ__hero::after{
  background:linear-gradient(180deg,rgba(47,35,39,.55),rgba(47,35,39,.82))}
.typ__sub.typ__sub{color:rgba(242,223,220,.86)}
.typ__card.typ__card{box-shadow:0 10px 34px rgba(62,37,44,.10)}
</style>
<script>document.documentElement.className+=' js';
/* Le icone delle FAQ sono legature del font "Material Symbols Outlined": finche'
   non e' pronto, .msym resta invisibile (vedi il CSS). Qui lo riveliamo solo dopo
   che document.fonts ha davvero caricato quel font. Se non arriva, le icone
   restano assenti: sono decorative (aria-hidden) e il testo non ne dipende. */
(function(){var h=document.documentElement,F=document.fonts;
  function mostra(){h.className+=' mso';}
  if(!F||!F.load){mostra();return;}
  try{F.load('1em "Material Symbols Outlined"',
      'settings close accessibility front_hand alarm keyboard_arrow_down')
    .then(function(a){if(a&&a.length)mostra();},function(){});}catch(e){mostra();}
  /* seconda occasione: se il CSS di Google non era ancora stato interpretato
     quando load() e' partito, load() risolve con un array VUOTO e le icone non
     comparirebbero mai. A caricamento font concluso ricontrolliamo. */
  if(F.ready&&F.ready.then)F.ready.then(function(){
    try{if(F.check('1em "Material Symbols Outlined"','settings'))mostra();}catch(e){}});
})();</script>
