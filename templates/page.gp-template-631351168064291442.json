    "gp_section_631351168182190706": {
      "settings": {
        "checksum": "89efcac86ed065aadd0d39417dfaebaa0b945815512953ac65b17081fb19a4a1_1_1_1_0__1",
        "gg-QzQ4GxE2_text": "Tutto quello che hai provato per rimetterti in forma, come <i>\"mangiare meno e muoverti di più”</i>, <strong>manda ancora più in tilt i tuoi ormoni</strong>.<br><br>E rischi di farti stare ancora peggio.",
        "gg3Fyglo-8M_childItem_0": "<p><strong>L&#039;ansia </strong>e l’insicurezza diventano ancora più forti...</p>",
        "gg5I_AKemHC_text": "TORNI A SPECCHIARTI",
        "gg5WIStKBbL_label": "<p>accedi alla tua oasi ormonale</p>",
        "gg9ADXotpDR_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Specchio.png",
        "gg9JsHBgmGQ_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Image10.jpg",
        "ggA9fZbyfvU_html5Url": "https://youtu.be/uXXbDy_t79s",
        "ggA9fZbyfvU_vimeoUrl": "https://vimeo.com/1095883398",
        "ggA9fZbyfvU_youtubeUrl": "https://youtu.be/uXXbDy_t79s",
        "ggFK_a5rwDQ_text": "Risveglia <span style=\"color:#E4BB7A;\"><strong>pelle luminosa, rughe ridotte, aspetto visibilmente più giovane</strong></span>",
        "ggFvmJ-b0PP_text": "<i>100% soddisfatta o rimborsata</i>",
        "ggI50KizUAn_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/gempages_571219258252461280-6b38c96b-f33e-4b88-8d0f-7a127f50f025.png",
        "ggIk3XeNeyC_text": "Dimentica i tentativi inutili fatti. Con Oasi Ormonale <strong>il tuo corpo </strong><span style=\"color:#FCE19A;\"><strong>si sblocca e brucia </strong></span><strong>come quando avevi 20 anni</strong>.",
        "ggJ-lm4eXL5_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Image9.png",
        "ggJ-lm4eXL5_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Image9.png",
        "ggJ3pTQFIp-_text": "I&nbsp;<span style=\"background-color:#fce19a;\"> </span><span style=\"background-color:#fce19a;color:#1C1C1C;\">Risultati&nbsp;</span><span style=\"color:#1C1C1C;\"> </span>che ottieni:",
        "ggJ_hPed0te_label": "<p>accedi alla tua oasi ormonale</p>",
        "ggJ_vc6Z8J7_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/gempages_571219258252461280-4db0f5d3-306d-42eb-beaf-c2a317efca55.png",
        "ggNUhUqgVpH_text": "E sai qual è la cosa peggiore?",
        "ggNbsE00vFW_text": "Se continui così:",
        "ggOuNMdKMeg_text": "L'ossitocina (l'ormone dell'amore) si riattiva. <span style=\"color:#E4BB7A;\"><strong>Libido</strong></span><strong>, </strong><span style=\"color:#E4BB7A;\"><strong>attrazione </strong></span><strong>e </strong><span style=\"color:#E4BB7A;\"><strong>relazioni </strong></span><strong>migliorano naturalmente</strong>.",
        "ggPPyzFLxJV_text": "<span style=\"color:#F9F9F9;\"><strong>Mangiare poco&nbsp;</strong></span><span style=\"background-color:#FCE19A;color:#F9F9F9;\"><strong> </strong></span><span style=\"background-color:#FCE19A;color:#000000;\"><strong>ti fa ingrassare!&nbsp;</strong></span>",
        "ggQUCZUtJxy_label": "<p>accedi alla tua oasi ormonale</p>",
        "ggRBTdSD1AU_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Image4.jpg",
        "ggRVMY7FRiN_text": "BRUCI GRASSO OSTINATO",
        "ggT_N5j4bVi_text": "<span style=\"color:#FCE19A;\"><strong>In 10 giorni</strong></span><strong> </strong>ti guardi allo specchio e <strong>ti vedi </strong>già più<strong> sgonfia, asciutta </strong>ed <strong>energica</strong>.",
        "ggVYYeiPxCb_text": "<span style=\"color:#FFFFFF;\">Perché quando non mangi<strong> ciò che serve ai tuoi ormoni:</strong></span>",
        "ggVtmCcktnV_childItem_0": "<p>La <strong>voglia </strong>resta un ricordo...</p>",
        "ggWeh54Y4Oj_text": "Ritrovi la sicurezza in te stessa. <strong>La tua </strong><span style=\"color:#E4BB7A;\"><strong>sensualità </strong></span><strong>e </strong><span style=\"color:#E4BB7A;\"><strong>magnetismo </strong></span><strong>tornano a brillare</strong>.",
        "ggWipa1Cdny_childItem_0": "<p>I capelli deboli, spenti, inariditi...</p>",
        "ggXfLkNFPFv_text": "PIÙ ATTRAENTE",
        "ggXhtr1jai8_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/gempages_571219258252461280-3a759ad0-97e3-4657-90b5-5dd6fc02a696.jpg",
        "ggYSGtPnwqK_text": "OASI ORMONALE",
        "gg_56lDrd-2_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Snella.png",
        "gg_LTlM7wyG_text": "Attenzione",
        "ggbcyhE2mw__text": "PIÙ SENSUALE",
        "ggeJuJ6V7cm_text": "<span style=\"background-color:#FCE19A;color:#000000;\">Infatti, se fosse vero</span> che <i>“per dimagrire basta solo mangiare meno e muoversi di più”</i> tutte noi vivremmo felici, con la pancia piatta...",
        "ggfP8atxUe9_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Image1.png",
        "ggfV2P8pRyT_text": "<span style=\"color:#FFFFFF;\"><strong>Quel numero sulla bilancia non scende mai…&nbsp;</strong></span><span style=\"background-color:#FCE19A;color:#FFFFFF;\"><strong> </strong></span><span style=\"background-color:#FCE19A;color:#212121;\"><i><strong>Perché?</strong></i></span><span style=\"background-color:#FCE19A;color:#FFFFFF;\"><strong>&nbsp;</strong></span>",
        "ggj87AXzz-8_text": "PIÙ GIOVANE",
        "ggjr1lm2NPn_childItem_0": "<p><span style=\"color:#FFFFFF;\">Si alza l’ormone dello <strong>stress </strong>e dell&#039;<strong>accumulo di grasso.</strong></span></p>",
        "ggktJRWHE7f_text": "<span style=\"color:#FCE19A;\">Dì addio al grasso su pancia, fianchi e cosce <strong>una volta per tutte.</strong></span> (Preparati a indossare quel vestito.)",
        "ggnJp5hOF3x_childItem_0": "<p><strong>Perdi </strong>+5.000€ in prove che non ti danno risultati...</p>",
        "ggoWR6APiEs_childItem_0": "<p>La <strong>pelle </strong>diventa più rugosa, grigia, disidratata...</p>",
        "ggo_chbPChz_text": "Invece...",
        "ggp7oZYJx0F_text": "<span style=\"background-color:#FCE19A;\"><strong>È il momento di dire basta a un corpo che non senti più tuo.</strong></span>",
        "ggtWPihWnVA_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/gempages_571219258252461280-20dfb43d-e3dd-4d9c-9855-4146fb98f1f7.png",
        "ggtd6mAFvnU_text": "Perché scegliere il Protocollo",
        "gguX5t0zesg_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Image10.jpg",
        "ggvCsh4q8Mg_text": "RIACCENDI IL METABOLISMO",
        "ggvDf4wEKRK_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Image1.png",
        "ggxPAJXFttA_childItem_0": "<p><span style=\"color:#FFFFFF;\"><strong>Il metabolismo rallenta. Bruci meno calorie, sei sempre stanca e trattieni grasso</strong> su pancia, fianchi e gambe.</span></p>",
        "ggzh_hRB-Rq_childItem_0": "<p><span style=\"color:#FFFFFF;\">Ti gonfi, hai <strong>attacchi di fame</strong> e <strong>voglia di zuccheri</strong>, non ti senti <strong>mai sazia</strong> e sei sempre <strong>senza forse</strong>...</span></p>",
        "section_preload": "true"
      },
      "type": "gp-section-631351168182190706"
    },
    "gp_section_631351168182256242": {
      "settings": {
        "checksum": "ded4f75d9c49f4616ca631aed0e201018603546ba4166c9e377eb48cfc35387c_1_1_1_0__1",
        "g-7Ty_sbwy0_text": "Leggi bene: <strong><u>non sarai mai sola.</u></strong><br><br>Te lo prometto!<br><br>Avrai <strong><u>supporto costante da parte mia, il nostro team e il tuo branco</u></strong>.<br><br>Ti forniremo la motivazione e le risorse necessarie per superare ogni ostacolo e raggiungere i tuoi obiettivi senza deviazioni.",
        "g2iO6wKtkKg_text": "Capisco i tuoi dubbi e per questo voglio assicurarti che ogni programma è studiato su misura per rispondere alle specifiche esigenze di ciascun paziente.<br><br>Durante la consulenza iniziale, analizzerò le tue specifiche esigenze e la tua situazione nel dettaglio per creare un percorso su misura che ti garantirà il massimo beneficio.",
        "g8CyVqhZoDE_text": "<strong>Non dovrai rinunciare alle gioie della vita.</strong><br><br>Oasi Ormonale <strong>ti permette di goderti il cibo e le attività che ami, adattando il programma alle tue preferenze personali e mantenendo l’equilibrio tra piacere e salute.</strong><br><br>Infondo, come ho detto prima, “chi ha detto che mangiare bene è noioso?”<br><br>Ma nel caso di eventuali rinunce dovute alla tua situazione specifica, <u>sappi che si tradurranno in benefici quadrupli domani</u>!<br><br>Ogni piccolo sacrificio sarà ampiamente ricompensato dal miglioramento della tua salute e qualità della vita.",
        "gChvICMvCcH_text": "Gli ormoni <u>sono alla base del funzionamento del nostro corpo</u>.<br><br><strong>Segnali esterni come il cibo e altri stimoli possono influenzare questi ormoni</strong>, generando risposte che, se non adeguatamente modulate, possono portare a meccanismi errati.<br><br>Ecco perché lavorerò al tuo fianco per migliorare <u>i 3 pilastri</u> che fonderanno una nuova te: <strong>mente</strong>, <strong>ormoni</strong>, <strong>stile di vita</strong>.",
        "gG9QmIGOEL6_text": "Sapevi che Secondo l’Organizzazione Mondiale della Sanità <strong>un corretto stile di vita dell’individuo incide fino al 50% sul suo stato di salute?</strong><br><br>Mentre l’ambiente in cui egli vive e l’ereditarietà incidono solo per il 20% sulla sua salute.<br><br><u>La medicina</u>, invece, &nbsp;<u>contribuisce solo per il 10%</u> a rendere una persona sana.<br><br>Quindi si, capisco i tuoi dubbi e ti invito a riflettere…<br><br><strong>I costi dei farmaci e delle visite specialistiche possono essere enormi.</strong><br><br>Per non parlare della <strong>sofferenza mentale e fisica</strong> che deriva da un corpo e una mente non in salute..<br><br>Quindi, <u>non è meglio prevenire che curare?</u>",
        "gXkDSdHJAgN_text": "<strong><u>E mai accadrà!</u></strong><br><br>La mia missione è creare <u>un branco unito</u>, <u>empatico</u> e <u>di supporto ai suoi membri</u>.<br><br><strong>Un gruppo con un clima di totale comprensione e rispetto, senza giudizi.</strong><br><br>Sarai dei nostri?",
        "gdUpWmbh94D_text": "Purtroppo, attraverso le mie pazienti e i miei trascorsi, lo so bene…<br><br>Sappi però che <strong><u>ho già aiutato diverse pazienti che hanno avuto brutte esperienze con diete e nutrizionisti di dubbio valore</u></strong>.<br><br>Il protocollo è studiato per migliorare tutti gli aspetti della tua vita che attualmente non ti permettono di essere al 100% te stessa.<br><br><strong>Mireremo a un benessere completo e duraturo.</strong>",
        "gg2E22RnEYz_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial5_2.jpg",
        "gg50mtQY-ul_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial5_1.jpg",
        "gg6nYtKnr_b_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial4_1.jpg",
        "gg74rwZ7ZMR_text": "Te lo spiego subito.<br><br>Grazie al protocollo Oasi Ormonale, <strong>so perfettamente come guidarti per farti raggiungere gli obiettivi che, insieme, imposteremo all’inizio</strong>.<br><br>-&gt; Quindi <u>cosa dovrai fare tu</u>?<br><br>Semplice: <strong>lasciarti guidare e seguire il protocollo</strong>.<br><br>-&gt; Cosa succede <u>SE segui protocollo e non ottieni risultati</u>?<br><br>Analizzerò cosa è andato storto e se mi rendo conto che il protocollo non funziona per te (caso rarissimo) allora <strong>ti restituisco l’intero importo che hai pagato</strong>.<br><br>Come vedi, <strong>non hai nulla da perdere</strong>.<br><br>Leggi la garanzia nel dettaglio <a href=\"https://oasiormonale.com/garanzia/\" target=\"_blank\"><u>cliccando qui</u></a>.",
        "gg7_Hw1rcZJ_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial6_2.jpg",
        "gg7oTdE6_WW_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial6_3.jpg",
        "ggCvpciHzs5_text": "Se non trovi tempo per la tua salute oggi, <strong><u>rischi di doverne dedicare molto di più in futuro per curarti</u></strong>.<br><br>Investire tempo ora ti permetterà di migliorare la qualità della tua vita e goderti le giornate <u>senza essere costretto a letto dalle malattie</u>.",
        "ggGHGyxwsHc_text": "Domande Frequenti:",
        "ggIhWWRA5SO_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial4_3.jpg",
        "ggO9oxCbMZ6_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial6_1.jpg",
        "ggPLa80Pd12_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial5_3.jpg",
        "ggT1M5R9GmD_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/PrimaDopo2.jpg",
        "gg_WhIabU3z_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial4_2.jpg",
        "ggiV6CpWcj5_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/PrimaDopo3.jpg",
        "ggl2R3D-HrM_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/PrimaDopo1.jpg",
        "ggtJBkzqIjv_childItem_0": "<p>Come funziona la Garanzia?</p>",
        "ggtJBkzqIjv_childItem_1": "<p>Non ho tempo per un programma impegnativo...</p>",
        "ggtJBkzqIjv_childItem_2": "<p>E se non vedessi risultati?</p>",
        "ggtJBkzqIjv_childItem_3": "<p>Vale la pena?</p>",
        "ggtJBkzqIjv_childItem_4": "<p>Ho paura di dover rinunciare a troppo</p>",
        "ggtJBkzqIjv_childItem_5": "<p>Non sono sicura che questo programma sia adatto a me</p>",
        "ggtJBkzqIjv_childItem_6": "<p>Ho paura di fare un'altra scelta sbagliata...</p>",
        "ggtJBkzqIjv_childItem_7": "<p>Le diete precedenti mi hanno sempre fatto sentire stanca e debole... succederà lo stesso?</p>",
        "ggtJBkzqIjv_childItem_8": "<p>Non voglio sentirmi giudicata o sotto pressione</p>",
        "ggtJBkzqIjv_childItem_9": "<p>Sei sicura che agire sugli ormoni mi aiuterà una volta per tutte??</p>",
        "gguEt9t9PYm_text": "<strong>Il protocollo Oasi Ormonale garantisce un miglioramento visibile e misurabile</strong>, perché si basa su un approccio totalmente scientifico e non di parte come succede, in molti casi, con altre <i>“soluzioni“</i>.<br><br><u>Probabilità di successo assicurato al 99,9%</u>"
      },
