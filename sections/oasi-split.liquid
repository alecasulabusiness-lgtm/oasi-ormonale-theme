{%- liquid
  assign tone = section.settings.tone | default: 'light'
  assign side = section.settings.image_side | default: 'left'
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
  assign btn_style = 'dark'
  if tone == 'dark'
    assign btn_style = 'light'
  endif
-%}
<section class="oasi oasi-shell oasi-shell--{{ tone }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="oasi-box oasi-tone-{{ tone }}{% if tone == 'dark' %} oasi-dark{% endif %}">
    <div class="oasi-s" style="--oasi-pt: {{ section.settings.padding_top }}px; --oasi-pb: {{ section.settings.padding_bottom }}px">
      <div class="oasi-wrap">
        <div class="oasi-split oasi-split--{{ side }}{% unless has_image %} oasi-split--noimage{% endunless %}">
          <div class="oasi-split__inner">
            {%- if has_image -%}
              <div class="oasi-media oasi-split__media">
                {%- render 'oasi-image', image: section.settings.image, sizes: '(min-width: 900px) 600px, 92vw' -%}
                {%- if section.settings.image_badge != blank -%}
                  <p class="oasi-badge oasi-glass">{{ section.settings.image_badge }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="oasi-split__copy">
              {%- if section.settings.eyebrow != blank -%}
                <p class="oasi-label oasi-label--rule">{{ section.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if section.settings.kicker != blank -%}
                <p class="oasi-kicker oasi-muted">{{ section.settings.kicker }}</p>
              {%- endif -%}
              {%- if section.settings.heading != blank -%}
                <h2>
                  {{ section.settings.heading }}
                  {%- if section.settings.heading_fade != blank %} <span class="oasi-fade">{{ section.settings.heading_fade }}</span>{% endif -%}
                </h2>
              {%- endif -%}
              {%- if section.settings.lead != blank -%}
                <div class="oasi-split__lead oasi-lead oasi-rich">{{ section.settings.lead }}</div>
              {%- endif -%}
              {%- if section.settings.body != blank -%}
                <div class="oasi-split__body oasi-rich oasi-muted">{{ section.settings.body }}</div>
              {%- endif -%}
              {%- if section.settings.subheading != blank -%}
                <p class="oasi-split__sub">{{ section.settings.subheading }}</p>
              {%- endif -%}

              {%- if section.blocks.size > 0 -%}
                <ul class="oasi-list">
                  {%- for block in section.blocks -%}
                    <li class="oasi-list__item" {{ block.shopify_attributes }}>
                      {%- if section.settings.list_style == 'numbered' -%}
                        <span class="oasi-list__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                      {%- elsif section.settings.list_style == 'check' -%}
                        <svg class="oasi-list__check" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="10"/><path d="M6.5 11.5l3 3 6-6.5"/></svg>
                      {%- endif -%}
                      <div class="oasi-rich">
                        {%- if block.settings.title != blank -%}
                          <p class="oasi-list__title">{{ block.settings.title }}</p>
                        {%- endif -%}
                        {{ block.settings.text }}
                      </div>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if section.settings.outro != blank -%}
                <div class="oasi-split__outro{% if section.settings.outro_style == 'text' %} oasi-split__outro--text{% endif %} oasi-rich">{{ section.settings.outro }}</div>
              {%- endif -%}

              {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
                <div class="oasi-actions">
                  {%- render 'oasi-button', label: section.settings.button_label, url: section.settings.button_url, style: btn_style -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Oasi: testo con immagine",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Fondo",
      "options": [
        { "value": "light", "label": "Crema, senza riquadro" },
        { "value": "white", "label": "Bianco, riquadro arrotondato" },
        { "value": "soft", "label": "Sfumatura rosa cipria" },
        { "value": "rose", "label": "Rosa antico" },
        { "value": "dark", "label": "Borgogna" }
      ],
      "default": "light"
    },
    { "type": "image_picker", "id": "image", "label": "Immagine (facoltativa)" },
    {
      "type": "select",
      "id": "image_side",
      "label": "Lato dell'immagine",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "right", "label": "Destra" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "image_badge", "label": "Etichetta sull'immagine (facoltativa)" },
    { "type": "text", "id": "anchor", "label": "Ancoraggio (id)" },
    { "type": "header", "content": "Testi" },
    { "type": "text", "id": "eyebrow", "label": "Etichetta" },
    { "type": "text", "id": "kicker", "label": "Frase in corsivo sopra il titolo" },
    { "type": "text", "id": "heading", "label": "Titolo" },
    { "type": "text", "id": "heading_fade", "label": "Seconda parte del titolo (più chiara)" },
    { "type": "richtext", "id": "lead", "label": "Testo di apertura" },
    { "type": "richtext", "id": "body", "label": "Testo" },
    { "type": "text", "id": "subheading", "label": "Frase in evidenza" },
    {
      "type": "select",
      "id": "list_style",
      "label": "Stile dell'elenco",
      "options": [
        { "value": "none", "label": "Senza simbolo" },
        { "value": "numbered", "label": "Numerato" },
        { "value": "check", "label": "Con spunta" }
      ],
      "default": "none"
    },
    { "type": "richtext", "id": "outro", "label": "Testo dopo l'elenco" },
    {
      "type": "select",
      "id": "outro_style",
      "label": "Stile del testo dopo l'elenco",
      "options": [
        { "value": "display", "label": "Grande (per frasi brevi)" },
        { "value": "text", "label": "Testo normale" }
      ],
      "default": "display"
    },
    { "type": "text", "id": "button_label", "label": "Pulsante, testo" },
    { "type": "url", "id": "button_url", "label": "Pulsante, link" },
    { "type": "header", "content": "Spazi" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Spazio sopra", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Spazio sotto", "default": 96 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Voce dell'elenco",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo (facoltativo)" },
        { "type": "richtext", "id": "text", "label": "Testo" }
      ]
    }
  ],
  "presets": [{ "name": "Oasi: testo con immagine" }]
}
{% endschema %}
