        "gg5HshlzmqV_label": "<p>prenota la tua consulenza gratuita</p>",
        "gg6Z5ltXK-6_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/gempages_571219258252461280-3a759ad0-97e3-4657-90b5-5dd6fc02a696.jpg",
        "gg6Z5ltXK-6_background_desktop_videoHtml5": "https://media.w3.org/2010/05/sintel/trailer.mp4",
        "gg8j5TonJJZ_text": "<span style=\"color:#B18B24;\"><strong>BRAVA!</strong></span>",
        "gg92_v7mHxA_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/PrimaDopo2.jpg",
        "ggAEeVfSmqH_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial5_3.jpg",
        "ggBFPC1LY0V_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial6_3.jpg",
        "ggCyxT37NeP_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial3_1.jpg",
        "ggDe7-bEzWd_text": "<p><span style=\"background-color:transparent;color:#f3f3f3;\">Decidi di dedicarti<strong> pochi minuti, che valgono <u>una vita migliore</u>.</strong></span></p><p>&nbsp;</p><p><span style=\"background-color:transparent;color:#f3f3f3;\">Se ignori i segnali del tuo corpo e aspetti, </span><span style=\"background-color:transparent;color:#EF4545;\"><i>potrebbe essere troppo tardi</i></span><span style=\"background-color:transparent;color:#f3f3f3;\"> quando deciderai di fare qualcosa.&nbsp;</span></p>",
        "ggGAvDQdBmL_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial2_1.jpg",
        "ggHv5uY2B-m_text": "<span style=\"color:#FFFFFF;\">Dal <i>\"dietologo-poliziotto\"</i> alla <strong>libertà</strong>: la mia <strong>trasformazione</strong> con Oasi Ormonale</span>",
        "ggKn36kt3aD_text": "<span style=\"color:#FFFFFF;\"><i><strong>“Meno 6 kg e di nuovo taglia 42\"</strong></i> - Cristina svela perché Oasi non è una dieta qualunque!</span>",
        "ggND6sR281p_label": "<p>prenota la tua consulenza gratuita</p>",
        "ggPcRXNA4K1_text": "<span style=\"font-size:px;\"><strong>Hai appena fatto quello che tante donne non fanno mai</strong></span>",
        "ggSpz68Ij7b_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial5_1.jpg",
        "ggVJoJ7r3Ou_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/PrimaDopo3.jpg",
        "ggVUSi4j8zc_text": "<p><span style=\"background-color:transparent;color:#f3f3f3;\">E unisciti alle oltre 1000 italiane che sono già rinate più belle, forti e magnetiche che mai.&nbsp;</span></p>",
        "gg_G1spq9mo_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial3_2.jpg",
        "ggawiLwq2Ik_text": "<p><span style=\"background-color:transparent;color:#f3f3f3;\">Cristina è un esempio:&nbsp;</span></p><p>&nbsp;</p><p><span style=\"background-color:transparent;color:#f3f3f3;\"><i>“Mi hai presa che ero in un cassonetto e mi hai salvata.”</i></span><br>&nbsp;</p><p><span style=\"background-color:transparent;color:#f3f3f3;\">Cristina, –20,6 kg, ciclo tornato dopo 9 anni, farmaci azzerati</span></p>",
        "ggb-hWpriz3_html5Url": "https://cdn.shopify.com/videos/c/o/v/2cd3deb506b54b009063f7270ab5cf2e.mp4",
        "ggb-hWpriz3_vimeoUrl": "https://vimeo.com/1095883398",
        "ggb-hWpriz3_youtubeUrl": "https://youtu.be/WBmsVU_-_hA",
        "ggbZTQxiYGn_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/Testimonial4_2.jpg",
        "ggbkoTGzVg3_text": "<p><span style=\"background-color:transparent;color:#f3f3f3;\"><strong>Finché il corpo dice BASTA</strong> e davanti allo specchio si pensa&nbsp;<i>“che è successo? Non mi capisco più…”</i></span></p><p>&nbsp;</p><p><span style=\"background-color:transparent;color:#f3f3f3;\">Ora la domanda è: <strong>vuoi capire cosa sta succedendo nel tuo corpo?</strong></span></p>",
        "ggccbPN85bB_html5Url": "https://cdn.shopify.com/videos/c/o/v/2cd3deb506b54b009063f7270ab5cf2e.mp4",
        "ggccbPN85bB_vimeoUrl": "https://vimeo.com/1095883398",
        "ggccbPN85bB_youtubeUrl": "https://youtu.be/R0xIBtepwII",
        "gggb29VhI-y_html5Url": "https://youtu.be/uXXbDy_t79s",
        "gggb29VhI-y_vimeoUrl": "https://vimeo.com/1095883398",
        "gggb29VhI-y_youtubeUrl": "https://youtu.be/uXXbDy_t79s",
        "ggh1iWcFOlT_html5Url": "https://cdn.shopify.com/videos/c/o/v/2cd3deb506b54b009063f7270ab5cf2e.mp4",
