    "gp_section_618153712162308817": {
      "type": "gp-section-618153712162308817",
      "settings": {
        "checksum": "49ad55ce96d45628bb9a2f129ad368b7d590988576575064187faf52580cab5f_1_1_1_0__1",
        "ggP9DOPBV3F_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/gempages_571219258252461280-54ba34d5-4927-446b-b865-682f6406b48c.jpg",
        "ggvB7lfWRxy_text": "Oasi Ormonale, NON ti promette (false) trasformazioni immediate.",
        "gg5Jw9Ktryc_text": "Ti accompagna verso un benessere duraturo",
        "gg18MC6qzjI_text": "e te lo mettiamo per iscritto con la nostra garanzia 100% soddisfatta o rimborsata.",
        "ggnAup0ONH4_text": "Il tuo percorso verso l'equilibrio ormonale merita sicurezza e supporto.&nbsp;<br><br>Mentre altri ti lasciano da sola con diete generiche e speranze, noi mettiamo il nostro impegno per iscritto.<br><br>Se segui il protocollo e il tuo corpo non risponde come dovrebbe, noi ci prendiamo cura della situazione.&nbsp;<br><br>Non ti abbandoniamo mai.&nbsp;<br><br>Non ci sentirai mai dire \"dipende dalla tua forza di volontà.\"&nbsp;<br><br>Ti sosteniamo fino al risultato.&nbsp;<br><br>Perché quando si parla di salute, non c'è niente di meglio che supporto e comprensione, da Donne come te.&nbsp;<br><br>Perché, chi può capirti meglio di una Donna?",
        "ggUiBaH-fMc_label": "<p>SCOPRI OASI ORMONALE</p>"
      }
    },
