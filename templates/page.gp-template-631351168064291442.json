    "gp_section_631351168182125170": {
      "settings": {
        "checksum": "b596e067b649b658829ffda250247a5128192a5c19b0102a2f3a63d62690b93e_1_1_1_0__1",
        "gg-pABVZKZU_text": "Intervistati da:",
        "ggAG4nzdnXy_label": "<p>Clicca qui ed entra nella tua Oasi</p>",
        "ggFBf-RORKy_text": "<span style=\"color:#1C1C1C;\"><strong>La colpa non è tua</strong>, ma di uno <strong>Squilibrio Ormonale</strong> nascosto nel tuo corpo.</span>",
        "ggIFVlWnn9S_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/MarmoVerticale2.jpg",
        "ggJKbxLjGU7_text": "<i>100% soddisfatta o rimborsata</i>",
        "ggawUr-SCKj_text": "Guarda il video per capire come risolvere definitivamente, e non avere più bisogno di un'altra nutrizionista.",
        "ggqDwdtt_Pm_text": "<span style=\"color:#1C1C1C;\">Vuoi Dimagrire e tornare a vederti </span><span style=\"color:#B18B24;\"><strong>Bella</strong> </span><span style=\"color:#1C1C1C;\">e </span><span style=\"color:#B18B24;\"><strong>Attraente</strong></span><span style=\"color:#1C1C1C;\">?</span>",
        "section_preload": "true"
