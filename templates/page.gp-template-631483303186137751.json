    "gp_section_631483303371014807": {
      "type": "gp-section-631483303371014807",
      "settings": {
        "checksum": "edc15175234d17d81783f2bfbb4f143f445232767ef6f8cbc0271d80752cb9f4_1_1_0_0__1",
        "ggBLToS1Gxw_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/MarmoVerticale2.jpg",
        "gg_Ucf0nNrr_text": "Com’è che le Star Italiane sembrano <span style=\"background-color:#FCE19A;color:#000000;\">non invecchiare mai</span>?",
        "ggdD9tO8yXN_text": "Perché loro dopo i 40 anni stanno ancora bene con tutto, mentre <strong>tu ti senti già invisibile</strong>?",
        "ggg5odZwosv_text": "<i>“Ok, ma io ho la mia età, una gravidanza alle spalle e non ho i loro soldi.”</i>",
        "ggqDNFkBFwu_text": "Giusto e allora perché tante donne ricche non sono magre e in forma?<br><br><strong>Se bastassero i soldi il mondo sarebbe pieno di Donne come la Hunziker</strong>.",
        "ggWPfezfy_l_text": "Cristina la pensava come te, ma quando usato il nostro Protocollo invece, beh…&nbsp;<strong>guarda e ascolta il suo enorme cambiamento.</strong>",
        "ggerYovVsgo_youtubeUrl": "https://youtu.be/uXXbDy_t79s",
        "ggerYovVsgo_vimeoUrl": "https://vimeo.com/1095883398",
        "ggerYovVsgo_html5Url": "https://youtu.be/uXXbDy_t79s",
        "ggReF_oXUcM_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/PrimaDopo3.jpg",
        "ggV4ngqIFoC_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/PrimaDopo2.jpg",
        "gg2FO6DVaxV_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/PrimaDopo1.jpg",
        "ggdHefAzeUp_text": "<strong>Noemi 44 anni </strong><sub>aveva provato chetogenica, dissociata e altro, ma niente.</sub>",
        "ggJxw8UYhTh_text": "<strong>Vanessa Incontrada 47 anni</strong><br><sub>per anni ha evitato foto e specchi.</sub>",
        "ggCb7imcx4i_text": "<strong>Claudia Gerini 54 anni</strong><br><sub>non si riconosceva più con la perimenopausa.</sub>",
        "ggShJmcDGTh_text": "Oggi tutte e tre fanno girare la testa.<br><br><strong>Hanno una Bellezza Senza Tempo che sembra non appassire mai.</strong>",
        "gg9cPr32fCt_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/image_demo.jpg",
        "ggxWCaJ-XyL_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/image_demo.jpg",
        "gg52A7O49gk_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/image_demo.jpg",
        "ggYy442aUxT_text": "<strong>E tu pensi che sia </strong><span style=\"background-color:#FCE19A;color:#000000;\">troppo tardi per te</span>?",
        "ggK1FpxcsAr_text": "Certo…&nbsp;<br><br>Le Star Italiane hanno soldi, tempo e aiuto in casa.&nbsp;<br>Sarebbe stupido negarlo, MA…<br><br><u>I soldi non fanno dimagrire</u>, né mantengono in forma per magia.",
        "ggu2HZmM1Mk_text": "<strong>Anche loro hanno provato diete, metodi e allenamenti vari, ma proprio come te, son rimaste deluse e confuse quando i risultati non sono arrivati.&nbsp;</strong>",
        "gg_MA79aXYs_text": "Hanno speso cifre enormi, provato tutto, ma il problema restava, finché.. <strong>hanno fatto quello che facciamo anche noi in Oasi Ormonale</strong>",
