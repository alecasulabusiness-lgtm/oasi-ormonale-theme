    },
    "gp_section_619217915434238677": {
      "settings": {
        "checksum": "9ca73b52583b02781a4bcc808cb0adee0d061c800ad04ed3bc53b41379f0122a_1_1_1_0__1",
        "gg1GVxXGRBy_html5Url": "https://cdn.shopify.com/videos/c/o/v/2cd3deb506b54b009063f7270ab5cf2e.mp4",
        "gg1GVxXGRBy_vimeoUrl": "https://vimeo.com/1095883398",
        "gg1GVxXGRBy_youtubeUrl": "https://youtu.be/tv0aJ0pn9Qk",
        "gg6R-cI82BA_text": "<i>\"Da stanca e senza energie a <strong>rinata\"</strong> - Monica ce l'ha fatta!</i>",
        "gg7Bj3NFS1B_text": "<i>“<strong>Meno 6 kg e di nuovo taglia 42</strong>\"- Cristina svela perché <u>Oasi non è una dieta qualunque</u>!</i>",
        "ggLJxCeCsFp_text": "<span style=\"color:#E4BB7A;\">Ascolta</span> cosa dice chi ci ha già scelto:",
        "ggMnB-PJ66J_html5Url": "https://cdn.shopify.com/videos/c/o/v/2cd3deb506b54b009063f7270ab5cf2e.mp4",
        "ggMnB-PJ66J_vimeoUrl": "https://vimeo.com/1095883398",
        "ggMnB-PJ66J_youtubeUrl": "https://youtu.be/WBmsVU_-_hA",
        "ggNQUkFkOsZ_html5Url": "https://cdn.shopify.com/videos/c/o/v/2cd3deb506b54b009063f7270ab5cf2e.mp4",
        "ggNQUkFkOsZ_vimeoUrl": "https://vimeo.com/1095883398",
