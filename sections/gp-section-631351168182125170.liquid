  function getParam(name){ try { return new URLSearchParams(window.location.search).get(name) || ''; } catch(e){ return ''; } }
  function getCookie(name){ var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)'); return m ? decodeURIComponent(m.pop()) : ''; }
  function rememberParam(name, key){
    var v = getParam(name);
