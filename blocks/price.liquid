{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

<product-price
  class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product_resource.id }}"
  style="
    {% render 'typography-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --width: {{ block_settings.width }};
  "
  {{ block.shopify_attributes }}
>
  {%- comment -%}
    Nessun prezzo visibile. Mostriamo solo un placeholder non indicizzabile.
  {%- endcomment -%}
  <p class="price-hidden" data-nosnippet>Prezzo su richiesta</p>

  {%- comment -%}
    Stop a note tasse e rate (potrebbero rivelare cifre).
  {%- endcomment -%}
  {%- comment -%}
  {% if block_settings.show_tax_info %}
    <div class="tax-note">{% comment %}nascosto{% endcomment %}</div>
  {% endif %}
  {% if selected_variant != blank and block_settings.show_installments %}
    <div class="installments">{% comment %}nascosto{% endcomment %}</div>
  {% endif %}
  {%- endcomment -%}
</product-price>

{% # theme-check-disable %}
{% stylesheet %}
  .tax-note:empty { display: none; }
  form.payment-terms { padding-top: 0.5em; }
  .installments:not(:has(shopify-payment-terms)) { display: none; }

  /* Nasconde eventuali residui di UI prezzo sparsi dal tema */
  .price, .product__price, [itemprop="price"], .unit-price,
  .price__container, .price--large, .compare-at, .product-card__price, .price-item {
    display: none !important;
  }

  .price-hidden {
    font: inherit;
    opacity: 0.9;
  }
{% endstylesheet %}

{%- comment -%}
  Sanitizzazione hard dei prezzi fuori dal markup visibile:
  - Rimuove "offers" dai JSON-LD di tipo Product
  - Offusca campi prezzo nei JSON inline di Shopify (price, compare_at_price, ecc.)
{%- endcomment -%}
<script>
(function() {
  try {
    // 1) Pulisci JSON-LD per prodotti
    var ld = document.querySelectorAll('script[type="application/ld+json"]');
    ld.forEach(function(s){
      try {
        var data = JSON.parse(s.textContent || s.innerText || 'null');
        if (!data) return;

        var scrub = function(obj){
          if (!obj || typeof obj !== 'object') return;
          // Array → ricorsione
          if (Array.isArray(obj)) { obj.forEach(scrub); return; }
          // Se è un Product, togli "offers"
          if (obj['@type'] === 'Product' || (Array.isArray(obj['@type']) && obj['@type'].indexOf('Product')>-1)) {
            delete obj.offers;
            delete obj.aggregateOffer;
          }
          // Ricorsione su figli
          Object.keys(obj).forEach(function(k){ scrub(obj[k]); });
        };

        scrub(data);
        s.textContent = JSON.stringify(data);
      } catch(e) {}
    });

    // 2) Offusca i JSON inline del prodotto
    var productJson = document.querySelectorAll('script[type="application/json"][data-product], script[type="application/json"][data-product-json], script[type="application/json"][data-product-data]');
    productJson.forEach(function(s){
      try {
        var data = JSON.parse(s.textContent || s.innerText || 'null');
        if (!data) return;

        var stripPrices = function(o){
          if (!o || typeof o !== 'object') return;
          if (Array.isArray(o)) { o.forEach(stripPrices); return; }
          ['price','compare_at_price','price_min','price_max','unit_price','price_varies','priceV2','compareAtPriceV2'].forEach(function(k){
            if (k in o) { o['__'+k+'_hidden'] = o[k]; delete o[k]; }
          });
          Object.keys(o).forEach(function(k){ stripPrices(o[k]); });
        };

        stripPrices(data);
        s.textContent = JSON.stringify(data);
      } catch(e) {}
    });

    // 3) Nascondi eventuali termini di pagamento residui
    document.querySelectorAll('shopify-payment-terms, .payment-terms').forEach(function(el){
      el.style.display = 'none';
      el.setAttribute('data-nosnippet','');
    });
  } catch(e) {}
})();
</script>

