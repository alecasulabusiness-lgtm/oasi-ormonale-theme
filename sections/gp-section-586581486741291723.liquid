    background-color: #D5D5D5;
  }
  body.noscroll {
    overflow: hidden;
    position: fixed;
    width: 100%;
    height: 100%;
    left: 0;
  }
  .mobile-header {
    background-color: #D5D5D5;
    padding: 12px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1001;
  }
  .mobile-logo img {
    height: 50px;
    width: auto;
  }
  .mobile-hamburger {
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1002;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .hamburger-icon {
    font-size: 24px;
    color: #000;
    line-height: 1;
    display: inline-block;
    transform: scale(1.5);
    transform-origin: center;
    transition: transform 0.2s ease;
  }
  .mobile-hamburger:active .hamburger-icon {
    transform: scale(1.5);
  }
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #D5D5D5;
    padding: 90px 20px 24px 20px;
    z-index: 1000;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-menu-overlay.active {
    transform: translateX(0);
  }
  .mobile-menu-overlay ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mobile-menu-overlay ul li {
    background-color: #BCBCBC;
    border-radius: 12px;
    padding: 12px 0;
    line-height: 1.4;
  }
  .mobile-menu-overlay a {
    font-size: 16px;
    font-weight: 500;
    color: #000;
    text-decoration: none;
    display: block;
    padding: 10px 16px;
  }
</style>
<body>
  <div class="mobile-header">
    <a class="mobile-logo" href="https://shop.oasiormonale.com/pages/home-oasiormonale">
      <img src="https://cdn.shopify.com/s/files/1/0922/5004/6807/files/gempages_571219258252461280-b1f11af1-b497-4c4e-a265-7592a4162e16.png" alt="Logo Oasi Ormonale">
    </a>
    <button class="mobile-hamburger" id="hamburgerButton">
      <span class="hamburger-icon">☰</span>
    </button>
  </div>
  <div class="mobile-menu-overlay" id="mobileMenuOverlay">
    <ul>
      <li><a href="https://shop.oasiormonale.com/pages/chi-siamo">Chi Siamo</a></li>
      <li><a href="https://shop.oasiormonale.com/pages/i-nostri-brand">Brand</a></li>
      <li><a href="https://shop.oasiormonale.com/pages/lavora-con-noi">Lavora Con Noi</a></li>
      <li><a href="https://shop.oasiormonale.com/pages/oasi-ormonale">Affidati ad Oasi Ormonale</a></li>
    </ul>
  </div>
  <script>
    const menuOverlay = document.getElementById('mobileMenuOverlay');
    const hamburgerButton = document.getElementById('hamburgerButton');
    const hamburgerIcon = hamburgerButton.querySelector('.hamburger-icon');
    const body = document.body;
    
    function closeMenu() {
      menuOverlay.classList.remove('active');
      hamburgerButton.classList.remove('open');
      hamburgerIcon.textContent = '☰';
      body.classList.remove('noscroll');
      body.style.top = '';
    }
    
    function toggleMenu() {
      const isOpen = menuOverlay.classList.contains('active');
      
      if (!isOpen) {
        body.style.top = `-${window.pageYOffset}px`;
      }
      
      menuOverlay.classList.toggle('active');
      hamburgerButton.classList.toggle('open');
      hamburgerIcon.textContent = isOpen ? '☰' : '✕';
      body.classList.toggle('noscroll', !isOpen);
      
      if (isOpen) {
        body.style.top = '';
      }
    }
    menuOverlay.addEventListener('touchmove', (e) => {
      e.stopPropagation();
    }, { passive: true });
    
    hamburgerButton.addEventListener('click', toggleMenu);
    document.querySelectorAll('.mobile-menu-overlay a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
    document.addEventListener('click', (e) => {
      const isInside = menuOverlay.contains(e.target) || hamburgerButton.contains(e.target);
      if (!isInside && menuOverlay.classList.contains('active')) {
        closeMenu();
      }
    });
  </script>
</body>
