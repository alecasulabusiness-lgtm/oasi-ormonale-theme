    return ok;
  }
  ['first_name','last_name','email','phone'].forEach(function(n){
    form[n].addEventListener('input', function(){ if (form[n].closest('.oo-field').classList.contains('is-invalid')) validate(); });
  });

  // --- Invio ---
  form.addEventListener('submit', function(e){
    e.preventDefault();
    if (sending) return;
    msg.textContent = '';
    if (!validate()) { var bad = form.querySelector('.is-invalid input'); if (bad) bad.focus(); return; }

    var payload = {
      first_name: form.first_name.value.trim(),
      last_name:  form.last_name.value.trim(),
      email:      form.email.value.trim().toLowerCase(),
      phone:      normalizePhone(form.phone.value),
      phone_raw:  form.phone.value.trim(),
      fbclid:     rememberParam('fbclid', 'oo_fbclid'),
      fbp:        getCookie('_fbp'),
      fbc:        getCookie('_fbc'),
      gclid:      rememberParam('gclid', 'oo_gclid'),
      utm_source:   getParam('utm_source'),
      utm_medium:   getParam('utm_medium'),
      utm_campaign: getParam('utm_campaign'),
      utm_content:  getParam('utm_content'),
      utm_term:     getParam('utm_term'),
      page_url:     window.location.href,
      funnel:       CONFIG.FUNNEL,
      submitted_at: new Date().toISOString()
    };

    // honeypot: se compilato → finto successo, nessun invio
    if (form.website && form.website.value) { showSuccess(); return; }

    sending = true;
    var redirecting = false;
    submitBtn.disabled = true; submitBtn.classList.add('is-loading');
    var txt = submitBtn.querySelector('.oo-form__submit-text'), orig = txt.textContent;
    txt.textContent = 'Invio in corso';

    fetch(CONFIG.WEBHOOK_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
      .then(function(r){ if (!r.ok) throw new Error('HTTP ' + r.status); return r; })
      .then(function(){
        try { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: CONFIG.DATALAYER_EVENT, oo_funnel: CONFIG.FUNNEL, oo_form: 'popup' }); } catch(e){}
        if (CONFIG.FIRE_META_LEAD && typeof window.fbq === 'function') { try { window.fbq('track', 'Lead'); } catch(e){} }
        if (CONFIG.REDIRECT_URL) {
          redirecting = true;
          txt.textContent = 'Fatto! Un attimo';
          var dest = buildRedirectUrl();
          setTimeout(function(){ window.location.href = dest; }, CONFIG.REDIRECT_DELAY_MS || 0);
          return;
        }
        showSuccess();
        form.reset();
      })
      .catch(function(){
        msg.textContent = "Non siamo riusciti a inviare la richiesta. Controlla la connessione e riprova.";
      })
      .then(function(){
        if (redirecting) return; // resta disabilitato finché cambia pagina
        sending = false;
        submitBtn.disabled = false; submitBtn.classList.remove('is-loading');
        txt.textContent = orig;
      });
  });

  function showSuccess(){
    viewForm.hidden = true;
    viewOk.hidden = false;
    try { root.scrollTop = 0; } catch(e){}
  }

  var TRACK_KEYS = ['fbclid','gclid','utm_source','utm_medium','utm_campaign','utm_content','utm_term'];
  function buildRedirectUrl(){
    var url = CONFIG.REDIRECT_URL;
    if (!CONFIG.REDIRECT_KEEP_PARAMS) return url;
    try {
      var u = new URL(url, window.location.href), src = new URLSearchParams(window.location.search);
      TRACK_KEYS.forEach(function(k){
        var v = src.get(k) || '';
        if (!v && k === 'fbclid') v = rememberParam('fbclid', 'oo_fbclid');
        if (!v && k === 'gclid')  v = rememberParam('gclid', 'oo_gclid');
        if (v && !u.searchParams.get(k)) u.searchParams.set(k, v);
      });
      return u.toString();
    } catch(e) { return url; }
  }

  window.OOForm = { open: open, close: close, config: CONFIG };
})();
</script>
