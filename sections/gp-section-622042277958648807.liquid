<script>
(function() {
  // URL PUBBLICATO del funnel (NON /v2/preview/...)
  var baseUrl = 'https://landing.oasiormonale.com/review-page-page';
  function getCookie(name) {
    var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
    return m ? decodeURIComponent(m.pop()) : '';
  }
  function getParam(name) {
    return new URLSearchParams(window.location.search).get(name) || '';
  }
  function buildAndLoad() {
    // fbclid: dall'URL, oppure recuperato da localStorage
    var fbclid = getParam('fbclid');
    if (fbclid) {
      try { localStorage.setItem('oo_fbclid', fbclid); } catch (e) {}
    } else {
      try { fbclid = localStorage.getItem('oo_fbclid') || ''; } catch (e) {}
    }
    var fbp = getCookie('_fbp');
    var fbc = getCookie('_fbc');
    var params = new URLSearchParams(window.location.search);
    if (fbclid && !params.get('fbclid')) params.set('fbclid', fbclid);
    if (fbp) params.set('fbp', fbp);
    if (fbc) params.set('fbc', fbc);
    params.set('page_url', window.location.href);
    var finalUrl = baseUrl + '?' + params.toString();
    console.log('[GHL Embed] Iframe src:', finalUrl);
    document.getElementById('ghlFrame').setAttribute('src', finalUrl);
  }
  // Aspetta che il Meta Pixel scriva _fbp (max ~2s), poi carica comunque
  var waited = 0;
  var iv = setInterval(function() {
    waited += 150;
    if (getCookie('_fbp') || waited >= 2000) {
      clearInterval(iv);
      buildAndLoad();
    }
  }, 150);
})();
</script>
