{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}
<section class="oasi oasi-shell oasi-hero" {{ section.shopify_attributes }}>
  <div class="oasi-box oasi-dark">
    <img class="oasi-breath" src="{{ 'oasi-pictogram-white.svg' | asset_url }}" alt="" width="860" height="939" aria-hidden="true">
    <div class="oasi-hero__inner{% unless has_image %} oasi-hero__inner--single{% endunless %}">
      <div class="oasi-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="oasi-label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1>{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="oasi-hero__text oasi-rich">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.primary_label != blank and section.settings.primary_url != blank -%}
          <div class="oasi-actions">
            {%- render 'oasi-button', label: section.settings.primary_label, url: section.settings.primary_url, style: 'light' -%}
          </div>
        {%- endif -%}
      </div>
      {%- if has_image -%}
        <div class="oasi-media oasi-media--shade oasi-hero__media">
          {%- render 'oasi-image', image: section.settings.image, sizes: '(min-width: 900px) 500px, 90vw', loading: 'eager' -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Oasi: hero di pagina",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etichetta sopra il titolo" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Titolo della pagina" },
    { "type": "richtext", "id": "text", "label": "Testo" },
    { "type": "text", "id": "primary_label", "label": "Pulsante, testo" },
    { "type": "url", "id": "primary_url", "label": "Pulsante, link" },
    { "type": "image_picker", "id": "image", "label": "Immagine (facoltativa)" }
  ],
  "presets": [{ "name": "Oasi: hero di pagina" }]
}
{% endschema %}
