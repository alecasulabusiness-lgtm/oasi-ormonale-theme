        "ggpX4N_9NkK_text": "OASI ormonale",
        "ggMfso5R6pk_text": "IL protocollo per ritrovare <strong>equilibrio</strong>, <strong>vitalità </strong>e <strong>sicurezza </strong>del proprio corpo. Sviluppato da figure qualificate nel benessere femminile.",
        "ggAYgvE7ihq_text": "Dimentica le diete rigide e menù copia e incolla.<br><br>Un approccio personalizzato - <strong>creato da donne per donne</strong> - che mette al centro la tua unicità.",
        "gg6zk5EGGNp_label": "<p>SCOPRI OASI ORMONALE</p>"
      }
