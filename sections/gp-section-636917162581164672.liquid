      <div>
    <!-- =============================================================================
     OASI ORMONALE — landing "Sensuality"
     Blocco da incollare in un Custom Code della pagina Shopify.

     La pagina vera sta su GoHighLevel; qui c'e' solo il guscio che la aggancia.

     A COSA SERVE LO SCRIPT: il browser non passa a un iframe di un altro dominio
     ne' i parametri dell'URL ne' i cookie del Pixel. Senza questo blocco il lead
     arriverebbe in GoHighLevel senza utm, senza fbclid e senza _fbp/_fbc, e
     l'attribuzione delle campagne morirebbe in silenzio — senza errori a video.

     DOVE NON METTERE IL PIXEL: Meta Pixel e GTM vanno QUI (e sulla thank-you
     page), mai dentro l'iframe. Se stanno in tutti e due i posti scrivono due
     _fbp diversi e la deduplica degli eventi salta.

     LA CONVERSIONE SI MISURA SULLA THANK-YOU PAGE, non sull'invio del form: il
     dataLayer dell'iframe da qui non si vede.

     NOTA SULLO SCROLL: l'iframe e' alto quanto lo schermo e a scorrere e' il suo
     contenuto, quindi questa pagina non scrolla mai. I trigger GTM di scroll
     depth resteranno a zero: e' atteso, non e' un guasto.
     ========================================================================== -->
<style>
  html, body {
    margin: 0;
    padding: 0;
    overflow: hidden;        /* elimina la scrollbar verticale della pagina */
  }
  .ghl-iframe-wrap {
    position: fixed;          /* esce dal flusso: niente breakout 100vw */
    inset: 0;
    width: 100%;
    height: 100dvh;           /* dvh: gestisce la barra del browser su mobile */
    overflow: hidden;
  }
  .ghl-iframe-wrap iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>

<div class="ghl-iframe-wrap">
  <!-- `allow` va tenuto: i permessi non delegati qui non arrivano ai video
       YouTube dentro la landing, e l'autoplay al click non partirebbe. -->
  <iframe id="ghlFrame" allowfullscreen
          allow="autoplay; encrypted-media; fullscreen; picture-in-picture"></iframe>
</div>

<script>
(function() {
  // URL PUBBLICATO dello step del funnel (NON /v2/preview/...)
  var baseUrl = 'https://landing.oasiormonale.com/opt-in-page-9112';

  function getCookie(name) {
    var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
    return m ? decodeURIComponent(m.pop()) : '';
  }
  function getParam(name) {
    return new URLSearchParams(window.location.search).get(name) || '';
  }

  function buildAndLoad() {
    // fbclid e gclid: dall'URL, oppure recuperati da localStorage se l'utente
    // torna sulla pagina senza parametri (secondo giro, segnalibro, back)
    var fbclid = getParam('fbclid');
    if (fbclid) { try { localStorage.setItem('oo_fbclid', fbclid); } catch (e) {} }
    else { try { fbclid = localStorage.getItem('oo_fbclid') || ''; } catch (e) {} }

    var gclid = getParam('gclid');
    if (gclid) { try { localStorage.setItem('oo_gclid', gclid); } catch (e) {} }
    else { try { gclid = localStorage.getItem('oo_gclid') || ''; } catch (e) {} }

    var fbp = getCookie('_fbp');
    var fbc = getCookie('_fbc');

    // si ricopia l'intera query (utm_source, utm_medium, utm_campaign,
    // utm_content, utm_term e qualunque altra cosa arrivi dall'inserzione)
    var params = new URLSearchParams(window.location.search);
    if (fbclid && !params.get('fbclid')) params.set('fbclid', fbclid);
    if (gclid  && !params.get('gclid'))  params.set('gclid', gclid);
    if (fbp) params.set('fbp', fbp);
    if (fbc) params.set('fbc', fbc);

    // l'indirizzo che l'utente vede davvero: la landing lo usa per il campo
    // page_url del lead e per risolvere la destinazione della thank-you page
    params.set('page_url', window.location.href);

    document.getElementById('ghlFrame').setAttribute('src', baseUrl + '?' + params.toString());
  }

  // Si aspetta che il Meta Pixel scriva _fbp, ma non oltre 2 secondi: dopo si
  // carica lo stesso, meglio un lead senza _fbp che una pagina che non parte.
  var waited = 0;
  var iv = setInterval(function() {
    waited += 150;
    if (getCookie('_fbp') || waited >= 2000) {
      clearInterval(iv);
      buildAndLoad();
    }
  }, 150);
})();
</script>
