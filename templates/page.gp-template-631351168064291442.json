    "gp_section_631351168182059634": {
      "settings": {
        "checksum": "d8192dd14222707df38888e9c27433ea220a3274f01beb4f36fe9051c02a2ecc_1_1_1_0__1",
        "ggFkzVSyGVl_text": "<i>100% soddisfatta o rimborsata</i>",
        "ggVe-lf51YO_label": "<p>Ottieni una consulenza adesso</p>",
        "gg_tVue0uR0_text": "Il cambiamento verso una <span style=\"color:#E4BB7A;\">nuova TE </span>è possibile",
        "ggkhfDZCwSC_text": "<strong>Solo se sei <u>DAVVERO</u> pronta a impegnarti</strong> per <span style=\"color:#E4BB7A;\">rimodellare la tua silhouette</span> e tornare a sentirti<strong> </strong><span style=\"color:#E4BB7A;\">sicura di te</span> e <span style=\"color:#E4BB7A;\">piena d'energia</span>",
        "gglAXvK104W_text": "<u>Hai già provato la qualunque</u> e niente e nessuno considerava i tuoi ormoni.<br>È il momento di scegliere<span style=\"color:#E4BB7A;\"> <strong>l'unica vera soluzione</strong></span><strong> che agisce alla causa del problema</strong>."
      },
