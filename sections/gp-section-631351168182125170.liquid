    REDIRECT_URL: 'https://oasiormonale.com/pages/typ-protocollo-pa',
    // Porta sulla TYP i parametri di tracciamento (fbclid, gclid, utm_*) per non perdere l'attribuzione.
    REDIRECT_KEEP_PARAMS: true,
