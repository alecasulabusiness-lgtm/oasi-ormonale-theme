        "gg-pABVZKZU_text": "Intervistati da:",
        "ggAG4nzdnXy_label": "<p>Clicca qui ed entra nella tua Oasi</p>",
        "ggFBf-RORKy_text": "<strong>La colpa non è tua</strong>, ma di un <span style=\"color:#E4BB7A;\"><strong>nemico silenzioso</strong></span> nascosto nel corpo di noi donne...",
        "ggIFVlWnn9S_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/gempages_571219258252461280-3a759ad0-97e3-4657-90b5-5dd6fc02a696.jpg",
        "ggawUr-SCKj_text": "Guarda il video (fino alla fine) per capire come risolvere definitivamente, <i><strong>tornare in controllo del tuo corpo</strong></i> e non avere più bisogno di un'altra nutrizionista.<br>&nbsp;",
        "ggkT_SgbXz-_label": "<p>Ottieni una consulenza gratuita</p>",
        "ggqDwdtt_Pm_text": "Vuoi Dimagrire e tornare a vederti <span style=\"color:#E4BB7A;\"><strong>Bella</strong></span> e <span style=\"color:#E4BB7A;\"><strong>Attraente</strong></span>?",
        "section_preload": "true"
