        "checksum": "c9a93b1623dd862b2165c56042c17bf4ed89e0146a4c7d2e90c9e0be81e60ade_1_1_1_0__1",
        "ggnj68vZxPR_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0922/5004/6807/files/gempages_571219258252461280-e39bc9bf-a206-4d1b-8eb4-ab58c9c9c4e9.jpg",
        "ggMfso5R6pk_text": "<i>Oasi Ormonale sta cambiando il modo in cui le donne italiane si approcciano al benessere ormonale.</i><br><br><i><strong>L’impatto che vogliamo avere? Diventare il punto di riferimento per il benessere <u>in Italia e non solo</u>.</strong></i><br><br>Per farlo, le persone che vogliono mettersi in gioco e contribuire a questa missione, per noi vengono prima di tutto.&nbsp;",
        "gg6zk5EGGNp_label": "<p>Scopri le posizioni aperte</p>"
      }
