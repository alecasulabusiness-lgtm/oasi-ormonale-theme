    ifr.allowFullscreen = true;
    ifr.title = 'Oasi Ormonale';
    crop.appendChild(ifr);
    this.player = null;
    this.setState('fallback');
    if (!this.playedOnce) { this.playedOnce = true; dl({ event: 'oo_video_play', oo_video_id: this.videoId, oo_video_fallback: true }); }
  };

  Vsl.prototype.toggle = function(){
    if (this.state === 'playing') this.pause();
