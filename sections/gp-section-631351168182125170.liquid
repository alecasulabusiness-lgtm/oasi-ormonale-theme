  function Vsl(root){
    var self = this;
    this.root = root;
    this.videoId = root.getAttribute('data-video-id');
    this.autoplay = root.getAttribute('data-autoplay') !== '0';
    this.loop = root.getAttribute('data-loop') === '1';
    this.iframeFallback = root.getAttribute('data-iframe-fallback') !== '0';
    this.player = null;
    this.ready = false;
    this.started = false;      // teaser muto partito
    this.audio = false;        // audio attivato dall'utente
    this.playedOnce = false;
    this.wantsUnmute = false;
    this.state = 'muted';
