<section class="oasi oasi-shell oasi-team"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="oasi-box oasi-dark">
    <img class="oasi-breath oasi-team__mark" src="{{ 'oasi-pictogram-white.svg' | asset_url }}" alt="" width="640" height="699" aria-hidden="true" loading="lazy">
    <div class="oasi-s" style="--oasi-pt: {{ section.settings.padding_top }}px; --oasi-pb: {{ section.settings.padding_bottom }}px">
      <div class="oasi-wrap oasi-team__inner">
        <div class="oasi-team__copy">
          {%- if section.settings.label != blank -%}
            <p class="oasi-label">{{ section.settings.label }}</p>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
          {%- if section.settings.lead != blank -%}
            <div class="oasi-team__lead oasi-lead oasi-rich oasi-muted">{{ section.settings.lead }}</div>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="oasi-team__body oasi-rich oasi-muted">{{ section.settings.body }}</div>
          {%- endif -%}
          {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
            <div class="oasi-actions">
              {%- render 'oasi-button', label: section.settings.button_label, url: section.settings.button_url, style: 'light' -%}
            </div>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <ol class="oasi-team__list oasi-glass oasi-glass--soft">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="oasi-team__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Oasi: le specialiste",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancoraggio (id)" },
    { "type": "text", "id": "label", "label": "Etichetta", "default": "Le specialiste" },
    { "type": "text", "id": "heading", "label": "Titolo" },
    { "type": "richtext", "id": "lead", "label": "Testo di apertura" },
    { "type": "richtext", "id": "body", "label": "Testo" },
    { "type": "text", "id": "button_label", "label": "Pulsante, testo" },
    { "type": "url", "id": "button_url", "label": "Pulsante, link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Spazio sopra", "default": 104 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Spazio sotto", "default": 104 }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "Professione",
      "settings": [{ "type": "text", "id": "text", "label": "Testo" }]
    }
  ],
  "presets": [{ "name": "Oasi: le specialiste" }]
}
{% endschema %}
